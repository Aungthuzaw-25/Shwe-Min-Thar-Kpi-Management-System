<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Offline — Shwe Min Thar KPI</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    padding: 1rem;
    background: #e9eff5;
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
    color: #33475c;
  }
  main {
    margin: auto;
    width: 100%;
    max-width: 28rem;
    background: #fff;
    border: 1px solid #dbe4ec;
    border-radius: 1.25rem;
    box-shadow: 0 12px 32px rgba(46, 69, 98, 0.12);
    padding: 2.25rem 2rem;
    text-align: center;
  }
  .offline-icon {
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto 1.25rem;
    background: #e8eef4;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .offline-icon svg { width: 2.25rem; height: 2.25rem; }
  h1 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
    color: #16283a;
  }
  p { margin: 0 0 1rem; }
  .offline-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .offline-retry {
    display: inline-block;
    min-width: 12rem;
    padding: 0.7rem 1.5rem;
    background: #2e4562;
    border-radius: 0.65rem;
    color: #fff;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .offline-retry:hover { background: #243a54; }
  .offline-dashboard {
    color: #2e4562;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  a:focus-visible {
    outline: 2px solid #2e4562;
    outline-offset: 3px;
    border-radius: 0.25rem;
  }
  .offline-foot {
    margin: 1.75rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.8rem;
    color: #64748b;
  }
  @media (max-width: 480px) {
    main { padding: 1.5rem 1.25rem; }
    h1 { font-size: 1.35rem; }
    .offline-icon { width: 3.75rem; height: 3.75rem; }
    .offline-icon svg { width: 1.9rem; height: 1.9rem; }
  }
</style>
</head>
<body>
<main>
  <div class="offline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#2e4562" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12a10 10 0 0 1 14 0" /><path d="M8.5 15.5a5 5 0 0 1 7 0" /><circle cx="12" cy="19" r="1" fill="#2e4562" /><line x1="2" y1="2" x2="22" y2="22" /></svg></div>
  <h1>You are offline</h1>
  <p>Internet connection is not available right now. Pages and data you already viewed on this device are still available while you are offline — each one shows the time it was last updated.</p>
  <p>This page was not viewed before, so there is no saved copy of it yet. Reconnect and try again.</p>
  <div class="offline-actions">
    <a class="offline-retry" href="">Try again</a>
    <a class="offline-dashboard" href="/dashboard">Go to your dashboard</a>
  </div>
  <p class="offline-foot">Shwe Min Thar KPI</p>
</main>
<script>
  // Progressive enhancement only: the two links above work with JS
  // disabled. When the browser reports it is back online, retry the
  // page that failed (the address bar still shows its URL).
  window.addEventListener("online", function () { window.location.reload(); });
</script>
</body>
</html>
