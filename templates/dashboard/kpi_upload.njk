{% extends "layouts/base.njk" %}
{% set active_page = "kpi_upload" %}

{% block title %}Data Import Engine - KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/download-upload-style.css">
<style>
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in-up { animation: fadeInUp 0.5s ease-out forwards; }
    
    #dropzone { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    #dropzone.dragover { 
        background-color: #eff6ff; 
        border-color: #3b82f6; 
        transform: scale(1.02); 
        box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.15);
    }
    .step-badge {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
    }
</style>

<div class="workspace-page min-h-full flex flex-col custom-scrollbar overflow-y-auto">
    
    <!-- HEADER -->
    <header class="app-page-header w-full animate-fade-in-up">
        <div class="flex items-center gap-3 sm:gap-4">
            <div class="bg-white p-2.5 sm:p-3.5 rounded-2xl shadow-sm border border-slate-200 shrink-0">
                <svg class="w-6 h-6 sm:w-8 sm:h-8 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
            </div>
            <div>
                <h2 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">Manual Data Import Engine</h2>
                <p class="text-slate-500 mt-1 sm:mt-1.5 text-xs sm:text-sm font-medium">Merge HR manual records (Attendance, Targets) with automated system tasks.</p>
            </div>
        </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 w-full max-w-7xl mx-auto">
        
        <!-- LEFT: WORKFLOW INSTRUCTIONS -->
        <div class="lg:col-span-5 space-y-4 sm:space-y-6 animate-fade-in-up csp-delay-2">
            
            <div class="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200 shadow-sm relative overflow-hidden group hover:border-blue-300 transition-colors">
                <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50 rounded-bl-full -z-10 group-hover:scale-110 transition-transform duration-500"></div>
                <div class="flex items-center gap-3 sm:gap-4 mb-3 sm:mb-4">
                    <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full step-badge text-white flex items-center justify-center font-black text-xs sm:text-sm shadow-md">1</span>
                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Download Template</h3>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 mb-5 sm:mb-6 font-medium leading-relaxed">
                    Select an open evaluation period first. The downloaded workbook includes active employees and KPI columns from the formulas used in that period.
                </p>
                <button onclick="downloadTemplate()" class="w-full bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition-all flex items-center justify-center gap-2 group-hover:bg-blue-600 group-hover:text-white btn-glass-download">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download Excel Template
                </button>
            </div>

            <div class="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200 shadow-sm relative overflow-hidden">
                <div class="flex items-center gap-3 sm:gap-4 mb-3 sm:mb-4">
                    <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full step-badge text-white flex items-center justify-center font-black text-xs sm:text-sm shadow-md">2</span>
                    <h3 class="text-base sm:text-lg font-extrabold text-slate-900">Prepare Data</h3>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 mb-4 font-medium leading-relaxed">
                    Fill every KPI column that applies to the employee with a finite number. Keep the generated headers unchanged; they are derived from the selected period's active KPI formulas.
                </p>
                <div class="bg-slate-50 rounded-xl p-3 sm:p-4 border border-slate-100 space-y-2">
                    <div class="text-[10px] sm:text-xs font-bold text-slate-700">Employee identity columns are provided by the system.</div>
                    <div class="text-[10px] sm:text-xs font-bold text-slate-700">KPI metric columns are formula-specific for the selected period.</div>
                </div>
            </div>

        </div>

        <!-- RIGHT: UPLOAD FORM -->
        <div class="lg:col-span-7 animate-fade-in-up csp-delay-3">
            <div class="bg-white rounded-3xl shadow-lg shadow-slate-200/50 border border-slate-200 p-5 sm:p-8 md:p-10">
                <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
                    <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full step-badge text-white flex items-center justify-center font-black text-xs sm:text-sm shadow-md">3</span>
                    <h3 class="text-lg sm:text-xl font-extrabold text-slate-900">Upload & Calculate</h3>
                </div>

                <form id="uploadForm" class="space-y-6 sm:space-y-8">
                    
                    <!-- Evaluation Period -->
                    <div>
                        <label class="block text-[10px] sm:text-[11px] font-black text-slate-500 mb-2 uppercase tracking-widest" for="targetPeriod">Evaluation Period <span class="text-red-500">*</span></label>
                        <select id="targetPeriod" required class="w-full sm:w-1/2 px-3 sm:px-4 py-3 sm:py-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 text-xs sm:text-sm font-bold text-slate-800 shadow-inner transition-all" onchange="validateFormState()">
                            <option value="">Loading evaluation periods…</option>
                        </select>
                        <p id="periodHelp" class="text-[10px] sm:text-xs text-slate-500 font-medium mt-2">Import requires an open or in-progress period covering one complete calendar month.</p>
                    </div>

                    <!-- Drag & Drop Zone -->
                    <div>
                        <label for="fileInput" class="block text-[10px] sm:text-[11px] font-black text-slate-500 mb-2 uppercase tracking-widest">Data File (.XLSX / .CSV) <span class="text-red-500">*</span></label>
                        
                        <button id="dropzone" type="button" aria-label="Choose spreadsheet file" class="w-full border-2 border-dashed border-blue-200 rounded-3xl p-6 sm:p-12 text-center bg-blue-50/30 hover:bg-blue-50/80 transition-all cursor-pointer relative focus:outline-none focus:ring-4 focus:ring-blue-500/20">
                            <div class="bg-white w-12 h-12 sm:w-16 sm:h-16 rounded-full flex items-center justify-center mx-auto mb-3 sm:mb-4 shadow-sm border border-blue-100">
                                <svg class="w-6 h-6 sm:w-8 sm:h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                            </div>
                            <p class="text-sm sm:text-base font-extrabold text-blue-950">Drag your spreadsheet here or click to browse</p>
                            <p class="text-[10px] sm:text-xs font-semibold text-slate-500 mt-1 sm:mt-2">Maximum file size: 5MB</p>
                        </button>
                        <input type="file" id="fileInput" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="hidden">

                        <!-- Selected File Chip -->
                        <div id="filePreviewCard" class="hidden bg-white border border-emerald-200 rounded-2xl p-3 sm:p-4 shadow-sm flex justify-between items-center animate-fade-in-up ring-1 ring-emerald-50 mt-4">
                            <div class="flex items-center gap-3 sm:gap-4 overflow-hidden">
                                <div class="bg-emerald-100 text-emerald-700 p-2 sm:p-3 rounded-xl shrink-0">
                                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                </div>
                                <div class="min-w-0">
                                    <p id="fileNameDisplay" class="text-xs sm:text-sm font-black text-slate-900 truncate"></p>
                                    <p id="fileSizeDisplay" class="text-[9px] sm:text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-0.5 sm:mt-1"></p>
                                </div>
                            </div>
                            <button type="button" onclick="removeFile()" class="text-slate-400 hover:text-red-600 bg-slate-50 hover:bg-red-50 p-2 sm:p-2.5 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 shrink-0" title="Remove file">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Submit Action -->
                    <div class="pt-5 sm:pt-6 border-t border-slate-100 flex justify-end">
                        <button type="submit" id="uploadBtn" disabled class="w-full sm:w-auto bg-blue-700 hover:bg-blue-800 disabled:bg-slate-300 disabled:cursor-not-allowed text-white px-6 sm:px-8 py-3 sm:py-3.5 rounded-xl text-xs sm:text-sm font-black shadow-md transition-all active:scale-95 flex items-center justify-center">
                            Execute KPI Engine
                            <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        </button>
                    </div>
                </form>

                <!-- RESULT DISPLAY CONTAINER -->
                <div id="resultBox" class="w-full mt-6 hidden animate-fade-in-up transition-all"></div>
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');
    const filePreviewCard = document.getElementById('filePreviewCard');
    const form = document.getElementById('uploadForm');
    const uploadBtn = document.getElementById('uploadBtn');
    const periodSelect = document.getElementById('targetPeriod');
    let selectedFile = null;

    // 🌟 GLOBAL HTML ESCAPE FUNCTION
    function escapeHTML(str) {
        if (str === null || str === undefined) return "";
        return str.toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    async function getApiErrorMessage(response) {
        if (response.status === 403) {
            return "You do not have permission to use this KPI import feature.";
        }
        if (response.status === 422) {
            return "The selected evaluation period is invalid. Reload the page and select an available period.";
        }

        let payload = null;
        if ((response.headers.get('content-type') || '').includes('application/json')) {
            try {
                payload = await response.json();
            } catch (error) {
                return `Server error (${response.status})`;
            }
        }

        const detail = payload && payload.detail;
        if (detail && detail.code === 'validation_error' && Array.isArray(detail.errors)) {
            const messages = detail.errors
                .filter(message => typeof message === 'string')
                .map(message => message.replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, "an employee"));
            if (messages.length) return messages.join(' ');
        }
        if (detail && detail.code === 'processing_error' && typeof detail.message === 'string') {
            return detail.message;
        }
        // Same rule for the other error paths on this page: a plain
        // string detail, or an object carrying a message, is the exact
        // reason — show it instead of a fixed sentence or "Server error".
        if (typeof detail === 'string' && detail.trim()) {
            return detail;
        }
        if (detail && typeof detail.message === 'string' && detail.message.trim()) {
            return detail.message;
        }
        if (response.status === 400) {
            return "The selected evaluation period is unavailable or is not a complete calendar month.";
        }
        return `Server error (${response.status})`;
    }

    async function loadPeriods() {
        try {
            const response = await fetch('/api/v1/kpi-uploads/periods');
            if (response.status === 401) {
                window.location.href = '/auth/login';
                return;
            }
            if (response.status === 403) {
                periodSelect.innerHTML = '<option value="">You do not have permission to import KPI data</option>';
                showToast("You do not have permission to import KPI data.", "error");
                return;
            }
            if (!response.ok) {
                showToast(await getApiErrorMessage(response), "error");
                periodSelect.innerHTML = '<option value="">Evaluation periods could not be loaded</option>';
                return;
            }
            const periods = await response.json();
            if (!Array.isArray(periods)) {
                periodSelect.innerHTML = '<option value="">Evaluation periods could not be loaded</option>';
                showToast("The evaluation-period response was invalid. Please reload the page.", "error");
                return;
            }
            periodSelect.innerHTML = '<option value="">Select an evaluation period</option>' +
                periods.map(period => `<option value="${escapeHTML(period.id)}">${escapeHTML(period.label)} (${escapeHTML(period.month)})</option>`).join('');
            if (periods.length === 0) {
                periodSelect.innerHTML = '<option value="">No eligible open or in-progress monthly periods</option>';
            }
            validateFormState();
        } catch (error) {
            periodSelect.innerHTML = '<option value="">Evaluation periods could not be loaded</option>';
            showToast("Could not connect to the server to load evaluation periods. Please try again.", "error");
        }
    }

    async function downloadTemplate() {
        const periodId = periodSelect.value;
        if (!periodId) {
            showToast("Select an evaluation period first.", "error");
            return;
        }
        try {
            const response = await fetch(`/api/v1/kpi-uploads/export-template?period_id=${encodeURIComponent(periodId)}`, {
                method: 'GET',
                credentials: 'include'
            });
            if (response.status === 401) {
                window.location.href = '/auth/login';
                return;
            }
            if (!response.ok) {
                showToast(await getApiErrorMessage(response), "error");
                return;
            }
            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')) {
                showToast(await getApiErrorMessage(response), "error");
                return;
            }

            const blob = await response.blob();
            const disposition = response.headers.get('content-disposition') || '';
            const filenameMatch = disposition.match(/filename\s*=\s*"?([^";]+)"?/i);
            const filename = filenameMatch
                ? filenameMatch[1].replace(/[\\/\\\\]/g, '').trim()
                : "KPI_Master_Template.xlsx";
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename || "KPI_Master_Template.xlsx";
            document.body.appendChild(a);
            a.click();
            a.remove();
            window.setTimeout(() => window.URL.revokeObjectURL(url), 1000);
            showToast("Template downloaded successfully!", "success");
        } catch (error) {
            showToast("Could not connect to the server to download the template. Please try again.", "error");
        }
    }

    // Drag & Drop Logic
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
    dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
        if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            handleFileSelect();
        }
    });

    fileInput.addEventListener('change', handleFileSelect);

    function handleFileSelect() {
        if (fileInput.files.length === 0) return;
        
        const file = fileInput.files[0];
        const validExtensions = ['csv', 'xlsx'];
        const fileExt = file.name.split('.').pop().toLowerCase();

        if (!validExtensions.includes(fileExt)) {
            showToast("Invalid file format. Please upload .csv or .xlsx", "error");
            removeFile();
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            showToast("File exceeds the 5MB limit.", "error");
            removeFile();
            return;
        }

        selectedFile = file;
        
        dropzone.classList.add('hidden');
        filePreviewCard.classList.remove('hidden');
        document.getElementById('fileNameDisplay').innerText = escapeHTML(file.name);
        document.getElementById('fileSizeDisplay').innerText = escapeHTML((file.size / (1024*1024)).toFixed(2)) + " MB";
        
        validateFormState();
    }

    function removeFile() {
        selectedFile = null;
        fileInput.value = '';
        filePreviewCard.classList.add('hidden');
        dropzone.classList.remove('hidden');
        validateFormState();
    }

    function validateFormState() {
        uploadBtn.disabled = !(selectedFile && periodSelect.value);
    }

    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if(!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'fixed top-5 right-5 z-[9999] flex flex-col gap-2 max-w-[90%] sm:max-w-md w-full items-end';
            document.body.appendChild(container);
        }
        
        const toast = document.createElement('div');
        const config = type === 'success' ? 'bg-emerald-50 text-emerald-900 border-emerald-500' : 'bg-red-50 text-red-900 border-red-500';
        toast.className = `flex items-center px-4 sm:px-5 py-3 sm:py-4 rounded-2xl shadow-xl border-l-4 ${config} text-xs sm:text-sm font-bold animate-fade-in-up w-full`;
        toast.innerHTML = escapeHTML(message);
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4500);
    }

    loadPeriods();

    // Upload-failure reason (periods UI polish): show the server's exact
    // detail instead of the generic sentence — e.g. a period with no
    // formula must surface "No KPI formula applies to this period yet…"
    // verbatim. Falls back to the generic sentence only when the server
    // sent no usable detail.
    function submitDetailMessage(detail) {
        if (typeof detail === 'string' && detail.trim()) return detail;
        if (Array.isArray(detail)) {
            const messages = detail.map(item => typeof item === 'string' ? item : (item && item.msg)).filter(Boolean);
            if (messages.length) return messages.join(' ');
        }
        if (detail && typeof detail.message === 'string' && detail.message.trim()) return detail.message;
        return null;
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!selectedFile || !periodSelect.value) return;

        const periodId = periodSelect.value;
        const originalText = uploadBtn.innerHTML;
        const resultBox = document.getElementById('resultBox');
        
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = `<svg class="animate-spin h-4 w-4 sm:h-5 sm:w-5 mr-2 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Aggregating...`;
        resultBox.classList.add('hidden');

        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('period_id', periodId);

        try {
            const response = await fetch('/api/v1/kpi-uploads/monthly-data', {
                method: 'POST',
                body: formData
            });

            // 🛡️ AUTH FIX
            if (response.status === 401) {
                window.location.href = '/auth/login';
                return;
            }
            if (response.status === 403) {
                showToast("You do not have permission to import KPI data.", "error");
                return;
            }

            const result = await response.json();
            resultBox.classList.remove('hidden');

            if (response.ok) {
                resultBox.innerHTML = `
                    <div class="bg-emerald-50 border border-emerald-200 p-5 sm:p-6 rounded-2xl shadow-sm flex items-start gap-3 sm:gap-4">
                        <div class="bg-white p-2 sm:p-2.5 rounded-full text-emerald-600 shadow-sm border border-emerald-100 shrink-0 mt-0.5 sm:mt-1">
                            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-lg sm:text-xl font-black text-emerald-900 tracking-tight">Data Integration Complete!</h3>
                            <p class="text-xs sm:text-sm text-emerald-700 font-semibold mt-1">Successfully aggregated <strong>${escapeHTML(result.processed_count || 0)}</strong> employee records.</p>
                        </div>
                    </div>
                `;
                removeFile(); 
                validateFormState(); 
            } else {
                let errorHtml = '';
                const detail = result.detail;
                if (detail && detail.code === 'validation_error' && Array.isArray(detail.errors)) {
                    const errors = detail.errors;
                    errorHtml = `
                        <div class="mt-4 bg-white p-4 sm:p-5 rounded-xl border border-red-100 shadow-inner max-h-40 sm:max-h-48 overflow-y-auto custom-scrollbar">
                            <p class="text-[9px] sm:text-[10px] font-black text-red-800 mb-2 uppercase tracking-wider">Please fix the following Excel validation errors:</p>
                            <ul class="text-[10px] sm:text-xs text-red-600 list-disc list-inside space-y-1.5 font-semibold">
                                ${errors.map(err => `<li>${escapeHTML(err)}</li>`).join('')}
                            </ul>
                        </div>
                    `;
                }

                resultBox.innerHTML = `
                    <div class="bg-red-50 border border-red-200 p-5 sm:p-6 rounded-2xl shadow-sm flex items-start gap-3 sm:gap-4">
                        <div class="bg-white p-2 sm:p-2.5 rounded-full text-red-600 shadow-sm border border-red-100 shrink-0 mt-0.5 sm:mt-1">
                            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <div class="w-full min-w-0">
                            <h3 class="text-lg sm:text-xl font-black text-red-900 tracking-tight">Upload Failed</h3>
                            <p class="text-xs sm:text-sm text-red-700 font-semibold mt-1">${detail && detail.code === 'validation_error' ? 'Correct the listed workbook issues and upload again.' : escapeHTML(submitDetailMessage(detail) || 'The server could not process this file. Please try again.')}</p>
                            ${errorHtml}
                        </div>
                    </div>
                `;
            }
        } catch (error) {
            showToast("A critical network error occurred.", "error");
        } finally {
            uploadBtn.innerHTML = originalText;
            validateFormState(); 
        }
    });
</script>
{% endblock %}