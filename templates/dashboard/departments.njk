{% extends "layouts/base.njk" %}
{% set active_page = "departments" %}

{% block title %}Departments Management - KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/avatar.css">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<!-- 🌟 RESPONSIVE FIX: Header flex-direction adjusted for mobile -->
<!-- HEADER -->
<header class="workspace-header">
    <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-blue-950 flex items-center tracking-tight">Departments Management</h2>
        <p class="text-slate-500 mt-1 text-xs sm:text-sm">Manage organization departments, heads, and team levels.</p>
    </div>
    <div class="w-full md:w-auto">
        <button onclick="openDepartmentModal()" class="w-full md:w-auto bg-blue-950 hover:bg-blue-900 text-white px-5 py-2.5 rounded-xl text-sm font-bold flex justify-center items-center shadow-md transition transform hover:-translate-y-0.5">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add New Department
        </button>
    </div>
</header>

<!-- MAIN CONTENT CONTAINER -->
<div class="workspace-page">
    
    <!-- Controls (Tabs & Search) -->
    <!-- 🌟 RESPONSIVE FIX: Tabs and search bar alignment for mobile -->
    <div class="workspace-toolbar mb-4">
        <!-- Tabs -->
        <div class="workspace-tabs w-full xl:w-auto">
            <button id="tabActive" onclick="switchTab('active')" class="whitespace-nowrap px-4 sm:px-5 py-2 bg-white text-blue-950 rounded-lg text-xs sm:text-sm font-bold shadow-sm transition flex-1 xl:flex-none">
                Active Departments
            </button>
            <button id="tabDeleted" onclick="switchTab('deleted')" class="whitespace-nowrap px-4 sm:px-5 py-2 text-slate-500 hover:text-blue-950 rounded-lg text-xs sm:text-sm font-semibold transition flex-1 xl:flex-none">
                Trash (Deleted)
            </button>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full xl:w-72">
            <svg class="w-4 h-4 absolute left-3 top-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <label for="searchInput" class="sr-only">Search departments</label>
            <input type="text" id="searchInput" placeholder="Search department name..." class="w-full bg-white border border-gray-200 pl-10 pr-4 py-2.5 rounded-xl text-sm focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900 transition shadow-sm">
        </div>
    </div>

    <!-- Departments Table Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden relative min-h-[300px]">
        <!-- Overlay Loading Animation -->
        <div id="tableLoader" class="hidden absolute inset-0 bg-white/80 backdrop-blur-sm z-10 flex flex-col items-center justify-center">
            <svg class="animate-spin h-8 w-8 text-blue-900 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        </div>

        <!-- 🌟 RESPONSIVE FIX: Table horizontal scroll wrapper -->
        <div class="overflow-x-auto custom-scrollbar w-full">
            <table class="w-full text-left border-collapse min-w-[500px]"> <!-- min-w added to prevent squishing on mobile -->
                <thead class="bg-slate-50 border-b border-gray-200 text-[10px] sm:text-xs uppercase text-slate-500 font-bold tracking-wider">
                    <tr>
                        <th class="p-3 sm:p-5 w-12 sm:w-16">#</th>
                        <th class="p-3 sm:p-5">Department Name</th>
                        <th class="p-3 sm:p-5 text-center">Priority</th>
                        <th class="p-3 sm:p-5 text-center">Head Assigned</th>
                        <th class="p-3 sm:p-5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="departmentTableBody" class="divide-y divide-gray-100 text-xs sm:text-sm">
                    <tr><td colspan="5" class="p-10 text-center text-slate-400 font-medium">Loading departments...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 🌟 Modal: Create / Edit Department -->
<!-- ========================================== -->
<div id="departmentModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm transition-opacity p-4">
    <div class="bg-white rounded-3xl p-5 sm:p-6 w-full max-w-md shadow-2xl border border-gray-100 transform transition-transform">
        <h3 id="modalTitle" class="text-lg sm:text-xl font-extrabold text-blue-950 mb-5">Create New Department</h3>
        <input type="hidden" id="deptId">
        <div class="mb-6">
            <label for="deptName" class="block text-xs font-bold text-slate-700 mb-2 uppercase">Department Name <span class="text-red-500">*</span></label>
            <input type="text" id="deptName" class="w-full bg-slate-50 border border-gray-200 p-2.5 sm:p-3 rounded-xl focus:outline-none focus:bg-white focus:border-blue-900 transition text-sm font-semibold" placeholder="e.g., Human Resources">
        </div>
        <div class="mb-6">
            <label for="deptPriority" class="block text-xs font-bold text-slate-700 mb-2 uppercase">Priority (0-100)</label>
            <input type="number" id="deptPriority" min="0" max="100" value="0" class="w-full bg-slate-50 border border-gray-200 p-2.5 sm:p-3 rounded-xl text-sm font-semibold">
        </div>
        <!-- 🌟 RESPONSIVE FIX: Buttons stretch on mobile -->
        <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button onclick="closeDepartmentModal()" class="w-full sm:w-auto bg-white border border-gray-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 px-5 py-2.5 rounded-xl text-sm font-bold transition">Cancel</button>
            <button id="saveDeptBtn" onclick="saveDepartment()" class="w-full sm:w-auto bg-blue-950 hover:bg-blue-900 text-white px-6 py-2.5 rounded-xl text-sm font-bold transition shadow-md flex justify-center">
                Save Department
            </button>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 🌟 Modal: Manage Department Members -->
<!-- ========================================== -->
<div id="assignUserModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-2 sm:p-4">
    <div class="bg-white rounded-3xl p-4 sm:p-8 w-full max-w-4xl shadow-2xl border border-gray-100 flex flex-col max-h-[95vh] sm:max-h-[90vh]">
        
        <div class="flex justify-between items-center mb-4 sm:mb-6 shrink-0 border-b border-gray-100 pb-4">
            <div>
                <h3 class="text-xl sm:text-2xl font-extrabold text-blue-950" id="assignModalTitle">Department Workspace</h3>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Manage employees and team levels (L0, L1, L2).</p>
            </div>
            <button onclick="closeAssignModal()" class="text-gray-400 hover:text-red-500 bg-gray-50 p-2 rounded-xl transition shrink-0 ml-2">
                <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        
        <input type="hidden" id="assignDeptId">
        
        <!-- Assignment Form -->
        <div class="bg-blue-50/50 p-3 sm:p-4 rounded-2xl border border-blue-100 mb-4 shrink-0">
            <label for="userSelect" class="block text-xs font-bold text-blue-900 mb-2 uppercase">Assign New Employee</label>
            <div class="flex flex-col lg:flex-row gap-3">
                <select id="userSelect" class="border border-white shadow-sm p-2.5 sm:p-3 rounded-xl flex-1 text-xs sm:text-sm font-semibold focus:outline-none focus:border-blue-500 bg-white cursor-pointer w-full">
                    <option value="">-- Select Employee --</option>
                </select>
                <div id="userSelectAvatar" class="flex flex-wrap items-center gap-2 mt-2" aria-live="polite"></div>
                
                <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">
                    <label for="userLevelSelect" class="sr-only">Employee department level</label>
                    <select id="userLevelSelect" class="border border-white shadow-sm p-2.5 sm:p-3 rounded-xl w-full sm:w-48 text-xs sm:text-sm font-semibold focus:outline-none focus:border-blue-500 bg-white cursor-pointer">
                        <option value="L2">L2 (Staff)</option>
                        <option value="L1">L1 (Supervisor)</option>
                        <option value="L0">L0 (Dept Head)</option>
                    </select>
                    
                    <button id="assignUserBtn" onclick="assignUserToDept()" class="bg-blue-950 hover:bg-blue-900 text-white px-6 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold transition shadow-md whitespace-nowrap flex items-center justify-center w-full sm:w-auto">
                        + Assign User
                    </button>
                </div>
            </div>
        </div>

        <!-- Employee List -->
        <!-- 🌟 RESPONSIVE FIX: Table horizontal scroll wrapper -->
        <div class="flex-1 min-h-0 overflow-hidden bg-white border border-gray-200 rounded-2xl relative flex flex-col">
             <div id="userListLoader" class="hidden absolute inset-0 bg-white/80 backdrop-blur-sm z-10 flex items-center justify-center">
                <svg class="animate-spin h-8 w-8 text-blue-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            
            <div class="overflow-x-auto overflow-y-auto custom-scrollbar flex-1">
                <table class="w-full text-left text-sm min-w-[500px]"> <!-- min-w added -->
                    <thead class="bg-slate-50 border-b border-gray-200 text-[10px] sm:text-xs text-slate-500 uppercase sticky top-0 z-10 shadow-sm">
                        <tr>
                            <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold">Employee Info</th>
                            <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold text-center">Role Level</th>
                            <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="deptUsersList" class="divide-y divide-gray-100 bg-white text-xs sm:text-sm">
                        <tr><td colspan="3" class="text-slate-400 text-center py-10 font-medium">Loading members...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 🌟 Shared Mini Modal (Level / Transfer) -->
<!-- ========================================== -->
<div id="actionModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-3xl p-5 sm:p-6 w-full max-w-sm shadow-2xl border border-gray-100 transform transition-transform">
        <h3 class="text-lg sm:text-xl font-extrabold text-blue-950 mb-2" id="actionModalTitle">Action</h3>
        <p class="text-xs sm:text-sm text-slate-500 mb-5" id="actionModalDesc">Description</p>
        
        <input type="hidden" id="actionUserId">
        <input type="hidden" id="actionDeptId">
        
        <div id="actionModalContentArea" class="mb-6">
            <!-- Dynamic Content Injected Here -->
        </div>

        <div class="flex flex-col-reverse sm:flex-row justify-end gap-2">
            <button onclick="closeActionModal()" class="w-full sm:w-auto bg-white border border-gray-200 text-slate-600 hover:bg-slate-50 px-5 py-2.5 rounded-xl text-sm font-bold transition">Cancel</button>
            <button id="actionBtn" class="w-full sm:w-auto bg-blue-950 hover:bg-blue-900 text-white px-5 py-2.5 rounded-xl text-sm font-bold transition shadow-md flex justify-center">
                Confirm
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script>
    const API_BASE_URL = "/api/v1/departments";
    const USER_API_URL = "/api/v1/users";
    
    let currentTab = 'active';
    let allFetchedDepartments = []; 
    let currentActiveDeptId = null;
    let departmentAvailableUsers = [];

    // --- Loading & Helpers ---
    function setButtonLoading(buttonId, isLoading, originalText = "Save") {
        const btn = document.getElementById(buttonId);
        if (!btn) return;
        
        if (isLoading) {
            btn.disabled = true;
            btn.dataset.text = btn.innerHTML;
            btn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Processing...`;
        } else {
            btn.disabled = false;
            btn.innerHTML = btn.dataset.text || originalText;
        }
    }

    function toggleLoader(loaderId, show) {
        const loader = document.getElementById(loaderId);
        if (loader) {
            if (show) loader.classList.remove('hidden');
            else loader.classList.add('hidden');
        }
    }

    // 🌟 SECURITY FIX: Global HTML Escape Function
    function escapeHTML(str) {
        if (str === null || str === undefined) return "";
        return str.toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    // 🌟 RESPONSIVE FIX: Toast container alignment adjusted for mobile
    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if(!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'fixed top-5 right-5 z-[9999] flex flex-col space-y-3 max-w-[90%] sm:max-w-md items-end';
            document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        const bgColor = type === 'success' ? 'bg-green-50 border-green-500 text-green-900' : 'bg-red-50 border-red-500 text-red-900';
        const icon = type === 'success' 
            ? `<svg class="w-5 h-5 text-green-500 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
            : `<svg class="w-5 h-5 text-red-500 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

        toast.className = `flex items-start p-3 sm:p-4 mb-3 sm:mb-4 border-l-4 rounded-xl shadow-lg w-full bg-white ${bgColor} transition-all duration-300 transform translate-x-full opacity-0 pointer-events-auto`;
        toast.innerHTML = `${icon}<div class="text-xs sm:text-sm font-medium whitespace-pre-line flex-1">${escapeHTML(message)}</div>`;
        
        container.appendChild(toast);
        requestAnimationFrame(() => {
            toast.classList.remove('translate-x-full', 'opacity-0');
            toast.classList.add('translate-x-0', 'opacity-100');
        });
        
        setTimeout(() => {
            toast.classList.remove('translate-x-0', 'opacity-100');
            toast.classList.add('translate-x-full', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
        }, 5000);
    }

    // --- Tab Management ---
    function switchTab(tabName) {
        currentTab = tabName;
        const tabActive = document.getElementById("tabActive");
        const tabDeleted = document.getElementById("tabDeleted");

        const activeStyle = "whitespace-nowrap px-4 sm:px-5 py-2 bg-white text-blue-950 rounded-lg text-xs sm:text-sm font-bold shadow-sm transition flex-1 xl:flex-none";
        const inactiveStyle = "whitespace-nowrap px-4 sm:px-5 py-2 text-slate-500 hover:text-blue-950 rounded-lg text-xs sm:text-sm font-semibold transition flex-1 xl:flex-none";

        if (tabName === 'active') {
            tabActive.className = activeStyle;
            tabDeleted.className = inactiveStyle;
        } else {
            tabDeleted.className = activeStyle;
            tabActive.className = inactiveStyle;
        }
        
        document.getElementById("searchInput").value = ""; 
        fetchDepartments();
    }

    // --- Fetch & Render Departments ---
    async function fetchDepartments() {
        toggleLoader('tableLoader', true);
        try {
            const url = currentTab === 'active' ? API_BASE_URL : `${API_BASE_URL}?is_active=false`;
            const response = await fetchWithTimeout(url);
            
            // 🛡️ AUTH FIX: Redirect if unauthorized
            if (response.status === 401 || response.status === 403) {
                window.location.href = '/auth/login';
                return;
            }
            
            if (!response.ok) throw new Error("Failed to fetch departments");
            
            allFetchedDepartments = await response.json();
            renderDepartments();
        } catch (error) { 
            console.error(error); 
            // Persistent error state (not just a toast): an empty table
            // would read as "there are no departments".
            document.getElementById("departmentTableBody").innerHTML = '<tr><td colspan="5" class="p-10 text-left sm:text-center text-red-500 font-bold">Failed to load departments. <button type="button" onclick="fetchDepartments()" class="ml-3 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50">Retry</button></td></tr>';
        } finally {
            toggleLoader('tableLoader', false);
        }
    }

    function renderDepartments() {
        const tbody = document.getElementById("departmentTableBody");
        const query = document.getElementById("searchInput").value.toLowerCase();
        tbody.innerHTML = "";

        const filtered = allFetchedDepartments.filter(dept => dept.name.toLowerCase().includes(query));

        if (filtered.length === 0) {
            const emptyMsg = query ? 'No matching departments found.' : (currentTab === 'active' ? 'No active departments found.' : 'Trash is empty.');
            tbody.innerHTML = `<tr><td colspan="5" class="p-10 text-center text-slate-400 font-medium">${emptyMsg}</td></tr>`;
            return;
        }

        filtered.sort((a, b) => (b.priority || 0) - (a.priority || 0)).forEach((dept, index) => {
            const tr = document.createElement("tr");
            tr.className = "hover:bg-blue-50/30 group bg-white transition-colors";
            
            let nameStyle = currentTab === 'active' ? "text-blue-950" : "text-slate-400 line-through";
            let actionButtons = "";

            if (currentTab === 'active') {
                actionButtons = `
                    <div class="flex justify-end gap-1.5 flex-wrap">
                        <button type="button" data-department-action="members" class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-xl transition-colors border border-transparent hover:border-emerald-200 shadow-sm" title="Workspace (Manage Members)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        </button>
                        <button type="button" data-department-action="edit" class="p-2 text-blue-600 hover:bg-blue-50 rounded-xl transition-colors border border-transparent hover:border-blue-200 shadow-sm" title="Edit Department">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        </button>
                        <button type="button" data-department-action="delete" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-colors border border-transparent hover:border-red-200 shadow-sm" title="Delete">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                `;
            } else {
                actionButtons = `
                    <div class="flex justify-end gap-1.5 flex-wrap">
                        <button type="button" data-department-action="restore" class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-xl transition-colors border border-transparent hover:border-emerald-200 shadow-sm" title="Restore">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        </button>
                        <button type="button" data-department-action="purge" class="p-2 text-red-600 hover:bg-red-50 rounded-xl transition-colors border border-transparent hover:border-red-200 shadow-sm" title="Purge">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>
                `;
            }

            const headBadge = dept.head_id 
                ? '<span class="px-2 sm:px-3 py-1 bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wide flex items-center justify-center w-max mx-auto shadow-sm whitespace-nowrap"><svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg> Assigned</span>' 
                : '<span class="px-2 sm:px-3 py-1 bg-slate-100 border border-slate-200 text-slate-500 rounded-lg text-[9px] sm:text-[10px] font-bold uppercase tracking-wide flex items-center justify-center w-max mx-auto shadow-sm">None</span>';

            tr.innerHTML = `
                <td class="p-3 sm:p-5 text-slate-500 font-semibold">${index + 1}</td>
                <td class="p-3 sm:p-5 font-extrabold ${nameStyle} whitespace-normal min-w-[150px]">${escapeHTML(dept.name)}</td>
                <td class="p-3 sm:p-5 text-center"><span class="rounded-lg bg-blue-50 px-2 py-1 text-xs font-extrabold text-blue-800">${Number(dept.priority || 0)}</span></td>
                <td class="p-3 sm:p-5 text-center">${headBadge}</td>
                <td class="p-3 sm:p-5 text-right">${actionButtons}</td>
            `;
            tr.querySelectorAll("[data-department-action]").forEach(button => {
                button.addEventListener("click", () => {
                    switch (button.dataset.departmentAction) {
                        case "members": openAssignModal(dept.id, dept.name); break;
                        case "edit": openDepartmentModal(dept.id, dept.name, Number(dept.priority || 0)); break;
                        case "delete": deleteDepartment(dept.id); break;
                        case "restore": restoreDepartment(dept.id); break;
                        case "purge": hardDeleteDepartment(dept.id); break;
                    }
                });
            });
            tbody.appendChild(tr);
        });
    }

    // --- Department Modals (Create/Edit) ---
    function openDepartmentModal(id = "", name = "", priority = 0) {
        document.getElementById("deptId").value = id;
        document.getElementById("deptName").value = name;
        document.getElementById("deptPriority").value = priority;
        document.getElementById("modalTitle").innerText = id ? "Edit Department" : "Create New Department";
        document.getElementById("departmentModal").classList.remove("hidden");
    }
    
    function closeDepartmentModal() { document.getElementById("departmentModal").classList.add("hidden"); }

    async function saveDepartment() {
        const id = document.getElementById("deptId").value;
        const name = document.getElementById("deptName").value.trim();
        const priority = Number(document.getElementById("deptPriority").value);
        if (!name) return window.showToast("Please enter a department name.", "warning");
        if (!Number.isInteger(priority) || priority < 0 || priority > 100) return window.showToast("Priority must be between 0 and 100.", "warning");
        
        setButtonLoading('saveDeptBtn', true);
        const method = id ? "PUT" : "POST";
        const url = id ? `${API_BASE_URL}/${id}` : API_BASE_URL;
        
        try {
            const response = await fetch(url, { method: method, headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: name, priority: priority }) });
            if (response.ok) { 
                closeDepartmentModal(); 
                showToast("Department saved successfully.", "success");
                await fetchDepartments();
            } else { 
                const err = await response.json().catch(() => ({}));
                window.showToast(`Unable to save the department (HTTP ${response.status}): ${err.detail || "Please try again."}`, "error");
            }
        } catch (error) { console.error(error); window.showToast("Network error while saving the department.", "error"); }
        finally { setButtonLoading('saveDeptBtn', false, "Save Department"); }
    }

    // --- Delete / Restore ---
    async function deleteDepartment(deptId) {
        if (!(await window.appConfirm("Move this department to trash?", { title: "Delete department?", confirmText: "Move to trash" }))) return;
        toggleLoader('tableLoader', true);
        try {
            const response = await fetch(`${API_BASE_URL}/${deptId}`, { method: "DELETE" });
            if (response.ok) { window.showToast("Department moved to trash.", "success"); await fetchDepartments(); }
            else { window.showToast(`Unable to delete the department (HTTP ${response.status}).`, "error"); }
        } catch (error) { console.error(error); window.showToast("Network error while deleting the department.", "error"); }
        finally { toggleLoader('tableLoader', false); }
    }

    async function restoreDepartment(deptId) {
        if (!(await window.appConfirm("Restore this department?", { title: "Restore department?" }))) return;
        toggleLoader('tableLoader', true);
        try {
            const response = await fetch(`${API_BASE_URL}/${deptId}/restore`, { method: "POST" });
            if (response.ok) { window.showToast("Department restored.", "success"); await fetchDepartments(); }
            else { window.showToast(`Unable to restore the department (HTTP ${response.status}).`, "error"); }
        } catch (error) { console.error(error); window.showToast("Network error while restoring the department.", "error"); }
        finally { toggleLoader('tableLoader', false); }
    }

    async function hardDeleteDepartment(deptId) {
        if (!(await window.appConfirm("Permanent delete cannot be undone.", { title: "Delete department permanently?", confirmText: "Delete" }))) return;
        toggleLoader('tableLoader', true);
        try {
            const response = await fetch(`${API_BASE_URL}/${deptId}/permanent`, { method: "DELETE" });
            if (response.ok) { window.showToast("Department permanently deleted.", "success"); await fetchDepartments(); }
            else { window.showToast(`Unable to permanently delete the department (HTTP ${response.status}).`, "error"); }
        } catch (error) { console.error(error); window.showToast("Network error while permanently deleting the department.", "error"); }
        finally { toggleLoader('tableLoader', false); }
    }

    // ==========================================
    // 🌟 Department Users Workspace
    // ==========================================
    async function openAssignModal(deptId, deptName) {
        currentActiveDeptId = deptId;
        document.getElementById("assignDeptId").value = deptId;
        document.getElementById("assignModalTitle").innerText = `${deptName} - Workspace`;
        document.getElementById("assignUserModal").classList.remove("hidden");
        await refreshUserList(deptId);
    }
    
    function closeAssignModal() { 
        document.getElementById("assignUserModal").classList.add("hidden"); 
        currentActiveDeptId = null;
    }
    
    async function refreshUserList(deptId) {
        toggleLoader('userListLoader', true);
        try {
            const response = await fetch(USER_API_URL);
            if (!response.ok) throw new Error("Failed to load active users.");
            const allUsers = await response.json();
            departmentAvailableUsers = allUsers;
            
            const deptUsers = [];
            const nonDeptUsers = [];

            allUsers.forEach(user => {
                const deptInfo = user.departments && user.departments.find(d => d.id === deptId);
                if (deptInfo) {
                    deptUsers.push({
                        id: user.id,
                        name: `${user.first_name || ''} ${user.last_name || ''}`.trim(),
                        email: user.email,
                        display_name: user.display_name || `${user.first_name || ''} ${user.last_name || ''}`.trim(),
                        avatar_url: user.avatar_url,
                        initials: user.initials,
                        avatar_color_index: user.avatar_color_index,
                        position: user.position?.name || 'No Title',
                        user_level: deptInfo.level || 'L2',
                        is_department_head: deptInfo.is_head || false
                    });
                } else {
                    nonDeptUsers.push(user);
                }
            });

            const tbody = document.getElementById("deptUsersList");
            tbody.innerHTML = "";

            const select = document.getElementById("userSelect");
            const defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "-- Select Employee --";
            select.replaceChildren(defaultOption);
            document.getElementById("userSelectAvatar").replaceChildren();
            nonDeptUsers.forEach(user => {
                const roleName = user.role?.name || "";
                if (!roleName.toLowerCase().includes("super admin")) {
                    const name = `${user.first_name || ''} ${user.last_name || ''}`.trim();
                    const option = document.createElement("option");
                    option.value = user.id;
                    option.textContent = `${name} - ${user.position?.name || 'No Title'} (${user.email})`;
                    select.appendChild(option);
                }
            });

            if (deptUsers.length === 0) {
                tbody.innerHTML = `<tr>
                    <td colspan="3" class="px-4 sm:px-6 py-12 text-center text-slate-400 bg-slate-50/50">
                        <svg class="w-10 h-10 sm:w-12 sm:h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        <p class="font-bold text-slate-500 text-sm">No members assigned yet.</p>
                        <p class="text-[10px] sm:text-xs mt-1">Select an employee from above to add them to this workspace.</p>
                    </td>
                </tr>`;
                return;
            }

            deptUsers.sort((a, b) => a.user_level.localeCompare(b.user_level));

            deptUsers.forEach(user => {
                const tr = document.createElement("tr");
                tr.className = "hover:bg-blue-50/30 transition-colors group bg-white";
                
                tr.innerHTML = `
                    <td class="px-4 sm:px-6 py-3 sm:py-4 min-w-[200px] whitespace-normal">
                        <div class="flex items-center gap-3">
                            ${window.kpiAvatarMarkup(user, 32)}
                            <div class="min-w-0">
                                <p class="font-extrabold text-blue-950 text-xs sm:text-sm truncate">${escapeHTML(user.name)}</p>
                                <p class="text-[10px] sm:text-[11px] text-slate-500 font-semibold mt-0.5 tracking-wide truncate">${escapeHTML(user.position)} • ${escapeHTML(user.email)}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-4 sm:px-6 py-3 sm:py-4 text-center">
                        <div class="flex items-center justify-center gap-1.5 flex-wrap">
                            <span class="bg-slate-100 text-slate-700 border border-slate-200 text-[9px] sm:text-[10px] font-extrabold uppercase px-2 py-1 rounded-md shadow-sm">${escapeHTML(user.user_level)}</span>
                            ${user.is_department_head ? '<span class="text-yellow-800 bg-yellow-100 border border-yellow-300 text-[9px] sm:text-[10px] font-extrabold uppercase px-2 py-1 rounded-md shadow-sm flex items-center"><svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg> Head</span>' : ''}
                        </div>
                    </td>
                    <td class="px-4 sm:px-6 py-3 sm:py-4 text-right">
                        <div class="flex justify-end gap-1.5 flex-wrap">
                            <button type="button" data-member-action="level" class="p-1.5 text-slate-500 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-colors border border-transparent hover:border-blue-200 shadow-sm" title="Change Level">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                            </button>
                            <button type="button" data-member-action="transfer" class="p-1.5 text-slate-500 hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition-colors border border-transparent hover:border-emerald-200 shadow-sm" title="Transfer">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                            </button>
                            <button type="button" data-member-action="remove" class="p-1.5 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors border border-transparent hover:border-red-200 shadow-sm" title="Remove">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </td>
                `;
                tr.querySelectorAll("[data-member-action]").forEach(button => {
                    button.addEventListener("click", () => {
                        switch (button.dataset.memberAction) {
                            case "level": openMiniActionModal("level", user.id, user.name, deptId, user.user_level); break;
                            case "transfer": openMiniActionModal("transfer", user.id, user.name, deptId); break;
                            case "remove": removeUserFromDept(deptId, user.id); break;
                        }
                    });
                });
                tbody.appendChild(tr);
            });
        } catch (error) { 
            console.error("Error refreshing users:", error); 
            const tbody = document.getElementById("deptUsersList");
            tbody.innerHTML = `<tr><td colspan="3" class="text-red-500 text-center py-10 font-bold bg-red-50 text-sm">An error occurred. Please try again.</td></tr>`;
            showToast("Failed to load department members.", "error"); 
        } finally { 
            toggleLoader('userListLoader', false); 
        }
    }

    async function assignUserToDept() {
        const deptId = document.getElementById("assignDeptId").value;
        const userId = document.getElementById("userSelect").value;
        const userLevel = document.getElementById("userLevelSelect").value;

        if (!userId) return window.showToast("Please select an employee.", "warning");
        
        setButtonLoading('assignUserBtn', true, "+ Assign User");
        try {
            const response = await fetch(`${API_BASE_URL}/${deptId}/users`, {
                method: "POST", headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ user_id: userId, user_level: userLevel })
            });
            if (response.ok) {
                await refreshUserList(deptId);
                fetchDepartments();
                showToast("User assigned successfully.", "success");
            } else {
                window.showToast("Unable to assign the employee.", "error");
            }
        } catch (error) { console.error(error); }
        finally { setButtonLoading('assignUserBtn', false, "+ Assign User"); }
    }

    async function removeUserFromDept(deptId, userId) {
        if(!(await window.appConfirm("Remove this user from the department?", { title: "Remove employee?", confirmText: "Remove" }))) return;
        toggleLoader('userListLoader', true);
        try {
            const response = await fetch(`${API_BASE_URL}/${deptId}/users/${userId}`, { method: "DELETE" });
            if(response.ok) {
                await refreshUserList(deptId);
                fetchDepartments();
                showToast("User removed successfully.", "success");
            }
        } catch (error) { console.error(error); }
        finally { toggleLoader('userListLoader', false); }
    }

    // --- Dynamic Mini Action Modal (Change Level & Transfer) ---
    async function openMiniActionModal(actionType, userId, userName, currentDeptId, extraData = null) {
        document.getElementById("actionUserId").value = userId;
        document.getElementById("actionDeptId").value = currentDeptId;
        const contentArea = document.getElementById("actionModalContentArea");
        const btn = document.getElementById("actionBtn");

        if (actionType === 'level') {
            document.getElementById("actionModalTitle").innerText = "Change Employee Level";
            document.getElementById("actionModalDesc").innerHTML = `Update role level for <strong class="text-blue-900">${escapeHTML(userName)}</strong>.`;
            contentArea.innerHTML = `
                <label for="actionSelectValue" class="block text-xs font-bold text-slate-700 mb-2 uppercase">Select New Level</label>
                <select id="actionSelectValue" class="w-full bg-slate-50 border border-gray-200 p-2.5 sm:p-3 rounded-xl text-sm font-semibold focus:outline-none focus:border-blue-900 shadow-inner">
                    <option value="L2" ${extraData === 'L2' ? 'selected' : ''}>L2 (Staff)</option>
                    <option value="L1" ${extraData === 'L1' ? 'selected' : ''}>L1 (Supervisor)</option>
                    <option value="L0" ${extraData === 'L0' ? 'selected' : ''}>L0 (Dept Head)</option>
                </select>
            `;
            btn.onclick = submitChangeLevel;
        } else if (actionType === 'transfer') {
            document.getElementById("actionModalTitle").innerText = "Transfer Employee";
            document.getElementById("actionModalDesc").innerHTML = `Move <strong class="text-blue-900">${escapeHTML(userName)}</strong> to another department.`;
            contentArea.innerHTML = `
                <label for="actionSelectValue" class="block text-xs font-bold text-slate-700 mb-2 uppercase">Target Department</label>
                <select id="actionSelectValue" class="w-full bg-slate-50 border border-gray-200 p-2.5 sm:p-3 rounded-xl text-sm font-semibold focus:outline-none focus:border-blue-900 shadow-inner">
                    <option value="">-- Loading Departments --</option>
                </select>
            `;
            btn.onclick = submitTransfer;
            
            try {
                const response = await fetch(API_BASE_URL); 
                const depts = await response.json();
                const sel = document.getElementById("actionSelectValue");
                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "-- Choose Target Department --";
                sel.replaceChildren(defaultOption);
                depts.forEach(d => {
                    if (d.id !== currentDeptId) {
                        const option = document.createElement("option");
                        option.value = d.id;
                        option.textContent = d.name;
                        sel.appendChild(option);
                    }
                });
            } catch(e) { console.error(e); }
        }

        document.getElementById("actionModal").classList.remove("hidden");
    }

    function closeActionModal() { document.getElementById("actionModal").classList.add("hidden"); }

    async function submitChangeLevel() {
        const userId = document.getElementById("actionUserId").value;
        const deptId = document.getElementById("actionDeptId").value;
        const newLevel = document.getElementById("actionSelectValue").value;

        setButtonLoading('actionBtn', true);
        try {
            const response = await fetch(`${API_BASE_URL}/${deptId}/users/${userId}/level`, {
                method: "PUT", headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ user_level: newLevel })
            });
            if (response.ok) {
                closeActionModal();
                await refreshUserList(deptId);
                fetchDepartments();
                showToast("Level changed successfully.", "success");
            } else {
                window.showToast("Unable to remove the employee.", "error");
            }
        } catch(e) { console.error(e); }
        finally { setButtonLoading('actionBtn', false, "Confirm"); }
    }

    async function submitTransfer() {
        const userId = document.getElementById("actionUserId").value;
        const currentDeptId = document.getElementById("actionDeptId").value;
        const newDeptId = document.getElementById("actionSelectValue").value;

        if(!newDeptId) return window.showToast("Please select a target department.", "warning");
        
        setButtonLoading('actionBtn', true);
        try {
            const response = await fetch(`${API_BASE_URL}/transfer-user`, {
                method: "PUT", headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ user_id: userId, old_department_id: currentDeptId, new_department_id: newDeptId })
            });
            if (response.ok) {
                closeActionModal();
                await refreshUserList(currentDeptId);
                fetchDepartments();
                showToast("Transferred successfully.", "success");
            } else {
                window.showToast("Unable to transfer the employee.", "error");
            }
        } catch(e) { console.error(e); }
        finally { setButtonLoading('actionBtn', false, "Confirm"); }
    }

    // Init
    document.getElementById("searchInput").addEventListener("input", renderDepartments);
    document.addEventListener("DOMContentLoaded", fetchDepartments);
    document.getElementById("userSelect")?.addEventListener("change", (event) => {
        const user = departmentAvailableUsers.find((item) => String(item.id) === event.target.value);
        const preview = document.getElementById("userSelectAvatar");
        preview.innerHTML = user ? window.kpiAvatarMarkup(user, 32) : "";
    });
</script>
{% endblock %}