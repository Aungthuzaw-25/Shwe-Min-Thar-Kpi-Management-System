{% extends "layouts/base.njk" %}
{% set active_page = "audit_logs" %}

{% block title %}Audit Logs - KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/avatar.css">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<style>
    .audit-shell { background: var(--color-bg); }
    .audit-stat {
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }
    .audit-table-row {
        transition: background-color 160ms ease, box-shadow 160ms ease;
    }
    .audit-table-row:hover {
        background: #f8fafc;
        box-shadow: inset 3px 0 0 var(--color-primary);
    }
    .audit-table-row td {
        vertical-align: top;
    }
    .audit-detail summary {
        cursor: pointer;
        list-style: none;
    }
    .audit-detail summary::-webkit-details-marker {
        display: none;
    }
    .audit-detail[open] summary .audit-chevron {
        transform: rotate(180deg);
    }
    .audit-chevron {
        transition: transform 160ms ease;
    }
    @media (prefers-reduced-motion: reduce) {
        .audit-table-row,
        .audit-chevron {
            transition: none;
        }
    }
</style>

<main class="audit-shell workspace-page min-h-full overflow-y-auto">
    <div class="mx-auto max-w-7xl">
        <header class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-red-800">
                    <span class="h-2 w-2 rounded-full bg-red-700"></span>
                    Governance &amp; security
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Audit logs</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                    Review administrative changes and security-sensitive actions captured by the platform.
                </p>
            </div>
            <button id="refreshLogsButton" type="button" onclick="fetchAuditLogs()"
                    class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-red-200 hover:text-red-800 focus:outline-none focus:ring-2 focus:ring-red-200">
                <svg id="refreshIcon" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Refresh logs
            </button>
        </header>

        <section class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3" aria-label="Audit log summary">
            <div class="audit-stat rounded-2xl border border-slate-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Current page</span>
                    <span class="rounded-lg bg-slate-100 p-2 text-slate-600">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.707V19a2 2 0 01-2 2z"/></svg>
                    </span>
                </div>
                <p id="totalCount" class="mt-3 text-2xl font-extrabold text-slate-900">—</p>
                <p id="pageSummary" class="mt-1 text-xs text-slate-500">Loading page</p>
            </div>
            <div class="audit-stat rounded-2xl border border-slate-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Visible results</span>
                    <span class="rounded-lg bg-blue-50 p-2 text-blue-700">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 8h12M9 12h6M11 16h2M10 20h4"/></svg>
                    </span>
                </div>
                <p id="visibleCount" class="mt-3 text-2xl font-extrabold text-slate-900">—</p>
                <p class="mt-1 text-xs text-slate-500">After search and filters</p>
            </div>
            <div class="audit-stat rounded-2xl border border-slate-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Latest activity</span>
                    <span class="rounded-lg bg-emerald-50 p-2 text-emerald-700">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </span>
                </div>
                <p id="latestActivity" class="mt-3 truncate text-base font-extrabold text-slate-900">—</p>
                <p class="mt-1 text-xs text-slate-500">Newest record on this page</p>
            </div>
        </section>

        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-4 py-4 sm:px-6">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                        <h2 class="text-base font-extrabold text-slate-900">System activity</h2>
                        <p class="mt-1 text-xs text-slate-500">Changes are shown newest first.</p>
                    </div>
                    <div class="flex flex-col gap-2 sm:flex-row">
                        <label class="relative block">
                            <span class="sr-only">Search audit logs</span>
                            <svg class="pointer-events-none absolute left-3 top-3 h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 0-2 2l6 6"/></svg>
                            <input id="searchInput" type="search" placeholder="Search actor, action, table..."
                                   class="w-full rounded-xl border border-slate-200 py-2.5 pl-9 pr-3 text-sm text-slate-700 outline-none transition placeholder:text-slate-400 focus:border-red-400 focus:ring-2 focus:ring-red-100 sm:w-64">
                        </label>
                        <label>
                            <span class="sr-only">Filter by action</span>
                            <select id="actionFilter" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-600 outline-none focus:border-red-400 focus:ring-2 focus:ring-red-100 sm:w-40">
                                <option value="">All actions</option>
                            </select>
                        </label>
                    </div>
                </div>
            </div>

            <div id="logsStatus" class="hidden border-b border-slate-100 px-4 py-2.5 text-xs font-semibold sm:px-6" role="status"></div>
            <div class="custom-scrollbar overflow-x-auto">
                <table class="w-full min-w-[920px] text-left">
                    <thead class="bg-slate-50 text-[11px] font-extrabold uppercase tracking-wider text-slate-500">
                        <tr>
                            <th scope="col" class="px-6 py-4">When</th>
                            <th scope="col" class="px-6 py-4">Actor</th>
                            <th scope="col" class="px-6 py-4">Action</th>
                            <th scope="col" class="px-6 py-4">Affected resource</th>
                            <th scope="col" class="px-6 py-4">Change summary</th>
                            <th scope="col" class="px-6 py-4 text-right">Source</th>
                        </tr>
                    </thead>
                    <tbody id="logsTableBody" class="divide-y divide-slate-100">
                        <tr><td colspan="6" class="px-6 py-16 text-center text-sm text-slate-500">Loading audit logs...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
        <nav class="mt-4 flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3"
             aria-label="Audit log pages">
            <button id="previousPageButton" type="button" onclick="changeAuditPage(-1)" disabled
                    class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                Previous
            </button>
            <span id="currentPageLabel" class="text-sm font-semibold text-slate-600">Page 1</span>
            <button id="nextPageButton" type="button" onclick="changeAuditPage(1)" disabled
                    class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
                Next
            </button>
        </nav>
        <p class="mt-4 text-xs text-slate-400">Audit records are read-only and restricted to authorized administrators.</p>
    </div>
</main>
{% endblock %}

{% block scripts %}
<script>
    let allLogs = [];
    let currentPage = 0;
    let hasNextPage = false;
    let searchDebounce;
    const pageSize = 50;
    const seenActions = new Set();
    const displayTimeZone = "{{ timezone or 'Asia/Yangon' }}";

    function escapeHTML(value) {
        if (value === null || value === undefined) return "";
        return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;").replaceAll("'", "&#039;");
    }

    function formatAuditValue(value) {
        if (value === null || value === undefined) return "None";
        if (typeof value === "string") return value.trim() ? value : "(empty)";
        if (typeof value === "number" || typeof value === "boolean") return String(value);
        if (Array.isArray(value)) return value.length ? value.map(formatAuditValue).join(", ") : "(empty list)";
        return "(structured value)";
    }

    function formatTimestamp(timestamp) {
        const date = new Date(timestamp);
        if (Number.isNaN(date.getTime())) return { date: "Unknown time", relative: "" };
        const dateText = new Intl.DateTimeFormat(undefined, { timeZone: displayTimeZone, dateStyle: "medium", timeStyle: "short" }).format(date);
        const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
        const relative = seconds < 60 ? "Just now" : seconds < 3600 ? `${Math.floor(seconds / 60)}m ago` : seconds < 86400 ? `${Math.floor(seconds / 3600)}h ago` : `${Math.floor(seconds / 86400)}d ago`;
        return { date: dateText, relative };
    }

    function actionClass(action) {
        const value = (action || "").toUpperCase();
        if (value.includes("DELETE") || value.includes("FAIL")) return "bg-red-50 text-red-700 ring-red-100";
        if (value.includes("CREATE") || value.includes("LOGIN")) return "bg-emerald-50 text-emerald-700 ring-emerald-100";
        if (value.includes("UPDATE") || value.includes("CHANGE")) return "bg-amber-50 text-amber-700 ring-amber-100";
        return "bg-blue-50 text-blue-700 ring-blue-100";
    }

    function renderChanges(oldValue, newValue) {
        const oldObject = oldValue && typeof oldValue === "object" && !Array.isArray(oldValue) ? oldValue : {};
        const newObject = newValue && typeof newValue === "object" && !Array.isArray(newValue) ? newValue : {};
        const keys = [...new Set([...Object.keys(oldObject), ...Object.keys(newObject)])];
        if (!keys.length) return `<span class="text-xs text-slate-500">${escapeHTML(formatAuditValue(newValue || oldValue))}</span>`;
        return `<details class="audit-detail max-w-sm"><summary class="flex items-center justify-between gap-2 text-xs font-semibold text-slate-600 hover:text-red-800"><span>${keys.length} field${keys.length === 1 ? "" : "s"} changed</span><svg class="audit-chevron h-4 w-4 shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"/></svg></summary><div class="mt-3 space-y-2">${keys.map(key => `<div class="rounded-lg bg-slate-50 px-3 py-2"><div class="mb-1 text-[10px] font-extrabold uppercase tracking-wide text-slate-400">${escapeHTML(key)}</div><div class="grid grid-cols-[1fr_auto_1fr] gap-2 text-xs"><span class="break-words text-slate-500">${escapeHTML(formatAuditValue(oldObject[key]))}</span><span class="text-slate-300">→</span><span class="break-words font-semibold text-slate-800">${escapeHTML(formatAuditValue(newObject[key]))}</span></div></div>`).join("")}</div></details>`;
    }

    function updateSummary(logs) {
        document.getElementById("totalCount").textContent = `Page ${currentPage + 1}`;
        document.getElementById("visibleCount").textContent = logs.length;
        const latest = allLogs[0];
        document.getElementById("latestActivity").textContent = latest ? formatTimestamp(latest.timestamp).relative : "No activity yet";
        document.getElementById("pageSummary").textContent =
            `Showing ${logs.length} record${logs.length === 1 ? "" : "s"} on this page`;
        document.getElementById("currentPageLabel").textContent = `Page ${currentPage + 1}`;
        document.getElementById("previousPageButton").disabled = currentPage === 0;
        document.getElementById("nextPageButton").disabled = !hasNextPage;
    }

    function renderLogs(logs) {
        const tbody = document.getElementById("logsTableBody");
        updateSummary(logs);
        if (!logs.length) {
            tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-16 text-center"><div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 01.586-1.414l4-4A2 2 0 0113 3h4a2 2 0 012 2v14a2 2 0 01-2 2z"/></svg></div><p class="mt-3 text-sm font-bold text-slate-700">No audit activity found</p><p class="mt-1 text-xs text-slate-500">Try changing your search or filter.</p></td></tr>`;
            return;
        }
        tbody.innerHTML = logs.map(log => {
            const time = formatTimestamp(log.timestamp);
            const action = escapeHTML(log.action || "UNKNOWN");
            const actorAvatar = window.kpiAvatarMarkup({
                user_id: log.actor_id,
                display_name: log.admin_name || "System Auto",
                avatar_url: log.avatar_url,
                initials: log.initials,
                avatar_color_index: log.avatar_color_index
            }, 32);
            return `<tr class="audit-table-row"><td class="whitespace-nowrap px-6 py-4"><div class="text-sm font-bold text-slate-700">${escapeHTML(time.date)}</div><div class="mt-1 text-xs text-slate-400">${escapeHTML(time.relative)}</div></td><td class="px-6 py-4"><div class="flex items-center gap-2">${actorAvatar}<div><div class="font-semibold text-slate-800">${escapeHTML(log.admin_name || "System Auto")}</div><div class="mt-1 text-xs text-slate-400">Actor</div></div></div></td><td class="px-6 py-4"><span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wide ring-1 ring-inset ${actionClass(log.action)}">${action}</span></td><td class="px-6 py-4"><div class="font-mono text-xs font-bold text-slate-700">${escapeHTML(log.table_name || "—")}</div><div class="mt-1 text-xs text-slate-400">${log.record_id ? `Record ${escapeHTML(log.record_id)}` : "No record reference"}</div></td><td class="px-6 py-4">${renderChanges(log.old_value, log.new_value)}</td><td class="whitespace-nowrap px-6 py-4 text-right font-mono text-xs text-slate-500">${escapeHTML(log.ip_address || "Unknown")}</td></tr>`;
        }).join("");
    }

    function populateActionFilter() {
        const select = document.getElementById("actionFilter");
        const selected = select.value;
        allLogs.map(log => log.action).filter(Boolean).forEach(action => seenActions.add(action));
        select.innerHTML = `<option value="">All actions</option>${[...seenActions].sort().map(action => `<option value="${escapeHTML(action)}">${escapeHTML(action)}</option>`).join("")}`;
        select.value = selected;
    }

    async function fetchAuditLogs() {
        const tbody = document.getElementById("logsTableBody");
        const button = document.getElementById("refreshLogsButton");
        button.disabled = true;
        document.getElementById("refreshIcon").classList.add("animate-spin");
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-16 text-center text-sm text-slate-500">Loading audit logs...</td></tr>';
        try {
            const params = new URLSearchParams({
                limit: String(pageSize + 1),
                offset: String(currentPage * pageSize),
            });
            const search = document.getElementById("searchInput").value.trim();
            const action = document.getElementById("actionFilter").value;
            if (search) params.set("search", search);
            if (action) params.set("action", action);
            const response = await fetch(`/api/v1/kpi/audit-logs?${params}`);
            if (!response.ok) throw new Error(`Audit log request failed with status ${response.status}`);
            const pageResults = await response.json();
            hasNextPage = pageResults.length > pageSize;
            allLogs = pageResults.slice(0, pageSize);
            populateActionFilter();
            renderLogs(allLogs);
            document.getElementById("logsStatus").className = "border-b border-emerald-100 bg-emerald-50 px-4 py-2.5 text-xs font-semibold text-emerald-700 sm:px-6";
            document.getElementById("logsStatus").textContent = `Loaded page ${currentPage + 1} with ${allLogs.length} audit record${allLogs.length === 1 ? "" : "s"}.`;
        } catch (error) {
            hasNextPage = false;
            document.getElementById("previousPageButton").disabled = currentPage === 0;
            document.getElementById("nextPageButton").disabled = true;
            document.getElementById("totalCount").textContent = "—";
            document.getElementById("visibleCount").textContent = "—";
            document.getElementById("latestActivity").textContent = "Unavailable";
            document.getElementById("logsStatus").className = "border-b border-red-100 bg-red-50 px-4 py-2.5 text-xs font-semibold text-red-700 sm:px-6";
            document.getElementById("logsStatus").textContent = "Unable to load audit records. Please try again.";
            tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-16 text-center"><p class="text-sm font-bold text-red-700">Audit logs are unavailable</p><p class="mt-1 text-xs text-slate-500">Your session may have expired or you may not have permission to view this page.</p></td></tr>';
            console.error(error);
        } finally {
            button.disabled = false;
            document.getElementById("refreshIcon").classList.remove("animate-spin");
        }
    }

    function changeAuditPage(direction) {
        const nextPage = currentPage + direction;
        if (nextPage < 0 || (direction > 0 && !hasNextPage)) return;
        currentPage = nextPage;
        fetchAuditLogs();
    }

    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("searchInput").addEventListener("input", () => {
            window.clearTimeout(searchDebounce);
            searchDebounce = window.setTimeout(() => {
                currentPage = 0;
                fetchAuditLogs();
            }, 250);
        });
        document.getElementById("actionFilter").addEventListener("change", () => {
            currentPage = 0;
            fetchAuditLogs();
        });
        fetchAuditLogs();
    });
</script>
{% endblock %}
