{% extends "layouts/base.njk" %}
{% set active_page = "department_kpi" %}

{% block title %}Department KPI - KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/avatar.css">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>

<div class="kd-page exec-dashboard">
  <div class="kd-container">
    <header class="kd-hero exec-header">
      <div>
        <p class="kd-eyebrow">Dashboard</p>
        <h1 class="kd-title">Department KPI</h1>
        <p class="kd-subtitle">Ranked employee KPI results for one department, highest score first.</p>
      </div>
    </header>

    <section class="kd-card kd-analysis-card exec-card exec-panel" aria-labelledby="deptKpiHeading">
      <div class="kd-card-heading exec-section-heading">
        <div>
          <p class="kd-eyebrow">Department ranking</p>
          <h2 id="deptKpiHeading" class="kd-card-title">Department KPI ranking</h2>
          <p class="kd-caption">Pick a department and a period. Results are ordered from the highest score to the lowest.</p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 mb-5">
        <label class="flex-1">
          <span class="block text-xs font-bold text-slate-500 mb-1">Department</span>
          <select id="deptKpiDepartment" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800">
            <option value="">Loading departments…</option>
          </select>
        </label>
        <label class="flex-1">
          <span class="block text-xs font-bold text-slate-500 mb-1">Period</span>
          <select id="deptKpiPeriod" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800" disabled>
            <option value="">Loading periods…</option>
          </select>
        </label>
      </div>

      <p id="deptKpiSelectorError" class="hidden text-sm font-bold text-red-600 mb-4" role="alert"></p>

      <div id="deptKpiEmpty" class="py-10 text-center text-slate-500 font-medium">
        Select a department to view its ranked KPI results.
      </div>

      <div id="deptKpiError" class="hidden py-10 text-center" role="alert">
        <p class="font-bold text-red-600">Failed to load results.</p>
        <button id="deptKpiRetry" type="button" class="mt-3 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50">Retry</button>
      </div>

      <div id="deptKpiTableWrap" class="hidden overflow-x-auto custom-scrollbar w-full">
        <table class="w-full text-left border-collapse min-w-[720px]">
          <thead class="bg-slate-50/80 text-slate-500 text-[10px] sm:text-[11px] uppercase tracking-widest">
            <tr>
              <th class="p-4 font-black border-b border-slate-200/60">Rank</th>
              <th class="p-4 font-black border-b border-slate-200/60">Employee</th>
              <th class="p-4 font-black border-b border-slate-200/60">Department</th>
              <th class="p-4 font-black border-b border-slate-200/60">Position</th>
              <th class="p-4 font-black border-b border-slate-200/60">Score</th>
              <th class="p-4 font-black border-b border-slate-200/60">Grade</th>
            </tr>
          </thead>
          <tbody id="deptKpiBody"></tbody>
        </table>
      </div>

      <div id="deptKpiFooter" class="hidden mt-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p id="deptKpiCount" class="text-xs font-semibold text-slate-500"></p>
        <button id="deptKpiMore" type="button" class="rounded-xl bg-slate-900 px-4 py-2.5 text-xs font-bold text-white hover:bg-slate-700">View more</button>
      </div>
    </section>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/department-kpi.js" defer></script>
{% endblock %}
