{% extends "layouts/base.njk" %}
{% set active_page = "kpis" %}

{% block title %}Enterprise KPI Engine - KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/dialog.css">
<link rel="stylesheet" href="/static/css/avatar.css">
<link rel="stylesheet" href="/static/css/superadmin-kpi-glass.css?v=20261021-2">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<style>
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
    .modal-transition { transition: opacity 0.3s ease, transform 0.3s ease; }
</style>

<div class="workspace-page kpi-management-page kg-page">
  <div class="kg-container">
    
    <!-- HEADER -->
    <header class="workspace-header kg-header">
        <div class="flex items-center gap-3 sm:gap-4 kg-header-copy">
            <div class="bg-white p-2.5 sm:p-3.5 rounded-2xl shadow-sm ring-1 ring-slate-900/5 text-blue-700 shrink-0 kg-icon-tile">
                <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2-2v6a2 2 0 002 2h2a2 2 0 002-2m0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight kg-page-title">KPI Management</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium kg-page-subtitle">Manage formulas, dynamic workflows, and role configurations.</p>
            </div>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto">
            <button id="createFormulaButton" type="button" class="w-full md:w-auto justify-center bg-blue-700 hover:bg-blue-800 text-white px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl text-sm font-bold flex items-center shadow-md transition-all duration-300 transform hover:-translate-y-0.5 active:scale-95 kg-button kg-button-primary">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Create Formula
            </button>
        </div>
    </header>

    <!-- TABS -->
    <div class="workspace-tabs mb-6 sm:mb-8 kg-tabbar" role="tablist" aria-label="KPI management sections">
        <button id="btn-formulas-tab" type="button" role="tab" aria-selected="true" aria-controls="formulas-tab" class="whitespace-nowrap pb-3 text-xs sm:text-sm font-bold text-blue-900 border-b-2 border-blue-700 transition-all duration-300 kg-tab">Formula Workflow</button>
        <button id="btn-records-tab" type="button" role="tab" aria-selected="false" aria-controls="records-tab" class="whitespace-nowrap pb-3 text-xs sm:text-sm font-semibold text-slate-500 hover:text-blue-900 border-b-2 border-transparent transition-all duration-300 kg-tab">Employee KPI Records · Manage</button>
        <button id="btn-settings-tab" type="button" role="tab" aria-selected="false" aria-controls="settings-tab" class="whitespace-nowrap pb-3 text-xs sm:text-sm font-semibold text-slate-500 hover:text-blue-900 border-b-2 border-transparent transition-all duration-300 kg-tab">Role Tracking</button>
        <button id="btn-assignments-tab" type="button" role="tab" aria-selected="false" aria-controls="assignments-tab" class="whitespace-nowrap pb-3 text-xs sm:text-sm font-semibold text-slate-500 hover:text-blue-900 border-b-2 border-transparent transition-all duration-300 kg-tab">Assignments</button>
    </div>

    <!-- MAIN CONTENT AREA -->
    <div class="w-full">
        
        <!-- TAB 1: FORMULAS -->
        <div id="formulas-tab" role="tabpanel" aria-labelledby="btn-formulas-tab" class="tab-content animate-fade-in-up kg-panel">
            <div id="formulaCardsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 kg-formula-grid">
                <div class="col-span-full py-16 text-center text-slate-500">
                    <svg class="animate-spin h-8 w-8 text-blue-600 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Loading formula cards...
                </div>
            </div>
        </div>

        <!-- TAB 2: EMPLOYEE RECORDS -->
        <div id="records-tab" role="tabpanel" aria-labelledby="btn-records-tab" class="tab-content hidden animate-fade-in-up kg-panel" hidden>
            <div class="bg-white rounded-3xl shadow-sm ring-1 ring-slate-900/5 overflow-hidden kg-card">
                <div class="p-4 sm:p-6 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white gap-3 sm:gap-0 kg-records-header">
                    <h3 class="font-extrabold text-slate-900 text-base sm:text-lg">Employee KPI Records · Manage (Current Cycle)</h3>
                    <button onclick="loadEmployeeRecords()" class="w-full sm:w-auto text-xs text-blue-700 bg-blue-50 border border-blue-200 px-4 py-2 rounded-xl hover:bg-blue-100 font-bold transition shadow-sm flex items-center justify-center kg-button">
                        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg> 
                        Refresh Data
                    </button>
                </div>
                <div class="overflow-x-auto custom-scrollbar w-full kg-table-wrap">
                    <table class="w-full text-left border-collapse min-w-[700px] kg-table">
                        <thead class="bg-slate-50/80 backdrop-blur-sm text-slate-500 text-[10px] sm:text-[11px] uppercase tracking-widest">
                            <tr>
                                <th class="p-4 sm:p-5 font-black border-b border-slate-200/60">Employee</th>
                                <th class="p-4 sm:p-5 font-black border-b border-slate-200/60">Department</th>
                                <th class="p-4 sm:p-5 font-black border-b border-slate-200/60 text-center">Score / 5.0</th>
                                <th class="p-4 sm:p-5 font-black border-b border-slate-200/60">Grade</th>
                                <th class="p-4 sm:p-5 font-black border-b border-slate-200/60 text-center">Status</th>
                                <th class="p-4 sm:p-5 font-black text-right border-b border-slate-200/60">Admin Actions</th>
                            </tr>
                        </thead>
                        <tbody id="recordsTableBody" class="divide-y divide-slate-100/60 text-xs sm:text-sm bg-white">
                            <tr><td colspan="6" class="p-10 sm:p-16 text-center text-slate-500 font-medium">Loading records...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: ROLE TRACKING & ASSIGNMENTS -->
        <div id="settings-tab" role="tabpanel" aria-labelledby="btn-settings-tab" class="tab-content hidden animate-fade-in-up kg-panel" hidden>
            <div class="bg-white rounded-3xl p-5 sm:p-8 shadow-sm ring-1 ring-slate-900/5 max-w-4xl mx-auto kg-card">
                <div class="flex items-start gap-3 sm:gap-4 border-b border-slate-100 pb-4 sm:pb-5 mb-4 sm:mb-6 kg-card-heading">
                    <div class="bg-indigo-50 p-2 sm:p-3 rounded-2xl text-indigo-600 shadow-inner shrink-0 kg-card-icon">
                        <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-1">Role Tracking Controls</h3>
                        <p class="text-xs sm:text-sm text-slate-500 font-medium">Enable or disable KPI generation for specific role levels per department.</p>
                    </div>
                </div>
                
                <div class="overflow-x-auto custom-scrollbar border border-slate-200 rounded-2xl shadow-sm w-full kg-table-wrap">
                    <table class="w-full text-left min-w-[500px] kg-table">
                        <thead class="bg-slate-50 text-[9px] sm:text-[10px] uppercase tracking-widest text-slate-500 font-black border-b border-slate-200">
                            <tr>
                                <th class="p-3 sm:p-5">Department</th>
                                <th class="p-3 sm:p-5 text-center">L0 (Head)</th>
                                <th class="p-3 sm:p-5 text-center">L1 (Sup)</th>
                                <th class="p-3 sm:p-5 text-center">L2 (Staff)</th>
                                <th class="p-3 sm:p-5 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="deptSettingsTableBody" class="divide-y divide-slate-100 text-xs sm:text-sm">
                            <tr><td colspan="5" class="p-8 sm:p-10 text-center text-slate-400">Loading controls...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="assignments-tab" role="tabpanel" aria-labelledby="btn-assignments-tab" class="tab-content hidden animate-fade-in-up kg-panel" hidden>
            <div class="bg-white rounded-3xl p-5 sm:p-8 shadow-sm ring-1 ring-slate-900/5 max-w-4xl mx-auto kg-card">
                <div class="border-b border-slate-100 pb-4 mb-6 kg-card-heading">
                    <div class="kg-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
                    <div><h3 class="text-lg sm:text-xl font-extrabold text-slate-900">Assign Tasks to Employees</h3>
                    <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Assign a task in an employee's approved KPI category.</p>
                    </div>
                </div>
                <form id="assignmentForm" class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 kg-assignment-grid">
                    <label class="text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Department</span>
                        <select id="assignmentDepartment" required class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                            <option value="">-- Select Department --</option>
                        </select>
                    </label>
                    <label class="text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Position</span>
                        <select id="assignmentPosition" required class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                            <option value="">-- Select Position --</option>
                        </select>
                    </label>
                    
                    <label class="md:col-span-2 text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Employees</span>
                        <select id="assignmentUsers" required multiple size="7" class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                            <option value="">Select a department and position first</option>
                        </select>
                        <span id="assignmentUserAvatars" class="flex flex-wrap items-center gap-2 mt-2" aria-live="polite"></span>
                    </label>

                    <label class="md:col-span-2 text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Task Title</span>
                        <input type="text" id="assignmentTitle" maxlength="255" required class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                    </label>

                    <label class="text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Category</span>
                        <select id="assignmentCategory" required class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                            <option value="">-- Select Employee First --</option>
                        </select>
                    </label>

                    <label class="text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Due Date</span>
                        <input type="datetime-local" id="assignmentDueDate" required class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                    </label>
                    <label class="text-xs font-bold text-slate-700 kg-assignment-field"><span class="kg-assignment-label">Allowed Late Days (Grace Period)</span>
                        <input type="number" id="assignmentGracePeriod" min="0" value="2" required class="mt-2 w-full bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm focus:bg-white focus:border-blue-600 focus:outline-none">
                    </label>

                    <div class="md:col-span-2 flex justify-end kg-assignment-footer">
                        <button type="submit" id="assignmentSubmit" class="bg-blue-700 hover:bg-blue-800 text-white px-6 py-3 rounded-xl text-sm font-bold shadow-md transition-all kg-button kg-button-primary">Assign Task</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
  </div>
</div>

<!-- FORMULA CREATION/EDIT MODAL -->
<div id="formulasModal" data-kpi-modal class="hidden fixed inset-0 z-[70] flex items-center justify-center app-modal-backdrop transition-opacity opacity-0 modal-transition p-2 sm:p-4 kg-modal kg-modal-formula" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden text-slate-800 transform scale-95 transition-transform duration-300 kg-modal-panel" id="formulasModalContent">
        
        <div class="bg-slate-50 px-5 sm:px-8 py-4 sm:py-6 border-b border-gray-100 flex justify-between items-center shrink-0 kg-modal-header">
            <div>
                <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900" id="modalTitle">Enterprise Formula Builder</h3>
                <p class="text-[10px] sm:text-sm text-slate-500 mt-1 font-medium hidden sm:block">Configure targeting, categories, and natural language deduction rules.</p>
            </div>
            <button onclick="closeFormulasModal()" class="text-slate-400 hover:text-red-500 transition-colors bg-white rounded-full p-2 sm:p-2.5 shadow-sm border border-gray-200 focus:outline-none shrink-0 kg-icon-button" aria-label="Close formula builder" title="Close formula builder"><svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
        </div>

        <div class="p-4 sm:p-8 overflow-y-auto custom-scrollbar flex-1 bg-slate-50/50 kg-modal-body">
            <input type="hidden" id="fId">
            
            <!-- SECTION 1: TARGETING & METADATA -->
            <div class="bg-white p-5 sm:p-7 rounded-3xl border border-slate-200 shadow-sm mb-6 sm:mb-8 kg-section kg-target-section">
                <h4 class="text-xs sm:text-sm font-extrabold text-slate-900 border-b border-slate-100 pb-3 sm:pb-4 mb-4 sm:mb-6 uppercase tracking-wider flex items-center gap-2 sm:gap-3 kg-section-heading">
                    <span class="bg-blue-100 text-blue-800 w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center text-[10px] sm:text-xs kg-section-number">1</span>
                    General Information & Targeting
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 kg-target-grid">
                    <div class="md:col-span-2 kg-field kg-field-name">
                        <label for="fName" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide kg-field-label">Formula Name <span class="text-red-500">*</span></label>
                        <input type="text" id="fName" placeholder="e.g., Q3 Finance Operations KPI" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner kg-control">
                    </div>
                    <div class="kg-field kg-field-month">
                        <label for="fEffectiveMonth" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide kg-field-label">Effective Month</label>
                        <input type="month" id="fEffectiveMonth" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner kg-control">
                    </div>
                    
                    <div class="kg-field kg-field-region">
                        <label for="fRegionTown" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide kg-field-label">Region / Town</label>
                        <input type="text" id="fRegionTown" placeholder="e.g., YGN Office" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner kg-control">
                    </div>
                    
                    <div class="kg-field kg-field-department">
                        <label for="fDepartment" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide kg-field-label">Department <span class="text-red-500">*</span></label>
                        <select id="fDepartment" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner cursor-pointer kg-control kg-select">
                            <option value="">-- Select Department --</option>
                        </select>
                    </div>
                    <div class="kg-field kg-field-position">
                        <label for="fPosition" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide kg-field-label">Position <span class="text-red-500">*</span></label>
                        <select id="fPosition" class="w-full bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner cursor-pointer kg-control kg-select">
                            <option value="">-- Select Position --</option>
                        </select>
                    </div>
                    
                    <div class="kg-field kg-field-level">
                        <label for="fLevel" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide kg-field-label">User Level <span class="text-red-500">*</span></label>
                        <select id="fLevel" class="w-full bg-slate-50 hover:bg-white border border-slate-200 p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm font-semibold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner cursor-pointer kg-control kg-select">
                            <option value="">-- Select Role Level --</option>
                            <option value="L0">L0 (Head)</option>
                            <option value="L1">L1 (Supervisor)</option>
                            <option value="L2">L2 (Staff)</option>
                        </select>
                    </div>
                    <div class="md:col-span-2 flex items-center justify-start mt-2 sm:mt-6 kg-checkbox-field">
                        <label class="flex items-center gap-2 sm:gap-3 cursor-pointer group p-3 sm:p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-blue-300 transition-colors w-full md:w-auto shadow-sm kg-checkbox-row">
                            <input type="checkbox" id="fIsActive" checked class="w-4 h-4 sm:w-5 sm:h-5 accent-blue-700 rounded border-slate-300 cursor-pointer">
                            <span class="text-xs sm:text-sm font-bold text-slate-700 group-hover:text-blue-900 transition-colors">Set as Active Formula upon approval</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- SECTION: APPLIES TO PERIODS -->
            <div class="bg-white p-5 sm:p-7 rounded-3xl border border-slate-200 shadow-sm mb-6 sm:mb-8 kg-section kg-periods-section">
                <h4 class="text-xs sm:text-sm font-extrabold text-slate-900 border-b border-slate-100 pb-3 sm:pb-4 mb-4 sm:mb-6 uppercase tracking-wider flex items-center gap-2 sm:gap-3 kg-section-heading">
                    <span class="bg-blue-100 text-blue-800 w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center text-[10px] sm:text-xs kg-section-number">2</span>
                    Applies to Periods
                </h4>
                <p id="fPeriodsHint" class="text-[11px] sm:text-sm text-slate-600 mb-4 sm:mb-5 font-medium leading-relaxed">Choose the periods this formula applies to. If none are chosen, the formula follows the Effective Month rule (older behaviour).</p>
                <div id="fPeriodsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">Loading periods…</p>
                </div>
            </div>

            <!-- SECTION 3: CATEGORIES & RULES BUILDER -->
            <div class="bg-white p-5 sm:p-7 rounded-3xl border border-slate-200 shadow-sm kg-section">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-b border-slate-100 pb-4 mb-4 sm:mb-6 gap-3 sm:gap-4 kg-section-two-heading">
                    <h4 class="text-xs sm:text-sm font-extrabold text-slate-900 uppercase tracking-wider flex items-center gap-2 sm:gap-3 kg-section-heading">
                        <span class="bg-blue-100 text-blue-800 w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center text-[10px] sm:text-xs kg-section-number">3</span>
                        Categories & Deduction Rules
                    </h4>
                    <div id="weightTotalIndicator" class="w-full md:w-auto text-xs sm:text-sm font-bold bg-slate-100 text-slate-500 px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl border border-slate-200 shadow-inner flex items-center justify-center md:justify-start gap-2 transition-colors kg-weight-chip">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>
                        Total Weight: <span id="weightText">0%</span>
                    </div>
                </div>
                <div class="text-[11px] sm:text-sm text-slate-600 mb-6 sm:mb-8 bg-blue-50/50 p-4 sm:p-5 rounded-2xl border border-blue-100 leading-relaxed font-medium kg-instruction">
                    <svg class="kg-note-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
                    <div>
                    Create categories (e.g., Attendance, Performance). Each category starts with a perfect <strong>5.0 score</strong>. Build intuitive rules to define how points are deducted based on employee metrics.<br/>
                    <strong class="text-red-600 mt-2 block kg-note">Note: You MUST include at least one category related to 'အချိန်မှီမတင်ပြခြင်း (Late Submission)' and it must be at least 1% of the total weight.</strong>
                    </div>
                </div>
                
                <div id="categoriesContainer" class="space-y-4 sm:space-y-6 kg-category-list"></div>
                
                <div class="mt-6 sm:mt-8 flex justify-center border-t border-dashed border-slate-200 pt-6 sm:pt-8">
                    <button type="button" onclick="addCategory()" class="w-full sm:w-auto bg-white hover:bg-blue-50 text-blue-700 border border-blue-200 hover:border-blue-400 font-bold px-6 sm:px-8 py-3 sm:py-3.5 rounded-xl text-xs sm:text-sm shadow-sm transition-all flex items-center justify-center gap-2 transform hover:-translate-y-0.5 active:scale-95 kg-add-category">
                        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                        Add New Category
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-slate-50 px-5 sm:px-8 py-4 sm:py-5 border-t border-slate-200 flex flex-col-reverse sm:flex-row justify-end gap-3 sm:gap-4 shrink-0 kg-modal-footer">
            <button onclick="closeFormulasModal()" class="w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold text-slate-600 hover:text-slate-900 bg-white border border-slate-300 rounded-xl shadow-sm transition-colors kg-button">Cancel</button>
            <button id="saveFormulaBtn" onclick="saveFormula()" class="w-full sm:w-auto bg-blue-700 hover:bg-blue-800 text-white px-8 sm:px-10 py-3 rounded-xl text-xs sm:text-sm font-bold shadow-md transition-all transform hover:-translate-y-0.5 active:scale-95 flex justify-center kg-button kg-button-primary">Save Formula</button>
        </div>
    </div>
</div>

<!-- INTERVENTION MODAL -->
<div id="interventionModal" data-kpi-modal class="hidden fixed inset-0 z-[80] flex items-center justify-center app-modal-backdrop transition-opacity opacity-0 modal-transition p-4 kg-modal kg-modal-intervention" role="dialog" aria-modal="true" aria-labelledby="interventionTitle">
    <div class="bg-white rounded-3xl p-6 sm:p-8 w-full max-w-md shadow-2xl border border-slate-200 transform scale-95 transition-transform duration-300 kg-modal-panel" id="interventionModalContent">
        <button type="button" onclick="closeInterventionModal()" aria-label="Close" class="float-right text-slate-400 hover:text-red-500 text-2xl leading-none">×</button>
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-2" id="interventionTitle">Adjust Score</h3>
        <p class="text-xs sm:text-sm text-slate-500 mb-5 sm:mb-6 pb-4 border-b border-slate-100 leading-relaxed font-medium" id="intervDesc">Modify employee KPI record.</p>
        
        <input type="hidden" id="intervRecordId">
        <input type="hidden" id="intervType">
        
        <div class="mb-4 sm:mb-5">
            <label class="block text-[11px] sm:text-xs font-black text-slate-700 mb-2 uppercase tracking-wide" id="intervLabel" for="intervValue">Value</label>
            <input type="number" step="0.1" id="intervValue" class="w-full bg-slate-50 border border-slate-200 p-3 sm:p-3.5 rounded-xl text-sm font-bold focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner placeholder-slate-400">
        </div>
        <div class="mb-6 sm:mb-8">
            <label class="block text-[11px] sm:text-xs font-black text-slate-700 mb-2 uppercase tracking-wide" for="intervReason">Reason for Audit Log <span class="text-red-500">*</span></label>
            <textarea id="intervReason" rows="3" class="w-full bg-slate-50 border border-slate-200 p-3 sm:p-3.5 rounded-xl text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 focus:outline-none transition-all shadow-inner placeholder-slate-400" placeholder="Please provide detailed reason for this manual adjustment..."></textarea>
        </div>
        
        <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-2">
            <button onclick="closeInterventionModal()" class="w-full sm:w-auto px-6 py-2.5 text-xs sm:text-sm font-bold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl shadow-sm transition-colors">Cancel</button>
            <button onclick="submitIntervention()" class="w-full sm:w-auto bg-blue-700 hover:bg-blue-800 text-white px-8 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-md transition-all active:scale-95 flex justify-center">Confirm Action</button>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
<script src="/static/js/dialog.js"></script>
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<script src="/static/js/superadmin-kpi.js" defer></script>
{% endblock %}