{% extends "layouts/base.njk" %}
{% set active_page = "reports" %}

{% block title %}KPI Reports - Enterprise KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/avatar.css">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out forwards;
    }
</style>

<!-- 🌟 RESPONSIVE FIX: Adjusted padding for mobile -->
<div class="workspace-page">
    
    <!-- HEADER -->
    <header class="workspace-header">
        <div class="flex items-center gap-3 sm:gap-4">
            <div class="bg-white p-2.5 sm:p-3 rounded-xl border border-gray-200 shadow-sm text-blue-950 shrink-0">
                <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            </div>
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-blue-950 tracking-tight">Enterprise Reports</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Generate, analyze, and export comprehensive KPI performance summaries.</p>
            </div>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto mt-2 md:mt-0">
            <button onclick="exportToCSV()" id="exportBtn" disabled class="w-full md:w-auto justify-center bg-white text-gray-400 border border-gray-200 px-5 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold flex items-center shadow-sm transition-all duration-300">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Export CSV
            </button>
        </div>
    </header>

    <!-- FILTER SECTION -->
    <div class="workspace-toolbar mb-6 animate-fade-in-up csp-delay-1">
        <h3 class="app-section-title mb-2">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
            Report Configuration
        </h3>
        
        <form id="reportFilterForm" class="flex flex-col lg:flex-row gap-4 sm:gap-5 items-end">
            <div class="w-full lg:w-1/3">
                <label for="periodType" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase">Evaluation Period <span class="text-red-500">*</span></label>
                <select id="periodType" required class="w-full bg-slate-50 border border-gray-200 p-2.5 sm:p-3 rounded-xl text-xs sm:text-sm font-semibold focus:bg-white focus:ring-2 focus:ring-blue-100 focus:border-blue-900 focus:outline-none transition-all cursor-pointer">
                    <option value="MONTHLY" selected>Monthly Summary</option>
                    <option value="WEEKLY">Weekly Summary</option>
                    <option value="DAILY">Daily Summary</option>
                </select>
            </div>
            
            <div class="w-full lg:w-1/3">
                <label for="departmentFilter" class="block text-[10px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase">Department Filter</label>
                <select id="departmentFilter" class="w-full bg-slate-50 border border-gray-200 p-2.5 sm:p-3 rounded-xl text-xs sm:text-sm font-semibold focus:bg-white focus:ring-2 focus:ring-blue-100 focus:border-blue-900 focus:outline-none transition-all cursor-pointer">
                    <option value="">All Departments (Company Wide)</option>
                    <!-- Injected dynamically -->
                </select>
            </div>
            
            <div class="w-full lg:w-auto mt-2 lg:mt-0">
                <button type="submit" id="generateBtn" class="w-full bg-blue-950 hover:bg-blue-900 text-white px-6 sm:px-8 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold shadow-md transition-all transform hover:-translate-y-0.5 flex items-center justify-center">
                    Generate Report
                </button>
            </div>
        </form>
    </div>

    <!-- SUMMARY CARDS -->
    <div id="summaryCards" class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-6 sm:mb-8 hidden animate-fade-in-up">
        <div class="bg-white p-5 sm:p-6 rounded-3xl border border-gray-200 shadow-sm flex items-center gap-4 sm:gap-5">
            <div class="bg-blue-50 p-3 sm:p-4 rounded-2xl text-blue-700 shrink-0">
                <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
            </div>
            <div>
                <p class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Total Evaluated Employees</p>
                <h4 id="summaryEmployees" class="text-2xl sm:text-3xl font-extrabold text-blue-950 mt-1">0</h4>
            </div>
        </div>
        
        <div class="bg-white p-5 sm:p-6 rounded-3xl border border-gray-200 shadow-sm flex items-center gap-4 sm:gap-5">
            <div class="bg-emerald-50 p-3 sm:p-4 rounded-2xl text-emerald-600 shrink-0">
                <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <div>
                <p class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Average Company Score</p>
                <h4 id="summaryScore" class="text-2xl sm:text-3xl font-extrabold text-blue-950 mt-1">0.0 <span class="text-xs sm:text-sm text-slate-400 font-medium">/ 5.0</span></h4>
            </div>
        </div>
    </div>

    <!-- DATA TABLE -->
    <div class="workspace-table relative min-h-[300px]">
        <div id="tableLoader" class="hidden absolute inset-0 bg-white/80 backdrop-blur-sm z-10 flex flex-col items-center justify-center">
            <svg class="animate-spin h-8 w-8 sm:h-10 sm:w-10 text-blue-900 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-xs sm:text-sm font-bold text-blue-900">Compiling Report...</p>
        </div>

        <div class="overflow-x-auto custom-scrollbar w-full">
            <table class="w-full text-left border-collapse min-w-[700px]" id="reportTable">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-[10px] sm:text-xs uppercase tracking-wider border-b border-gray-200">
                        <th class="p-4 sm:p-5 font-bold">Employee Name</th>
                        <th class="p-4 sm:p-5 font-bold">Department</th>
                        <th class="p-4 sm:p-5 font-bold text-center">Evaluated Tasks</th>
                        <th class="p-4 sm:p-5 font-bold text-center">Score / 5.0</th>
                        <th class="p-4 sm:p-5 font-bold">Grade</th>
                    </tr>
                </thead>
                <tbody id="reportTableBody" class="divide-y divide-gray-100 text-xs sm:text-sm">
                    <tr><td colspan="5" class="p-10 sm:p-12 text-center text-slate-400 font-medium">Please configure filters and click "Generate Report"</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<script>
    const API_REPORTS = "/api/v1/kpi/reports/summary";
    const API_DEPARTMENTS = "/api/v1/departments/?is_active=true";
    let reportData = []; 

    function escapeHTML(str) {
        if (!str) return "";
        return str.toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    document.addEventListener("DOMContentLoaded", () => {
        loadDepartments();
    });

    async function loadDepartments() {
        try {
            const res = await fetch(API_DEPARTMENTS);
            // 🛡️ AUTH FIX
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            if (!res.ok) return;
            
            const depts = await res.json();
            const select = document.getElementById("departmentFilter");
            depts.forEach(d => {
                const opt = document.createElement("option");
                opt.value = d.id;
                opt.textContent = d.name; 
                select.appendChild(opt);
            });
        } catch(err) { console.error("Failed to load departments", err); }
    }

    document.getElementById("reportFilterForm").addEventListener("submit", async function(e) {
        e.preventDefault();
        
        const periodType = document.getElementById("periodType").value;
        const deptId = document.getElementById("departmentFilter").value;
        
        let url = `${API_REPORTS}?period_type=${periodType}`;
        if (deptId) url += `&department_id=${deptId}`;

        const btn = document.getElementById("generateBtn");
        const loader = document.getElementById("tableLoader");
        const tbody = document.getElementById("reportTableBody");
        const exportBtn = document.getElementById("exportBtn");

        btn.disabled = true;
        loader.classList.remove("hidden");
        exportBtn.disabled = true;
        exportBtn.className = "w-full md:w-auto justify-center bg-white text-gray-400 border border-gray-200 px-5 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold flex items-center shadow-sm transition-all duration-300";

        try {
            const response = await fetch(url);
            // 🛡️ AUTH FIX
            if (response.status === 401 || response.status === 403) { window.location.href = '/auth/login'; return; }
            
            const result = await response.json();

            if (response.ok) {
                reportData = result.data || [];
                renderReport(result);
                
                if(reportData.length > 0) {
                    exportBtn.disabled = false;
                    exportBtn.className = "w-full md:w-auto justify-center bg-white text-blue-700 hover:text-blue-900 border border-blue-200 hover:bg-blue-50 px-5 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold flex items-center shadow-sm transition-all duration-300";
                }
            } else {
                tbody.innerHTML = `<tr><td colspan="5" class="p-10 sm:p-12 text-center text-red-500 font-bold">${escapeHTML(result.detail) || "Failed to load report"}</td></tr>`;
                document.getElementById("summaryCards").classList.add("hidden");
            }
        } catch (error) {
            console.error(error);
            tbody.innerHTML = `<tr><td colspan="5" class="p-10 sm:p-12 text-center text-red-500 font-bold">A network error occurred.</td></tr>`;
            document.getElementById("summaryCards").classList.add("hidden");
        } finally {
            btn.disabled = false;
            loader.classList.add("hidden");
        }
    });

    function renderReport(result) {
        document.getElementById("summaryCards").classList.remove("hidden");
        document.getElementById("summaryEmployees").innerText = result.total_employees_evaluated || 0;
        document.getElementById("summaryScore").innerHTML = `${(result.average_company_score || 0).toFixed(2)} <span class="text-xs sm:text-sm text-slate-400 font-medium">/ 5.0</span>`;

        const tbody = document.getElementById("reportTableBody");
        tbody.innerHTML = "";

        if (reportData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="p-10 sm:p-12 text-center text-slate-500 font-medium">No KPI records found for the selected configuration.</td></tr>`;
            return;
        }

        reportData.forEach((row, index) => {
            let badgeClass = row.grade === 'EXCELLENT' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 
                            (row.grade === 'POOR' ? 'bg-red-50 text-red-700 border-red-200' : 'bg-blue-50 text-blue-700 border-blue-200');

            tbody.innerHTML += `
                <tr class="hover:bg-slate-50/80 transition-colors animate-fade-in-up">
                    <td class="p-4 sm:p-5 font-bold text-blue-950"><span class="inline-flex items-center gap-3">${window.kpiAvatarMarkup(row, 32)}<span>${escapeHTML(row.full_name)}</span></span></td>
                    <td class="p-4 sm:p-5 text-[11px] sm:text-xs font-semibold text-slate-500">${escapeHTML(row.department_name || 'N/A')}</td>
                    <td class="p-4 sm:p-5 text-center font-semibold text-slate-600">${row.evaluated_tasks_count}</td>
                    <td class="p-4 sm:p-5 text-center font-extrabold text-blue-900">${row.total_score.toFixed(2)}</td>
                    <td class="p-4 sm:p-5"><span class="px-2.5 sm:px-3 py-1 rounded-md text-[9px] sm:text-[10px] uppercase font-bold border shadow-sm ${badgeClass}">${escapeHTML(row.grade)}</span></td>
                </tr>
            `;
        });
    }

    function exportToCSV() {
        if (!reportData || reportData.length === 0) return;

        const periodType = document.getElementById("periodType").value;
        const dateString = new Date().toISOString().split('T')[0];
        let csvContent = "data:text/csv;charset=utf-8,";
        
        csvContent += "Employee Name,Department,Evaluated Tasks,Total Score,Grade,Period Type\n";

        // 🛡️ CSV Injection Protection
        const sanitizeCSV = (str) => {
            if (!str) return '""';
            let s = str.toString().replaceAll('"', '""');
            if (s.match(/^[=\+\-@]/)) s = "'" + s;
            return `"${s}"`;
        };

        reportData.forEach(row => {
            const rowString = [
                sanitizeCSV(row.full_name),
                sanitizeCSV(row.department_name || 'N/A'),
                sanitizeCSV(row.evaluated_tasks_count),
                sanitizeCSV(row.total_score.toFixed(2)),
                sanitizeCSV(row.grade),
                sanitizeCSV(row.period_type)
            ].join(",");
            csvContent += rowString + "\n";
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `KPI_Report_${periodType}_${dateString}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>
{% endblock %}