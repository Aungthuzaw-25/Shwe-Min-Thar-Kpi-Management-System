{% extends "layouts/base.njk" %}
{% set active_page = "settings" %}
{# Split views: the route resolves settings_view (?view= wins, legacy
   ?tab= maps identically, direct/unknown → general). The template
   whitelists again so a bad value can never render a blank page. #}
{% set settings_view = settings_view if settings_view in ['general', 'email', 'security', 'maintenance', 'user-security'] else 'general' %}

{% block title %}System Settings - Enterprise KPI Platform{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/download-upload-style.css">
<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out forwards;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<div class="workspace-page system-settings-page min-h-full overflow-y-auto custom-scrollbar flex flex-col">
    
    <!-- HEADER -->
    <header class="app-page-header shrink-0 animate-fade-in-up">
        <div class="flex items-center gap-3 sm:gap-4">
            <div class="bg-white p-2.5 sm:p-3 rounded-xl border border-gray-200 shadow-sm text-blue-950 shrink-0">
                <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-blue-950 tracking-tight">System Settings</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Configure global platform preferences, security, and integrations.</p>
            </div>
        </div>
        {% if settings_view != 'user-security' %}
        <div class="flex items-center gap-3 w-full md:w-auto mt-2 md:mt-0">
            <button onclick="saveAllSettings()" id="saveSettingsBtn" class="w-full md:w-auto justify-center bg-blue-950 hover:bg-blue-900 text-white px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold flex items-center shadow-md transition-all duration-300 transform hover:-translate-y-0.5">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Save All Changes
            </button>
        </div>
        {% endif %}
    </header>

    <!-- SETTINGS LAYOUT (Sidebar + Content) -->
    <div class="flex flex-col lg:flex-row gap-6 sm:gap-8 flex-1 min-h-0 animate-fade-in-up csp-delay-2">
        
        <!-- CONTENT AREA -->
        <div class="flex-1 bg-white rounded-3xl shadow-sm border border-gray-100 p-5 sm:p-8 min-h-0 overflow-y-auto custom-scrollbar">
            <form id="settingsForm">
                
                {% if settings_view == 'general' %}
                <!-- 1. GENERAL SETTINGS -->
                <div id="content-general" class="setting-content space-y-6">
                    <h3 class="text-base sm:text-lg font-extrabold text-blue-950 border-b border-gray-100 pb-3 mb-4 sm:mb-6">Company & Localization</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                        <div>
                            <label for="set_company_name" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">Company Name <span class="text-red-500">*</span></label>
                            <input type="text" id="set_company_name" value="Enterprise KPI Corp" required class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner">
                        </div>
                        <div>
                            <label for="set_timezone" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">System Timezone</label>
                            <select id="set_timezone" class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner cursor-pointer">
                                <option value="Asia/Yangon" selected>Asia/Yangon (+06:30)</option>
                                <option value="UTC">UTC (+00:00)</option>
                                <option value="Asia/Bangkok">Asia/Bangkok (+07:00)</option>
                            </select>
                        </div>
                        <div>
                            <label for="set_date_format" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">Date Format</label>
                            <select id="set_date_format" class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner cursor-pointer">
                                <option value="DD-MM-YYYY" selected>DD-MM-YYYY (31-12-2026)</option>
                                <option value="MM-DD-YYYY">MM-DD-YYYY (12-31-2026)</option>
                                <option value="YYYY-MM-DD">YYYY-MM-DD (2026-12-31)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- 1b. COMPANY TRADEMARK (name + tagline + logo shown across the app) -->
                <div class="border-t border-gray-100 pt-6 space-y-5" id="trademarkSection">
                    <div>
                        <h3 class="text-base sm:text-lg font-extrabold text-blue-950">Company Trademark</h3>
                        <p class="text-xs sm:text-sm text-slate-500 mt-1">The company name, tagline and logo shown in the sidebar and on the sign-in page. Changes apply everywhere automatically.</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8">
                        <div class="shrink-0">
                            <span class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide">Logo</span>
                            <div class="flex items-center gap-4">
                                <img id="tm_logo_preview" src="{{ brand.logo_url or '/static/image/smt-logo.jpg' }}" alt="Company logo preview" class="w-20 h-20 rounded-2xl object-cover border border-gray-200 bg-slate-50 shadow-sm">
                                <div class="space-y-2">
                                    <p id="tm_logo_state" class="text-xs font-semibold text-slate-500">{% if brand.has_custom_logo %}Custom logo{% else %}Default logo{% endif %}</p>
                                    <label for="tm_logo_file" class="du-dropzone" id="tm_logo_dropzone">
                                        <span class="du-dropzone__icon">
                                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                        </span>
                                        <span class="du-dropzone__title">Drop your file here</span>
                                        <span class="du-dropzone__hint">JPEG, PNG or WebP, up to 2 MB · Click to browse</span>
                                    </label>
                                    <input type="file" id="tm_logo_file" accept="image/jpeg,image/png,image/webp" class="hidden">
                                    <div class="flex flex-wrap gap-2">
                                        <button type="button" id="tm_logo_delete" onclick="deleteTrademarkLogo()" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50{% if not brand.has_custom_logo %} hidden{% endif %}">Use default logo</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="flex-1 grid grid-cols-1 gap-4">
                            <div>
                                <label for="tm_company_name" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">Company Name <span class="text-red-500">*</span></label>
                                <input type="text" id="tm_company_name" maxlength="60" value="{{ brand.company_name or '' }}" class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner">
                                <p class="text-[11px] text-slate-400 mt-1"><span id="tm_name_count">{{ (brand.company_name or '') | length }}</span>/60 characters</p>
                            </div>
                            <div>
                                <label for="tm_company_tagline" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">Tagline</label>
                                <input type="text" id="tm_company_tagline" maxlength="90" value="{{ brand.company_tagline or '' }}" class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner">
                                <p class="text-[11px] text-slate-400 mt-1"><span id="tm_tagline_count">{{ (brand.company_tagline or '') | length }}</span>/90 characters. Leave empty to show no tagline.</p>
                            </div>
                            <div>
                                <button type="button" id="tm_save_btn" onclick="saveTrademark()" class="bg-blue-950 hover:bg-blue-900 text-white px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition-colors">Save name &amp; tagline</button>
                                <p id="tm_status" class="text-xs font-semibold mt-2" role="status" aria-live="polite"></p>
                            </div>
                        </div>
                    </div>
                </div>

                {% endif %}
                {% if settings_view == 'email' %}
                <!-- 2. EMAIL CONFIGURATION -->
                <div id="content-email" class="setting-content space-y-6">
                    <div class="flex items-center justify-between border-b border-gray-100 pb-3">
                        <h3 class="text-base font-extrabold text-blue-950">Configured Email Providers</h3>
                    </div>
                    <p class="text-sm text-slate-500">Configure providers separately. Only one provider can be active for transactional email.</p>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                        <div class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Email Service Status</div>
                        <div id="emailServiceStatus" role="status" class="mt-2 text-sm font-bold text-slate-700">Loading provider configuration...</div>
                    </div>
                    <div id="emailProviderCards" class="space-y-4"></div>
                    <div id="emailProviderEmpty" class="hidden rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
                        <p class="font-bold text-slate-700">No email providers configured.</p>
                        <p class="mt-2 text-sm text-slate-500">Add an email provider to enable application email delivery.</p>
                    </div>
                    <button type="button" onclick="openAddEmailProvider()" class="inline-flex items-center gap-2 rounded-xl bg-blue-950 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-blue-900">
                        <span class="text-lg leading-none">+</span> Add Email Provider
                    </button>
                    <div id="emailProviderModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/50 p-4" role="dialog" aria-modal="true" aria-labelledby="emailProviderModalTitle">
                        <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl">
                            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                                <div>
                                    <h3 id="emailProviderModalTitle" class="text-lg font-extrabold text-blue-950">Add Email Provider</h3>
                                    <p id="emailProviderModalDescription" class="mt-1 text-sm text-slate-500">Choose an implemented provider to configure.</p>
                                </div>
                                <button type="button" onclick="closeEmailProviderModal()" aria-label="Close" class="rounded-lg px-2 py-1 text-xl text-slate-500 hover:bg-slate-100">&times;</button>
                            </div>
                            <div id="emailProviderChoiceStep" class="space-y-5 py-5">
                                <label class="block">
                                    <span class="mb-2 block text-xs font-bold uppercase tracking-wide text-slate-700">Choose Provider</span>
                                    <select id="emailProviderChoice" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm font-semibold"></select>
                                </label>
                            </div>
                            <div id="emailProviderFormStep" class="hidden space-y-5 py-5">
                                <div class="flex items-center justify-between rounded-xl bg-slate-50 p-4">
                                    <div>
                                        <div class="text-xs font-bold uppercase tracking-wide text-slate-500">Provider Status</div>
                                        <div id="emailProviderDraftStatus" class="mt-1 text-sm font-bold text-amber-700">Disabled</div>
                                    </div>
                                    <div id="emailProviderCredentialStatus" class="text-sm font-bold text-slate-700"></div>
                                </div>
                                <div class="border-t border-slate-100 pt-4">
                                    <h4 class="mb-4 text-sm font-extrabold text-blue-950">Sender Identity</h4>
                                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                        <label class="block"><span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700">From Email</span><input id="emailProviderFromEmail" type="email" autocomplete="email" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm"></label>
                                        <label class="block"><span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700">From Name</span><input id="emailProviderFromName" type="text" maxlength="200" autocomplete="organization" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm"></label>
                                        <label class="block"><span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700">Support Email</span><input id="emailProviderSupportEmail" type="email" autocomplete="email" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm"></label>
                                    </div>
                                </div>
                                <div class="border-t border-slate-100 pt-4">
                                    <h4 class="mb-4 text-sm font-extrabold text-blue-950">Provider Configuration</h4>
                                    <div id="emailProviderDynamicFields" class="grid grid-cols-1 gap-4 md:grid-cols-2"></div>
                                </div>
                                <p class="text-xs text-slate-500">Testing never activates a provider. Changed configuration is saved as disabled before the test runs.</p>
                                <div id="emailProviderTestStatus" class="hidden rounded-xl border px-4 py-3 text-sm font-bold" role="status"></div>
                            </div>
                            <div class="flex flex-col-reverse justify-end gap-2 border-t border-slate-100 pt-4 sm:flex-row">
                                <button type="button" onclick="closeEmailProviderModal()" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">Cancel</button>
                                <button type="button" id="emailProviderBackButton" onclick="returnToProviderChoice()" class="hidden rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">Back</button>
                                <button type="button" id="emailProviderContinueButton" onclick="continueEmailProvider()" class="rounded-xl bg-blue-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-900">Continue</button>
                                <button type="button" id="emailProviderTestButton" onclick="testEmailProviderDraft()" class="hidden rounded-xl border border-blue-200 px-4 py-2.5 text-sm font-bold text-blue-700 hover:bg-blue-50">Test Connection</button>
                                <button type="button" id="emailProviderSaveButton" onclick="saveEmailProviderDraft()" class="hidden rounded-xl bg-blue-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-blue-900">Save Provider</button>
                            </div>
                        </div>
                    </div>

                </div>

                {% endif %}
                {% if settings_view == 'security' %}
                <!-- 3. SECURITY POLICY -->
                <div id="content-security" class="setting-content space-y-6">
                    <h3 class="text-base sm:text-lg font-extrabold text-blue-950 border-b border-gray-100 pb-3 mb-4 sm:mb-6">Security & Password Policy</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
                        <div class="space-y-4 sm:space-y-6">
                            <div>
                                <label for="set_pwd_length" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">Minimum Password Length</label>
                                <input type="number" id="set_pwd_length" value="8" min="8" max="128" class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner">
                            </div>
                            <div class="space-y-3 sm:space-y-4">
                                <label for="set_pwd_complex" class="flex items-center cursor-pointer group">
                                    <input type="checkbox" id="set_pwd_complex" checked class="w-5 h-5 accent-blue-600 rounded border-gray-300 cursor-pointer shrink-0">
                                    <span class="ml-3 text-xs sm:text-sm font-bold text-slate-700 group-hover:text-blue-950 transition-colors">Require Complexity (Uppercase, Numbers, Symbols)</span>
                                </label>
                                <label for="set_pwd_expire" class="flex items-center cursor-pointer group">
                                    <input type="checkbox" id="set_pwd_expire" class="w-5 h-5 accent-blue-600 rounded border-gray-300 cursor-pointer shrink-0">
                                    <span class="ml-3 text-xs sm:text-sm font-bold text-slate-700 group-hover:text-blue-950 transition-colors">Force password change every 90 days</span>
                                </label>
                            </div>
                        </div>
                        <div>
                            <label for="set_session_timeout" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 sm:mb-2 uppercase tracking-wide">Session Timeout (Minutes)</label>
                            <input type="number" id="set_session_timeout" value="120" placeholder="e.g. 120" class="w-full bg-slate-50 border border-gray-200 p-3 rounded-xl text-sm font-semibold focus:outline-none focus:bg-white focus:border-blue-900 transition-all shadow-inner">
                            <p class="text-[10px] sm:text-xs text-slate-500 mt-2 font-medium">Users will be automatically logged out after this period of inactivity.</p>
                        </div>
                    </div>
                </div>

                {% endif %}
                {% if settings_view == 'user-security' %}
                {% if user_role == "Super Admin" %}
                <div id="content-user-security" class="setting-content space-y-6">
                    <div>
                        <h3 class="text-base sm:text-lg font-extrabold text-blue-950">User Lockout Settings</h3>
                        <p class="mt-1 text-xs sm:text-sm text-slate-500">Configure failed-login limits and review accounts that are currently locked.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                        <div>
                            <label for="userSecurityMaxAttempts" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide">Maximum failed attempts</label>
                            <input id="userSecurityMaxAttempts" type="number" min="1" max="2147483647" step="1" value="5" required class="w-full rounded-xl border border-gray-200 bg-slate-50 p-3 text-sm font-semibold focus:border-blue-900 focus:bg-white focus:outline-none">
                        </div>
                        <div>
                            <label for="userSecurityDuration" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide">Lockout duration (minutes)</label>
                            <input id="userSecurityDuration" type="number" min="1" max="2147483647" step="1" value="29" required class="w-full rounded-xl border border-gray-200 bg-slate-50 p-3 text-sm font-semibold focus:border-blue-900 focus:bg-white focus:outline-none">
                        </div>
                    </div>
                    <label for="superadminLockoutEnabled" class="flex min-h-11 items-center gap-3 rounded-xl border border-gray-200 p-4">
                        <input id="superadminLockoutEnabled" type="checkbox" checked class="h-5 w-5 accent-blue-700">
                        <span>
                            <span class="block text-sm font-bold text-slate-800">Enable Account Lockout for Super Admin</span>
                            <span class="mt-1 block text-xs text-slate-500">When disabled, Super Admin accounts are exempt from failed-login lockouts.</span>
                        </span>
                    </label>
                    <div class="flex flex-wrap gap-3">
                        <button type="button" id="saveUserSecuritySettingsBtn" onclick="saveUserSecuritySettings()" class="min-h-11 rounded-xl bg-blue-950 px-5 py-2.5 text-sm font-bold text-white hover:bg-blue-900">Save User Security Settings</button>
                        <span id="userSecurityUpdatedAt" class="self-center text-xs text-slate-500"></span>
                    </div>
                    <section class="border-t border-gray-100 pt-5">
                        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <h4 class="text-sm font-extrabold text-blue-950">Currently Locked Users</h4>
                                <p class="mt-1 text-xs text-slate-500">Unlock any listed account immediately, whether or not the user submitted a request.</p>
                            </div>
                            <button type="button" onclick="loadLockedUsers()" class="min-h-11 rounded-xl border border-gray-200 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50">Refresh</button>
                        </div>
                        <div class="overflow-x-auto rounded-xl border border-gray-200">
                            <table class="w-full min-w-[720px] text-left text-xs">
                                <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
                                    <tr>
                                        <th class="px-4 py-3">User</th>
                                        <th class="px-4 py-3">Failed attempts</th>
                                        <th class="px-4 py-3">Last failed login</th>
                                        <th class="px-4 py-3">Lock expires</th>
                                        <th class="px-4 py-3">Unlock request</th>
                                        <th class="px-4 py-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="lockedUsersTableBody" class="divide-y divide-gray-100">
                                    <tr><td colspan="6" class="px-4 py-6 text-center text-slate-500">Loading locked accounts...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>
                {% endif %}

                {% endif %}
                {% if settings_view == 'maintenance' %}
                <!-- 4. MAINTENANCE -->
                <div id="content-maintenance" class="setting-content space-y-6">
                    <h3 class="text-base sm:text-lg font-extrabold text-blue-950 border-b border-gray-100 pb-3 mb-4 sm:mb-6">System Maintenance</h3>

                    {% if user_role == "Super Admin" %}
                    <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5 sm:p-6">
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:items-end">
                            <div>
                                <label for="set_audit_retention_years" class="block text-xs font-extrabold uppercase tracking-wide text-amber-950">Audit log retention</label>
                                <p class="mt-2 text-xs leading-5 text-amber-900">How long audit records are kept. Audit records are the history of who did what in the system. Choose Forever to keep them permanently. If you choose a period, audit records older than that period are deleted automatically. This applies only to audit logs; system event logs and business records are not affected.</p>
                            </div>
                            <select id="set_audit_retention_years" class="w-full rounded-xl border border-amber-200 bg-white p-3 text-sm font-semibold text-slate-700 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-100">
                                <option value="0">Forever — never delete</option>
                                <option value="5">5 years</option>
                                <option value="2">2 years</option>
                                <option value="1">1 year</option>
                            </select>
                        </div>
                    </div>
                    {% endif %}
                    
                    <div class="bg-blue-50/50 border border-blue-100 rounded-2xl p-5 sm:p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h4 class="font-extrabold text-blue-900 text-sm sm:text-base">Clear System Cache</h4>
                            <p class="text-xs sm:text-sm text-blue-700 mt-1">Clears temporary dashboard and API cache to free up memory.</p>
                        </div>
                        <button type="button" onclick="clearCache()" class="w-full md:w-auto bg-white text-blue-800 border border-blue-200 hover:bg-blue-100 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition-colors whitespace-nowrap text-center">Clear Cache Now</button>
                    </div>

                    <div class="bg-slate-50 border border-gray-200 rounded-2xl p-5 sm:p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h4 class="font-extrabold text-slate-800 text-sm sm:text-base">Settings Backup</h4>
                            <p class="text-xs sm:text-sm text-slate-500 mt-1">Download a JSON backup of the system settings only. User accounts, KPI data and other records are not included.</p>
                        </div>
                        <button type="button" onclick="downloadBackup()" class="w-full md:w-auto justify-center bg-blue-950 text-white hover:bg-blue-900 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition-colors whitespace-nowrap flex items-center btn-glass-download">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            Download Settings Backup
                        </button>
                    </div>

                    {% if user_role == "Super Admin" %}
                    <div class="bg-slate-50 border border-gray-200 rounded-2xl p-5 sm:p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <h4 class="font-extrabold text-slate-800 text-sm sm:text-base">Full Data Export</h4>
                            <p class="text-xs sm:text-sm text-slate-500 mt-1">One ZIP file with all company data tables (35 of 38). Login/session and password data is never included. Files stored in file storage are not included.</p>
                        </div>
                        <button type="button" id="fullExportBtn" onclick="downloadFullExport()" class="w-full md:w-auto justify-center bg-blue-950 text-white hover:bg-blue-900 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition-colors whitespace-nowrap flex items-center disabled:opacity-60 disabled:cursor-wait btn-glass-download">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            <span id="fullExportBtnLabel">Download Full Export</span>
                        </button>
                    </div>
                    {% endif %}
                </div>

                {% endif %}
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    function escapeHTML(str) {
        if (str === null || str === undefined) return "";
        return str.toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    let emailProviderDefinitions = [];
    let configuredEmailProviders = [];
    let activeEmailProvider = null;
    let editingEmailProvider = null;

    // Split views: only the current view's loads run, so hidden
    // sections' fetches never fire. Trademark lives on General only.
    const SETTINGS_VIEW = {{ settings_view | tojson }};
    document.addEventListener("DOMContentLoaded", () => {
        // Canonical URL (?tab= -> ?view=, unknown -> ?view=general).
        // Guarded: a replaceState failure must never block the load.
        try {
            const canonical = `/system-settings?view=${SETTINGS_VIEW}`;
            if (window.location.search !== `?view=${SETTINGS_VIEW}`) {
                window.history.replaceState(null, '', canonical);
            }
        } catch (_) { /* keep the page usable */ }
        if (SETTINGS_VIEW === 'email') {
            loadEmailProviders();
        } else if (SETTINGS_VIEW === 'user-security') {
            if (document.getElementById('content-user-security')) {
            loadUserSecuritySettings();
            loadLockedUsers();
            document.getElementById('superadminLockoutEnabled').addEventListener('change', async (event) => {
                const toggle = event.currentTarget;
                if (toggle.checked) return;
                toggle.checked = true;
                const confirmed = await window.appConfirm(
                    "⚠️ Security Warning: Disabling account lockout for Super Admin exposes this account to brute-force password attacks and is not recommended for security. Are you sure you want to proceed?",
                    { title: "Security Warning", cancelText: "Cancel", confirmText: "Confirm & Disable" }
                );
                if (!confirmed) return;
                toggle.checked = false;
                if (!(await saveUserSecuritySettings())) toggle.checked = true;
            });
            }
        } else {
            loadSettings();
            if (SETTINGS_VIEW === 'general') loadTrademark();
        }
    });

    async function emailProviderRequest(path, method = 'GET', body = null) {
        const options = { method, headers: {} };
        if (body !== null) {
            options.headers['Content-Type'] = 'application/json';
            options.body = JSON.stringify(body);
        }
        const response = await fetch(`/api/v1/system${path}`, options);
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
            let message = result.detail;
            if (Array.isArray(message)) {
                message = message.map(item => item.msg).filter(Boolean).join(' ');
            }
            if (response.status === 401) {
                message = 'Your session has expired. Please sign in again.';
            } else if (response.status === 403) {
                message = 'You do not have permission to change email provider settings.';
            } else if (response.status === 404) {
                message = 'Email provider was not found. Refresh the page and try again.';
            } else if (response.status >= 500) {
                message = 'Unable to update email provider. Please try again.';
            }
            const error = new Error(message || `Request failed (${response.status}).`);
            error.status = response.status;
            throw error;
        }
        return result;
    }

    async function loadEmailProviders() {
        try {
            const result = await emailProviderRequest('/settings/email/providers');
            emailProviderDefinitions = result.definitions || [];
            configuredEmailProviders = result.configured_providers || [];
            activeEmailProvider = result.active_provider || null;
            document.getElementById('emailServiceStatus').textContent =
                result.service_status || 'Disabled — No active provider';
            renderEmailProviderCards();
        } catch (error) {
            document.getElementById('emailServiceStatus').textContent =
                'Unable to load email provider configuration.';
            showToast(error.message || 'Failed to load email provider configuration.', 'error');
        }
    }

    function renderEmailProviderCards() {
        const cards = document.getElementById('emailProviderCards');
        const empty = document.getElementById('emailProviderEmpty');
        empty.classList.toggle('hidden', configuredEmailProviders.length > 0);
        cards.innerHTML = configuredEmailProviders.map(entry => {
            const config = entry.configuration || {};
            const active = entry.provider === activeEmailProvider && config.enabled;
            const testStatus = config.last_test_status
                ? (config.last_test_status === 'ready' ? 'Ready' : 'Not Ready — run Test Connection')
                : (config.tested ? 'Ready' : 'Not tested');
            const credentialStatus = entry.credential_configured
                ? 'Credential configured'
                : `${escapeHTML(emailProviderDefinitions.find(item => item.key === entry.provider)?.credential_label || 'Credential')}: Not Configured`;
            return `<article class="rounded-2xl border ${active ? 'border-green-200 bg-green-50/40' : 'border-slate-200 bg-white'} p-5 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h5 class="text-base font-extrabold text-blue-950">${escapeHTML(entry.name)}</h5>
                    <span class="rounded-full px-3 py-1 text-xs font-bold ${active ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-600'}">${active ? '● Active' : '○ Disabled'}</span>
                </div>
                <dl class="mt-4 grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
                    <div><dt class="inline font-bold text-slate-500">From: </dt><dd class="inline text-slate-800">${escapeHTML(config.from_email || 'Not configured')}</dd></div>
                    <div><dt class="inline font-bold text-slate-500">From Name: </dt><dd class="inline text-slate-800">${escapeHTML(config.from_name || 'Not configured')}</dd></div>
                    <div><dt class="inline font-bold text-slate-500">Support: </dt><dd class="inline text-slate-800">${escapeHTML(config.support_email || 'Not configured')}</dd></div>
                    <div><dt class="inline font-bold text-slate-500">Credential: </dt><dd class="inline text-slate-800">${credentialStatus}</dd></div>
                </dl>
                <p class="mt-3 text-sm font-semibold ${config.tested ? 'text-green-700' : 'text-amber-700'}">Status: ${testStatus}</p>
                ${!active && !config.tested ? '<p class="mt-2 text-xs font-semibold text-amber-700">Test Connection successfully before enabling this provider.</p>' : ''}
                <div class="mt-4 flex flex-wrap gap-2">
                    <button type="button" onclick="editEmailProvider('${escapeHTML(entry.provider)}')" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50">Edit</button>
                    <button type="button" onclick="testSavedEmailProvider('${escapeHTML(entry.provider)}')" class="rounded-lg border border-blue-200 px-3 py-2 text-xs font-bold text-blue-700 hover:bg-blue-50">Test Connection</button>
                    <button type="button" onclick="setEmailProviderEnabled('${escapeHTML(entry.provider)}', ${!active}, this)" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50" ${!active && !config.tested ? 'title="Test successfully before enabling"' : ''}>${active ? 'Disable' : 'Enable'}</button>
                    <button type="button" onclick="removeEmailProvider('${escapeHTML(entry.provider)}')" aria-label="Remove ${escapeHTML(entry.name)}" class="rounded-lg border border-red-200 px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-50">&times; Remove</button>
                </div>
            </article>`;
        }).join('');
    }

    function openAddEmailProvider() {
        editingEmailProvider = null;
        const choice = document.getElementById('emailProviderChoice');
        choice.innerHTML = emailProviderDefinitions.map(definition =>
            `<option value="${escapeHTML(definition.key)}">${escapeHTML(definition.name)}</option>`
        ).join('');
        document.getElementById('emailProviderModalTitle').textContent = 'Add Email Provider';
        document.getElementById('emailProviderModalDescription').textContent =
            'Choose an implemented provider. Existing configurations can be edited or restored.';
        showProviderChoice();
        document.getElementById('emailProviderModal').classList.remove('hidden');
        document.getElementById('emailProviderModal').classList.add('flex');
    }

    function editEmailProvider(provider) {
        editingEmailProvider = provider;
        openProviderConfiguration(provider);
        document.getElementById('emailProviderModalTitle').textContent = `Edit ${providerName(provider)}`;
        document.getElementById('emailProviderModalDescription').textContent =
            'Save changes as disabled, test the configuration, then explicitly enable it.';
    }

    function providerName(provider) {
        return emailProviderDefinitions.find(definition => definition.key === provider)?.name || provider;
    }

    function showProviderChoice() {
        document.getElementById('emailProviderChoiceStep').classList.remove('hidden');
        document.getElementById('emailProviderFormStep').classList.add('hidden');
        document.getElementById('emailProviderContinueButton').classList.remove('hidden');
        document.getElementById('emailProviderBackButton').classList.add('hidden');
        document.getElementById('emailProviderTestButton').classList.add('hidden');
        document.getElementById('emailProviderSaveButton').classList.add('hidden');
    }

    function returnToProviderChoice() {
        editingEmailProvider = null;
        showProviderChoice();
    }

    function continueEmailProvider() {
        openProviderConfiguration(document.getElementById('emailProviderChoice').value);
    }

    function openProviderConfiguration(provider) {
        const definition = emailProviderDefinitions.find(item => item.key === provider);
        if (!definition) {
            showToast('That email provider is not implemented.', 'error');
            return;
        }
        const existing = configuredEmailProviders.find(item => item.provider === provider);
        const config = existing?.configuration || {};
        editingEmailProvider = provider;
        document.getElementById('emailProviderChoiceStep').classList.add('hidden');
        document.getElementById('emailProviderFormStep').classList.remove('hidden');
        document.getElementById('emailProviderContinueButton').classList.add('hidden');
        document.getElementById('emailProviderBackButton').classList.toggle('hidden', !document.getElementById('emailProviderModalTitle').textContent.startsWith('Edit'));
        document.getElementById('emailProviderTestButton').classList.remove('hidden');
        document.getElementById('emailProviderSaveButton').classList.remove('hidden');
        document.getElementById('emailProviderFromEmail').value = config.from_email || '';
        document.getElementById('emailProviderFromName').value = config.from_name || 'Shwe Min Thar KPI Management System';
        document.getElementById('emailProviderSupportEmail').value = config.support_email || '';
        document.getElementById('emailProviderCredentialStatus').textContent =
            `${definition.credential_label}: ${definition.credential_configured ? 'Configured' : 'Not Configured'}`;
        const draftStatus = document.getElementById('emailProviderDraftStatus');
        const isActive = provider === activeEmailProvider && config.enabled;
        draftStatus.textContent = isActive ? 'Active — saving changes will disable it' : 'Disabled';
        draftStatus.className = `mt-1 text-sm font-bold ${isActive ? 'text-green-700' : 'text-amber-700'}`;
        renderEmailProviderFields(definition, config);
        const testStatus = document.getElementById('emailProviderTestStatus');
        testStatus.classList.add('hidden');
        testStatus.textContent = '';
    }

    function renderEmailProviderFields(definition, config) {
        const container = document.getElementById('emailProviderDynamicFields');
        container.innerHTML = definition.fields.map(field => {
            if (field.type === 'select') {
                const options = field.options.map(option =>
                    `<option value="${escapeHTML(option.value)}" ${config[field.key] === option.value ? 'selected' : ''}>${escapeHTML(option.label)}</option>`
                ).join('');
                return `<label class="block"><span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700">${escapeHTML(field.label)}</span><select data-email-provider-field="${escapeHTML(field.key)}" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm">${options}</select></label>`;
            }
            const type = field.type === 'number' ? 'number' : 'text';
            const attrs = field.type === 'number' ? 'min="1" max="65535"' : 'maxlength="255"';
            return `<label class="block"><span class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-700">${escapeHTML(field.label)}</span><input data-email-provider-field="${escapeHTML(field.key)}" type="${type}" ${attrs} ${field.required ? 'required' : ''} value="${escapeHTML(config[field.key] ?? (field.key === 'smtp_port' ? 587 : ''))}" class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm"></label>`;
        }).join('');
    }

    function readEmailProviderDraft() {
        const configuration = {
            from_email: document.getElementById('emailProviderFromEmail').value.trim() || null,
            from_name: document.getElementById('emailProviderFromName').value.trim() || 'Shwe Min Thar KPI Management System',
            support_email: document.getElementById('emailProviderSupportEmail').value.trim() || null,
            enabled: false,
            tested: false
        };
        document.querySelectorAll('[data-email-provider-field]').forEach(field => {
            const key = field.dataset.emailProviderField;
            configuration[key] = field.type === 'number'
                ? (field.value ? Number(field.value) : null)
                : (field.value.trim() || null);
        });
        return configuration;
    }

    function sameEmailProviderConfiguration(left, right) {
        const withoutLifecycle = value => Object.fromEntries(
            Object.entries(value).filter(([key]) =>
                !['enabled', 'tested', 'last_test_status'].includes(key)
            )
        );
        return JSON.stringify(withoutLifecycle(left)) === JSON.stringify(withoutLifecycle(right));
    }

    function closeEmailProviderModal() {
        const modal = document.getElementById('emailProviderModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    async function saveEmailProviderDraft() {
        if (!editingEmailProvider) return;
        try {
            await emailProviderRequest(
                `/settings/email/providers/${editingEmailProvider}`,
                'PUT',
                { provider: editingEmailProvider, configuration: readEmailProviderDraft() }
            );
            await loadEmailProviders();
            closeEmailProviderModal();
            showToast(`${providerName(editingEmailProvider)} saved as disabled. Test and enable it when ready.`, 'success');
        } catch (error) {
            showToast(error.message || 'Could not save email provider.', 'error');
        }
    }

    async function testEmailProviderDraft() {
        if (!editingEmailProvider) return;
        const provider = editingEmailProvider;
        try {
            const draft = readEmailProviderDraft();
            const existing = configuredEmailProviders.find(item => item.provider === provider);
            const isUnchanged = existing &&
                sameEmailProviderConfiguration(draft, existing.configuration);
            if (!isUnchanged) {
                const active = provider === activeEmailProvider;
                if (active && !(await window.appConfirm(
                    'Saving this changed configuration will disable the currently active provider. You can test it and explicitly enable it again afterward.',
                    { title: `Save and test ${providerName(provider)}?`, confirmText: 'Save Draft and Test' }
                ))) return;
                await emailProviderRequest(
                    `/settings/email/providers/${provider}`,
                    'PUT',
                    { provider, configuration: draft }
                );
            }
            const result = await emailProviderRequest(
                `/settings/email/providers/${provider}/test-connection`,
                'POST'
            );
            await loadEmailProviders();
            const box = document.getElementById('emailProviderTestStatus');
            box.textContent = result.message || 'Provider is not ready.';
            box.className = `rounded-xl border px-4 py-3 text-sm font-bold ${result.success ? 'border-green-200 bg-green-50 text-green-800' : 'border-amber-200 bg-amber-50 text-amber-800'}`;
            box.classList.remove('hidden');
        } catch (error) {
            showToast(error.message || 'Email provider test failed.', 'error');
        }
    }

    async function testSavedEmailProvider(provider) {
        try {
            const result = await emailProviderRequest(
                `/settings/email/providers/${provider}/test-connection`,
                'POST'
            );
            await loadEmailProviders();
            showToast(result.message || 'Provider test completed.', result.success ? 'success' : 'error');
        } catch (error) {
            showToast(error.message || 'Email provider test failed.', 'error');
        }
    }

    async function setEmailProviderEnabled(provider, enable, button) {
        if (!enable && !(await window.appConfirm(`Email delivery through ${providerName(provider)} will stop. You can enable it again later.`, { title: `Disable ${providerName(provider)}?`, confirmText: 'Disable' }))) return;
        const originalText = button?.textContent;
        if (button) {
            button.disabled = true;
            button.textContent = enable ? 'Enabling...' : 'Disabling...';
        }
        try {
            const result = await emailProviderRequest(
                `/settings/email/providers/${provider}/lifecycle`,
                'POST',
                { action: enable ? 'enable' : 'disable' }
            );
            activeEmailProvider = result.active_provider || null;
            configuredEmailProviders = configuredEmailProviders.map(entry =>
                entry.provider === provider
                    ? { ...entry, configuration: { ...entry.configuration, enabled: result.enabled } }
                    : {
                        ...entry,
                        configuration: {
                            ...entry.configuration,
                            enabled: result.active_provider === entry.provider
                        }
                    }
            );
            document.getElementById('emailServiceStatus').textContent =
                result.service_status || (
                    activeEmailProvider
                        ? `Enabled — ${providerName(activeEmailProvider)}`
                        : 'Disabled — No active provider'
                );
            renderEmailProviderCards();
            await loadEmailProviders();
            showToast(result.message || `${providerName(provider)} ${enable ? 'enabled' : 'disabled'} successfully.`, 'success');
        } catch (error) {
            showToast(error.message || `Could not ${enable ? 'enable' : 'disable'} provider.`, 'error');
            if (button) {
                button.disabled = false;
                button.textContent = originalText || (enable ? 'Enable' : 'Disable');
            }
        }
    }

    async function removeEmailProvider(provider) {
        if (!(await window.appConfirm(`This removes ${providerName(provider)} from active configuration. Email delivery through it will stop.`, { title: `Remove ${providerName(provider)}?`, confirmText: 'Remove Provider' }))) return;
        try {
            await emailProviderRequest(`/settings/email/providers/${provider}`, 'DELETE');
            await loadEmailProviders();
            showToast(`${providerName(provider)} was removed.`, 'success');
        } catch (error) {
            showToast(error.message || 'Could not remove email provider.', 'error');
        }
    }

    async function userSecurityRequest(path, method = 'GET', body = null) {
        const options = { method, headers: {} };
        if (body !== null) {
            options.headers['Content-Type'] = 'application/json';
            options.body = JSON.stringify(body);
        }
        const response = await fetch(`/api/v1/system${path}`, options);
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
            if (response.status === 401) {
                window.location.href = '/auth/login';
            }
            throw new Error(result.detail || `Request failed (${response.status}).`);
        }
        return result;
    }

    async function loadUserSecuritySettings() {
        try {
            const value = await userSecurityRequest('/user-security-settings');
            document.getElementById('userSecurityMaxAttempts').value = value.max_failed_attempts;
            document.getElementById('userSecurityDuration').value = value.lockout_duration_minutes;
            document.getElementById('superadminLockoutEnabled').checked = value.superadmin_lockout_enabled;
            const updated = document.getElementById('userSecurityUpdatedAt');
            updated.textContent = value.updated_at
                ? `Last updated ${new Date(value.updated_at).toLocaleString()}`
                : 'Using default security settings';
        } catch (error) {
            console.error('Unable to load user lockout settings:', error);
            showToast(error.message || 'Unable to load user lockout settings.', 'error');
        }
    }

    async function saveUserSecuritySettings() {
        const attempts = Number(document.getElementById('userSecurityMaxAttempts').value);
        const duration = Number(document.getElementById('userSecurityDuration').value);
        if (!Number.isInteger(attempts) || attempts < 1 || attempts > 2147483647 ||
            !Number.isInteger(duration) || duration < 1 || duration > 2147483647) {
            showToast('Enter positive whole numbers within the supported integer range.', 'error');
            return false;
        }
        const button = document.getElementById('saveUserSecuritySettingsBtn');
        const previouslyDisabled = button.disabled;
        button.disabled = true;
        try {
            const value = await userSecurityRequest('/user-security-settings', 'PUT', {
                max_failed_attempts: attempts,
                lockout_duration_minutes: duration,
                superadmin_lockout_enabled: document.getElementById('superadminLockoutEnabled').checked
            });
            document.getElementById('userSecurityUpdatedAt').textContent =
                `Last updated ${new Date(value.updated_at).toLocaleString()}`;
            showToast('User lockout settings saved.', 'success');
            await loadLockedUsers();
            return true;
        } catch (error) {
            console.error('Unable to save user lockout settings:', error);
            showToast(error.message || 'Unable to save user lockout settings.', 'error');
            return false;
        } finally {
            button.disabled = previouslyDisabled;
        }
    }

    function formatLockoutDate(value) {
        if (!value) return 'Not available';
        const date = new Date(value);
        return Number.isNaN(date.getTime()) ? 'Not available' : date.toLocaleString();
    }

    async function loadLockedUsers() {
        const body = document.getElementById('lockedUsersTableBody');
        if (!body) return;
        try {
            const users = await userSecurityRequest('/locked-users');
            if (!users.length) {
                body.innerHTML = '<tr><td colspan="6" class="px-4 py-6 text-center text-slate-500">No accounts are currently locked.</td></tr>';
                return;
            }
            body.innerHTML = users.map(user => `
                <tr>
                    <td class="px-4 py-3"><strong>${escapeHTML(user.user_name)}</strong><span class="block text-slate-500">${escapeHTML(user.email)}</span></td>
                    <td class="px-4 py-3">${escapeHTML(user.failed_login_attempts)}</td>
                    <td class="px-4 py-3">${escapeHTML(formatLockoutDate(user.last_failed_at))}<span class="block text-slate-500">${escapeHTML(user.last_failed_ip || 'Not available')}</span></td>
                    <td class="px-4 py-3">${escapeHTML(formatLockoutDate(user.locked_until))}</td>
                    <td class="px-4 py-3">${user.pending_request_id ? 'Pending' : 'None'}</td>
                    <td class="px-4 py-3"><button type="button" data-unlock-user="${escapeHTML(user.user_id)}" class="min-h-11 rounded-lg bg-blue-950 px-3 py-2 text-xs font-bold text-white hover:bg-blue-900">Unlock Now</button></td>
                </tr>`).join('');
            body.querySelectorAll('[data-unlock-user]').forEach(button => {
                button.addEventListener('click', () => unlockLockedUser(button.dataset.unlockUser, button));
            });
        } catch (error) {
            console.error('Unable to load locked accounts:', error);
            const reason = window.displayErrorText ? window.displayErrorText(error) : "Unable to load locked accounts.";
            body.innerHTML = `<tr><td colspan="6" class="px-4 py-6 text-center text-red-700">${escapeHTML(reason)}</td></tr>`;
        }
    }

    async function unlockLockedUser(userId, button) {
        if (!(await window.appConfirm('Unlock this account now and reset its failed login attempts?', {
            title: 'Unlock user account',
            confirmText: 'Unlock Account Now'
        }))) return;
        button.disabled = true;
        try {
            const result = await userSecurityRequest(`/locked-users/${encodeURIComponent(userId)}/unlock`, 'POST');
            showToast(result.message || 'User account unlocked successfully.', 'success');
            await loadLockedUsers();
        } catch (error) {
            console.error('Unable to unlock account:', error);
            showToast(error.message || 'Unable to unlock account.', 'error');
            button.disabled = false;
        }
    }

    window.loadLockedUsers = loadLockedUsers;

    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if(!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'fixed top-5 right-5 z-[9999] flex flex-col gap-2 max-w-[90%] sm:max-w-md w-full items-end';
            document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        const bgColor = type === 'success' ? 'bg-green-50 text-green-800 border-green-500' : 'bg-red-50 text-red-800 border-red-500';
        toast.className = `flex items-center px-4 py-3 rounded-xl shadow-lg text-xs sm:text-sm font-bold border-l-4 ${bgColor} mb-3 animate-fade-in-up w-full`;
        toast.innerHTML = escapeHTML(message);
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }

    // ===== Company Trademark (name + tagline + logo) =====
    async function brandingRequest(path, method = 'GET', body = null) {
        const options = { method, headers: {} };
        if (body !== null) {
            options.headers['Content-Type'] = 'application/json';
            options.body = JSON.stringify(body);
        }
        let response;
        try {
            response = await fetch(`/api/v1/system/branding${path}`, options);
        } catch {
            throw new Error('Unable to reach the server. Please try again.');
        }
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
            let message = result.detail;
            if (Array.isArray(message)) {
                message = message.map(item => item.msg).filter(Boolean).join(' ');
            }
            if (response.status === 401) message = 'Your session has expired. Please sign in again.';
            else if (response.status === 403) message = 'You do not have permission to change trademark settings.';
            const error = new Error(message || `Request failed (${response.status}).`);
            error.status = response.status;
            throw error;
        }
        return result;
    }

    function trademarkStatus(message, isError = false) {
        const status = document.getElementById('tm_status');
        status.textContent = message || '';
        status.className = `text-xs font-semibold mt-2 ${isError ? 'text-red-700' : 'text-green-700'}`;
    }

    function applyTrademark(brand) {
        document.getElementById('tm_company_name').value = brand.company_name || '';
        document.getElementById('tm_company_tagline').value = brand.company_tagline || '';
        document.getElementById('tm_name_count').textContent = (brand.company_name || '').length;
        document.getElementById('tm_tagline_count').textContent = (brand.company_tagline || '').length;
        document.getElementById('tm_logo_preview').src = brand.logo_url || '/static/image/smt-logo.jpg';
        document.getElementById('tm_logo_state').textContent = brand.has_custom_logo ? 'Custom logo' : 'Default logo';
        document.getElementById('tm_logo_delete').classList.toggle('hidden', !brand.has_custom_logo);
    }

    async function loadTrademark() {
        try {
            applyTrademark(await brandingRequest(''));
        } catch (error) {
            trademarkStatus(error.message || 'Failed to load trademark settings.', true);
        }
    }

    async function saveTrademark() {
        const name = document.getElementById('tm_company_name').value.trim();
        const tagline = document.getElementById('tm_company_tagline').value.trim();
        try {
            const brand = await brandingRequest('', 'PUT', { company_name: name, company_tagline: tagline });
            applyTrademark(brand);
            // The General view edits the same company name — keep it in sync.
            const generalName = document.getElementById('set_company_name');
            if (generalName) generalName.value = brand.company_name || '';
            trademarkStatus('Saved. The new name and tagline now show across the app.');
            showToast('Company trademark saved.', 'success');
        } catch (error) {
            trademarkStatus(error.message || 'Failed to save trademark settings.', true);
            showToast(error.message || 'Failed to save trademark settings.', 'error');
        }
    }

    async function deleteTrademarkLogo() {
        try {
            applyTrademark(await brandingRequest('/logo', 'DELETE'));
            trademarkStatus('Default logo restored.');
            showToast('Default logo restored.', 'success');
        } catch (error) {
            trademarkStatus(error.message || 'Failed to restore the default logo.', true);
        }
    }

    const tmLogoFile = document.getElementById('tm_logo_file');
    if (tmLogoFile) { tmLogoFile.addEventListener('change', async (event) => {
        const file = event.target.files && event.target.files[0];
        event.target.value = '';
        if (!file) return;
        const logoState = document.getElementById('tm_logo_state');
        if (logoState) logoState.textContent = 'Uploading…';
        const form = new FormData();
        form.append('file', file);
        try {
            let response;
            try {
                response = await fetch('/api/v1/system/branding/logo', { method: 'POST', body: form });
            } catch {
                throw new Error('Unable to reach the server. Please try again.');
            }
            const result = await response.json().catch(() => ({}));
            if (!response.ok) {
                let message = result.detail;
                if (Array.isArray(message)) message = message.map(item => item.msg).filter(Boolean).join(' ');
                throw new Error(message || `Upload failed (${response.status}).`);
            }
            applyTrademark(result);
            trademarkStatus('Logo updated across the app.');
            showToast('Company logo updated.', 'success');
        } catch (error) {
            trademarkStatus(error.message || 'Failed to upload the logo.', true);
            showToast(error.message || 'Failed to upload the logo.', 'error');
        }
    });
    }
    // Logo drop zone: dropping a file hands it to the existing hidden
    // input, so the change handler above (validation + upload + status)
    // runs unchanged. Click-to-browse works via the label's for attribute.
    const logoDropzone = document.getElementById('tm_logo_dropzone');
    const logoInput = document.getElementById('tm_logo_file');
    if (logoDropzone && logoInput) {
        logoDropzone.addEventListener('dragover', (e) => { e.preventDefault(); logoDropzone.classList.add('is-dragover'); });
        logoDropzone.addEventListener('dragleave', () => logoDropzone.classList.remove('is-dragover'));
        logoDropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            logoDropzone.classList.remove('is-dragover');
            if (!e.dataTransfer.files.length) return;
            logoInput.files = e.dataTransfer.files;
            logoInput.dispatchEvent(new Event('change', { bubbles: true }));
        });
    }

    ['tm_company_name', 'tm_company_tagline'].forEach((id) => {
        const input = document.getElementById(id);
        if (!input) return;
        const counter = document.getElementById(id === 'tm_company_name' ? 'tm_name_count' : 'tm_tagline_count');
        input.addEventListener('input', () => { counter.textContent = input.value.length; });
        input.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') { event.preventDefault(); saveTrademark(); }
        });
    });

    // The retention period currently saved on the server (0 = Forever).
    // saveAllSettings compares against it to warn before deletion is
    // switched on. Defaults to Forever when the setting does not exist.
    let loadedAuditRetentionYears = 0;

    async function loadSettings() {
        try {
            const res = await fetch('/api/v1/system/settings');
            // 🛡️ AUTH FIX
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) {
                const settingsArray = await res.json();
                
                // Split views: fill only the fields on this view.
                const setField = (id, value) => { const el = document.getElementById(id); if (el) el.value = value; };
                const setCheck = (id, checked) => { const el = document.getElementById(id); if (el) el.checked = checked; };
                settingsArray.forEach(setting => {
                    const data = setting.value || {};

                    if (setting.key === 'general') {
                        if(data.company_name) setField('set_company_name', data.company_name);
                        if(data.timezone) setField('set_timezone', data.timezone);
                        if(data.date_format) setField('set_date_format', data.date_format);
                    } else if (setting.key === 'security') {
                        if(data.minimum_password_length || data.min_length) setField('set_pwd_length', data.minimum_password_length || data.min_length);
                        if(data.require_complexity !== undefined) setCheck('set_pwd_complex', data.require_complexity);
                        if(data.password_expiry !== undefined) setCheck('set_pwd_expire', data.password_expiry);
                        else if(data.force_password_change_days !== undefined) setCheck('set_pwd_expire', Number(data.force_password_change_days) > 0);
                        if(data.session_timeout) setField('set_session_timeout', data.session_timeout);
                    } else if (setting.key === 'audit_retention_years') {
                        const years = Number(data.retention_years);
                        loadedAuditRetentionYears = [0, 1, 2, 5].includes(years) ? years : 0;
                        const retentionSelect = document.getElementById('set_audit_retention_years');
                        if (retentionSelect) retentionSelect.value = String(loadedAuditRetentionYears);
                    }
                });
            } else {
                showToast(await window.readServerError(res), "error");
            }
        } catch (e) {
            console.error("Error loading settings:", e);
            showToast("Failed to connect to server to fetch settings.", "error");
        }
    }

    async function upsertSetting(key, valueObj) {
        try {
            let res = await fetch(`/api/v1/system/settings/${key}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ value: valueObj })
            });
            // 🛡️ AUTH FIX
            if (res.status === 401) {
                showToast("Your session has expired. Please sign in again.", "error");
                window.location.href = '/auth/login';
                return false;
            }
            if (res.status === 403) {
                showToast("You do not have permission to edit system settings.", "error");
                return false;
            }
            
            if (res.status === 404) {
                res = await fetch('/api/v1/system/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key: key, value: valueObj })
                });
            }
            if (!res.ok) {
                let detail = `HTTP ${res.status}`;
                try {
                    const error = await res.json();
                    detail = error.detail || detail;
                } catch (_) {}
                console.error(`Failed to save ${key}:`, res.status, detail);
                const safeDetail = typeof detail === "string" && detail !== `HTTP ${res.status}` && !(window.isUnsafeErrorText && window.isUnsafeErrorText(detail)) ? detail : null;
                if (res.status === 422 || res.status === 400) {
                    showToast(safeDetail || "Please check the settings values and try again.", "error");
                } else if (res.status === 404) {
                    showToast(`The ${key} settings endpoint was not found.`, "error");
                } else if (res.status >= 500) {
                    showToast(safeDetail ? `Server error (${res.status}): ${safeDetail}` : `Server error (${res.status}). Please try again.`, "error");
                }
            }
            return res.ok;
        } catch (e) {
            console.error(`Error saving ${key}:`, e);
            return false;
        }
    }

    async function saveAllSettings() {
        const btn = document.getElementById('saveSettingsBtn');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="app-spinner"></span>Saving...`;
        btn.disabled = true;

        // Split views: save only the keys whose fields are on this
        // view. On the Email view nothing is saveable here (providers
        // save through their own flows) — say so, never throw.
        const generalEl = document.getElementById('set_company_name');
        const generalVal = generalEl ? {
            company_name: generalEl.value,
            timezone: document.getElementById('set_timezone').value,
            date_format: document.getElementById('set_date_format').value
        } : null;
        const securityEl = document.getElementById('set_pwd_length');
        const securityVal = securityEl ? {
            minimum_password_length: Number(securityEl.value),
            min_length: Number(securityEl.value),
            require_complexity: document.getElementById('set_pwd_complex').checked,
            password_expiry: document.getElementById('set_pwd_expire').checked,
            force_password_change_days: document.getElementById('set_pwd_expire').checked ? 90 : 0,
            session_timeout: Number(document.getElementById('set_session_timeout').value)
        } : null;
        const retentionSelect = document.getElementById('set_audit_retention_years');
        const auditRetentionVal = retentionSelect
            ? { retention_years: Number(retentionSelect.value) }
            : null;
        if (!generalVal && !securityVal && !auditRetentionVal) {
            showToast('Nothing to save on this page.', 'error');
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            return;
        }

        // Switching away from Forever turns automatic deletion ON: warn
        // clearly and ask first. Declining cancels the whole save.
        if (auditRetentionVal && loadedAuditRetentionYears === 0 && auditRetentionVal.retention_years !== 0) {
            const years = auditRetentionVal.retention_years;
            const confirmed = await window.appConfirm(
                `Audit records older than ${years} ${years === 1 ? 'year' : 'years'} will be deleted automatically, and deleted audit records cannot be recovered. Audit records are the history of who did what in the system — keep Forever if you need a complete history.`,
                { title: 'Turn on audit log deletion?', confirmText: 'Turn on deletion' }
            );
            if (!confirmed) {
                showToast('Save cancelled. Audit logs will still be kept forever.', 'error');
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                return;
            }
        }

        try {
            const p1 = generalVal ? upsertSetting('general', generalVal) : Promise.resolve(true);
            const p2 = securityVal ? upsertSetting('security', securityVal) : Promise.resolve(true);
            const p3 = auditRetentionVal
                ? upsertSetting('audit_retention_years', auditRetentionVal)
                : Promise.resolve(true);

            const results = await Promise.all([p1, p2, p3]);

            if (results.every(r => r === true)) {
                if (auditRetentionVal) loadedAuditRetentionYears = auditRetentionVal.retention_years;
                showToast("System settings updated successfully.", "success");
            } else {
                showToast("Some settings failed to save. Check your permissions and field values.", "error");
            }
        } catch(e) {
            showToast(window.displayErrorText ? window.displayErrorText(e) : "Network error. Failed to save settings.", "error");
        } finally {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        }
    }

    async function clearCache() {
        if(!(await window.appConfirm("This may temporarily slow down initial load times.", { title: "Clear system cache?", confirmText: "Clear cache" }))) return;
        
        try {
            const res = await fetch('/api/v1/system/clear-cache', { method: 'POST' });
            // 🛡️ AUTH FIX
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            if(res.ok) {
                showToast("System cache cleared successfully.", "success");
            } else {
                showToast(await window.readServerError(res), "error");
            }
        } catch (e) {
            showToast("Network error while clearing cache.", "error");
        }
    }

    async function downloadBackup() {
        showToast("Generating settings backup. Please wait...", "success");
        try {
            const res = await fetch('/api/v1/system/backup', { method: 'GET' });
            // 🛡️ AUTH FIX
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) {
                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                
                let filename = "system_backup.json";
                const disposition = res.headers.get('Content-Disposition');
                if (disposition && disposition.includes('filename=')) {
                    filename = disposition.split('filename=')[1].replaceAll('"', '');
                }
                
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                
                a.remove();
                window.URL.revokeObjectURL(url);
                showToast("Settings backup downloaded successfully.", "success");
            } else {
                showToast(await window.readServerError(res), "error");
            }
        } catch(e) {
            showToast("Network error while downloading settings backup.", "error");
        }
    }

    async function downloadFullExport() {
        const btn = document.getElementById('fullExportBtn');
        const label = document.getElementById('fullExportBtnLabel');
        btn.disabled = true;
        label.textContent = 'Preparing\u2026';
        try {
            const res = await fetch('/api/v1/system/backup/full', { method: 'GET' });
            // AUTH FIX (same as downloadBackup)
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }

            if (res.ok) {
                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);

                let filename = 'full_export.zip';
                const disposition = res.headers.get('Content-Disposition');
                if (disposition && disposition.includes('filename=')) {
                    filename = disposition.split('filename=')[1].replaceAll('"', '');
                }

                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();

                a.remove();
                window.URL.revokeObjectURL(url);
                showToast("Full export downloaded successfully.", "success");
            } else {
                showToast(await window.readServerError(res), "error");
            }
        } catch(e) {
            showToast("Network error while downloading the full export.", "error");
        } finally {
            btn.disabled = false;
            label.textContent = 'Download Full Export';
        }
    }
</script>
