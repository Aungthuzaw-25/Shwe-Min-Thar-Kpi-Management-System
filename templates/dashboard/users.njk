{% extends "layouts/base.njk" %}
{% set active_page = "users" %}

{% block title %}Users Management - KPI Dashboard{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/avatar.css">
<link rel="stylesheet" href="/static/css/departed-records.css">
<link rel="stylesheet" href="/static/css/download-upload-style.css">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out forwards;
    }
    .modal-transition {
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
</style>

<!-- HEADER SECTION -->
<header class="workspace-header px-4 sm:px-6 md:px-8 !pb-4">
    <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-blue-950 tracking-tight">User Management</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 sm:mt-1.5 font-medium">Manage your team members and their account permissions here.</p>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 font-semibold">All users <span id="allUsersNumber">0</span></p>
    </div>
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center w-full md:w-auto gap-3 sm:space-x-4">
        <!-- Search Bar -->
        <div class="relative group w-full sm:w-auto">
            <label for="searchInput" class="sr-only">Search users</label>
            <input type="text" id="searchInput" placeholder="Search users..."
                   class="pl-4 pr-10 py-2.5 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 w-full sm:w-64 md:w-72 shadow-sm transition-all text-slate-700 font-medium">
            <svg class="w-5 h-5 text-gray-400 absolute right-3 top-2.5 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
        <!-- Filters Button -->
        <button onclick="toggleUserFilters()" class="w-full sm:w-auto justify-center bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 px-4 py-2.5 rounded-xl text-sm font-bold flex items-center transition-colors shadow-sm shrink-0">
            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            Filters
        </button>
        <!-- Add User Button (hidden when the viewer's users.create is denied; fails open when no permission map is present) -->
        {% set canCreateUsers = permission_map['users.create'] if permission_map is defined and permission_map['users.create'] is defined else true %}
        {% if canCreateUsers %}
        <button onclick="openUserModal()" class="w-full sm:w-auto justify-center bg-blue-950 hover:bg-blue-900 text-white px-5 py-2.5 rounded-xl text-sm font-bold flex items-center transition-all shadow-md transform hover:-translate-y-0.5 shrink-0">
            <svg class="w-5 h-5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            Add user
        </button>
        {% endif %}
    </div>
</header>

<!-- FILTERS PANEL (client-side only; no new API) -->
<div id="userFiltersPanel" class="hidden mx-4 sm:mx-6 md:mx-8 mb-2 bg-white border border-gray-200 rounded-xl p-3 sm:p-4 flex flex-col sm:flex-row gap-3 sm:items-end shadow-sm">
    <label class="text-xs font-bold text-slate-600 flex flex-col gap-1">Role
        <select id="userFilterRole" onchange="applyUserFilters()" class="border border-gray-200 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 bg-white">
            <option value="">All roles</option>
        </select>
    </label>
    <label class="text-xs font-bold text-slate-600 flex flex-col gap-1">Presence
        <select id="userFilterPresence" onchange="applyUserFilters()" class="border border-gray-200 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 bg-white">
            <option value="">All presence</option>
            <option value="online">Online</option>
            <option value="offline">Offline</option>
        </select>
    </label>
    <button onclick="clearUserFilters()" class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-lg text-xs font-bold transition-colors shadow-sm">Clear filters</button>
</div>

<!-- TABS SECTION -->
<div class="workspace-toolbar mx-4 sm:mx-6 md:mx-8 !px-3 !py-2 !items-center">
    <div class="workspace-tabs w-full sm:w-auto">
        <button onclick="switchTab('active')" id="activeTabBtn" class="whitespace-nowrap pb-2 sm:pb-3 text-sm font-bold text-blue-950 border-b-2 border-blue-950 transition-all duration-300">
            Active Users
        </button>
        <button onclick="switchTab('deleted')" id="deletedTabBtn" class="whitespace-nowrap pb-2 sm:pb-3 text-sm font-semibold text-slate-500 hover:text-blue-950 border-b-2 border-transparent transition-all duration-300">
            Deleted Users (Trash)
        </button>
    </div>
    
    <div class="pb-2 sm:pb-3 w-full sm:w-auto flex justify-end">
        <button onclick="refreshCurrentTab()" class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-lg text-xs font-bold flex items-center transition-colors shadow-sm focus:outline-none">
            <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            Refresh List
        </button>
    </div>
</div>

<!-- USERS TABLE SECTION -->
<div class="flex-1 p-4 sm:p-6 md:p-8 min-h-0 flex flex-col relative bg-slate-50 animate-fade-in-up">
    <div class="workspace-table flex-1 flex flex-col min-h-0 overflow-hidden">
        <div class="overflow-y-auto overflow-x-auto custom-scrollbar flex-1 min-h-0 w-full">
            <table class="w-full text-xs sm:text-sm text-left min-w-[900px]">
                <thead class="text-[10px] sm:text-xs text-slate-500 uppercase tracking-wider bg-slate-50 border-b border-gray-100 sticky top-0 z-10 shadow-sm">
                    <tr>
                        <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold w-10"><input type="checkbox" id="selectAllUsers" onchange="toggleSelectAllUsers(this)" aria-label="Select all users on this page"></th>
                        <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold">User</th>
                        <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold">Access</th>
                        <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold">Last active</th>
                        <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold">Date added</th>
                        <th class="px-4 sm:px-6 py-3 sm:py-4 font-bold text-right"></th>
                    </tr>
                </thead>
                <tbody id="usersTableBody" class="divide-y divide-gray-50 bg-white">
                    <tr>
                        <td colspan="6" class="px-6 py-16 text-center text-slate-500 flex flex-col items-center justify-center bg-white">
                            <svg class="animate-spin h-8 w-8 text-blue-900 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span class="font-medium text-sm">Loading user data...</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="usersPaginationBar" class="mt-3 flex flex-col sm:flex-row items-center justify-between gap-2">
            <p id="usersShowingText" class="text-xs sm:text-sm text-slate-500 font-medium"></p>
            <div id="usersPagination" class="flex items-center gap-1 flex-wrap justify-center"></div>
        </div>
    </div>
</div>

<!-- DEPARTED EMPLOYEE RECORDS HUB -->
{% if user_role == "Super Admin" %}
<section id="depHub" data-sa="1" class="mx-4 sm:mx-6 md:mx-8 mb-6 sm:mb-8 bg-slate-50/80 border border-slate-200 rounded-3xl p-4 sm:p-6 md:p-8 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-5">
        <div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-blue-950 tracking-tight">Departed Employee Records</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">Everything about employees who left: their kept records, report downloads, year-end status, and Relink. Records, tasks and audit history are never removed — only the account row goes.</p>
        </div>
        <div class="flex flex-col gap-2 shrink-0">
            <a href="/superadmin/permissions#download-permission-section" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm font-bold text-blue-900 hover:bg-blue-50 shadow-sm text-center">Download permission စီမံရန် →</a>
            <a href="/system-settings" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm font-bold text-blue-900 hover:bg-blue-50 shadow-sm text-center">Audit retention ဆက်တင် →</a>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-4 sm:p-6 mb-5">
        <h3 class="text-base sm:text-lg font-extrabold text-blue-950 mb-4">Departed list</h3>
        <div id="depDepartedList">
            <p class="text-xs sm:text-sm text-slate-500 font-medium">Loading departed list…</p>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-4 sm:p-6 mb-5">
        <h3 class="text-base sm:text-lg font-extrabold text-blue-950 mb-4">Report downloads</h3>
        {% include "dashboard/departed_download_form.njk" %}
    </div>

    <div class="bg-white border border-slate-200 rounded-3xl p-4 sm:p-6 mb-5">
        <h3 class="text-base sm:text-lg font-extrabold text-blue-950 mb-1">Per-year status &amp; year-end removal</h3>
        <p class="text-xs sm:text-sm text-slate-500 font-medium mb-4">Permanent removal unlocks only when the leaving year has ended AND the company-wide full-year report was downloaded AND the backup was confirmed.</p>
        <div class="flex flex-wrap items-center gap-3 mb-4">
            <label for="depLockYear" class="text-[11px] sm:text-xs font-bold text-slate-700 uppercase tracking-wide">Year</label>
            <select id="depLockYear" class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm font-semibold"></select>
            <button type="button" id="depLockRefresh" class="px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm font-bold text-slate-700 hover:bg-slate-50">Refresh</button>
            <button type="button" id="depBackupBtn" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs sm:text-sm font-bold shadow-sm">Confirm backup done</button>
        </div>
        <div id="depLockGates" class="space-y-1.5 mb-3">
            <p class="text-xs sm:text-sm text-slate-500 font-medium">Loading year status…</p>
        </div>
        <div id="depLockBanner" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-xs sm:text-sm font-bold text-slate-600">Loading…</div>
        <p id="depReminderLine" class="text-[11px] sm:text-xs text-slate-500 font-medium mt-3"></p>
        <button type="button" id="depGoTrash" class="mt-4 px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm font-bold text-blue-900 hover:bg-blue-50">Go to Deleted Users (Trash) →</button>
    </div>

    <div id="depRelinkPanel" class="hidden bg-white border border-slate-200 rounded-3xl p-4 sm:p-6 mb-5"></div>

    <div class="rounded-2xl border border-blue-100 bg-blue-50 px-4 py-3 text-xs sm:text-sm font-medium text-blue-900 leading-relaxed">
        <span class="font-extrabold">Restore (same-year returnees):</span> use Restore in the Deleted Users (Trash) tab — the account returns to ACTIVE and its records reconnect automatically. The department-head role and old sessions are NOT restored.
    </div>
</section>
{% else %}
<div id="depDownloadBlock" class="hidden mx-4 sm:mx-6 md:mx-8 mb-6 sm:mb-8 bg-white border border-slate-200 rounded-3xl p-4 sm:p-6 md:p-8 shadow-sm">
    <h2 class="text-xl sm:text-2xl font-extrabold text-blue-950 tracking-tight mb-1">Report downloads</h2>
    <p class="text-xs sm:text-sm text-slate-500 font-medium mb-4">Your download grant decides what you can download — nothing else does.</p>
    {% include "dashboard/departed_download_form.njk" %}
</div>
{% endif %}

<!-- OFFBOARD MODAL -->
<div id="offboardModal" class="fixed inset-0 z-[70] hidden flex items-center justify-center bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0 p-2 sm:p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg mx-auto overflow-hidden flex flex-col max-h-[95vh] sm:max-h-[90vh]">
        <div class="px-5 sm:px-8 py-4 sm:py-5 border-b border-gray-100 flex justify-between items-center bg-slate-50 shrink-0">
            <div>
                <h3 class="text-lg sm:text-xl font-extrabold text-blue-950 tracking-tight">Offboard employee</h3>
                <p class="text-[10px] sm:text-xs text-slate-500 mt-0.5 sm:mt-1 font-medium">For <span id="offboardUserName" class="font-bold text-slate-700"></span></p>
            </div>
            <button onclick="closeOffboardModal()" class="text-slate-400 hover:text-red-500 bg-white border border-gray-200 p-1.5 sm:p-2 rounded-xl focus:outline-none transition-colors shadow-sm shrink-0 ml-2">✕</button>
        </div>
        <div class="px-5 sm:px-8 py-5 sm:py-6 overflow-y-auto flex-1 bg-white space-y-4">
            <input type="hidden" id="offboardUserId">
            <div>
                <label for="offboardStatus" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Departure type</label>
                <select id="offboardStatus" class="w-full px-3 sm:px-4 py-2.5 bg-slate-50 border border-gray-200 rounded-xl text-xs sm:text-sm font-semibold">
                    <option value="RESIGNED">Resigned</option>
                    <option value="TERMINATED">Terminated</option>
                    <option value="SUSPENDED">Suspended (pause only)</option>
                </select>
            </div>
            <div>
                <label for="offboardDate" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Leaving date</label>
                <input type="date" id="offboardDate" class="w-full px-3 sm:px-4 py-2.5 bg-slate-50 border border-gray-200 rounded-xl text-xs sm:text-sm font-semibold">
            </div>
            <div>
                <label for="offboardReason" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Reason (optional)</label>
                <textarea id="offboardReason" rows="2" maxlength="500" class="w-full px-3 sm:px-4 py-2.5 bg-slate-50 border border-gray-200 rounded-xl text-xs sm:text-sm font-semibold" placeholder="Recorded in the audit log"></textarea>
            </div>
            <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs sm:text-sm font-medium text-amber-800 leading-relaxed">
                What happens for Resigned / Terminated: login stops immediately and sessions are revoked, the account moves to trash, the leaving date is stamped onto kept KPI records and tasks (“Resigned · date”), any download grants end, and the department-head seat is freed. KPI records, tasks and audit history are kept. Suspended only pauses the account — nothing moves to trash.
            </div>
        </div>
        <div class="px-5 sm:px-8 py-4 border-t border-gray-100 bg-slate-50 flex justify-end gap-2 shrink-0">
            <button onclick="closeOffboardModal()" class="px-5 py-2.5 rounded-xl bg-white border border-gray-200 text-xs sm:text-sm font-bold text-slate-600 hover:bg-slate-50">Cancel</button>
            <button onclick="submitOffboard()" class="px-5 py-2.5 rounded-xl bg-blue-950 hover:bg-blue-900 text-white text-xs sm:text-sm font-bold shadow-md">Offboard</button>
        </div>
    </div>
</div>

<!-- CREATE / EDIT USER MODAL -->
<div id="userModal" class="fixed inset-0 z-[70] hidden flex items-center justify-center bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0 modal-transition p-2 sm:p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl mx-auto overflow-hidden flex flex-col max-h-[95vh] sm:max-h-[90vh] transform scale-95 transition-transform duration-300" id="userModalContent">
        
        <div class="px-5 sm:px-8 py-4 sm:py-5 border-b border-gray-100 flex justify-between items-center bg-slate-50 shrink-0">
            <div>
                <h3 id="modalTitle" class="text-lg sm:text-xl font-extrabold text-blue-950 tracking-tight">Add New User</h3>
                <p class="text-[10px] sm:text-xs text-slate-500 mt-0.5 sm:mt-1 font-medium">Enter user details and configure access permissions.</p>
            </div>
            <button onclick="closeUserModal()" class="text-slate-400 hover:text-red-500 bg-white border border-gray-200 p-1.5 sm:p-2 rounded-xl focus:outline-none transition-colors shadow-sm shrink-0 ml-2">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
        
        <div class="px-5 sm:px-8 py-5 sm:py-6 overflow-y-auto custom-scrollbar flex-1 bg-white">
            <form id="userForm" class="space-y-4 sm:space-y-6">
                <input type="hidden" id="userId">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                    <div>
                        <label for="firstName" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">First Name <span class="text-red-500">*</span></label>
                        <input type="text" id="firstName" required class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold transition-all shadow-inner">
                    </div>
                    <div>
                        <label for="lastName" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Last Name <span class="text-red-500">*</span></label>
                        <input type="text" id="lastName" required class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold transition-all shadow-inner">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
                    <div>
                        <label for="userEmail" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Email Address <span class="text-red-500">*</span></label>
                        <input type="email" id="userEmail" required class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold transition-all shadow-inner">
                    </div>
                    <div>
                        <label for="userDepartment" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Department</label>
                        <select id="userDepartment" onchange="onDepartmentChange()" class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold cursor-pointer transition-all shadow-inner appearance-none">
                            <option value="">-- Select Department --</option>
                        </select>
                    </div>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
                    <div>
                        <label for="userPosition" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Position / Title</label>
                        <select id="userPosition" class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold cursor-pointer transition-all shadow-inner appearance-none">
                            <option value="">-- Select Department First --</option>
                        </select>
                    </div>
                    <div>
                        <label for="userRole" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">System Role <span class="text-red-500">*</span></label>
                        <select id="userRole" required class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold cursor-pointer transition-all shadow-inner appearance-none">
                            <option value="">-- Select Role --</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-1 gap-4 sm:gap-6 mb-4 sm:mb-6">
                    <div>
                        <label for="userRegionTown" class="block text-[11px] sm:text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Region / Town</label>
                        <input type="text" id="userRegionTown" class="w-full px-3 sm:px-4 py-2.5 sm:py-3 bg-slate-50 hover:bg-white border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-900 text-xs sm:text-sm font-semibold transition-all shadow-inner" placeholder="e.g. YGN Office">
                    </div>
                </div>

                <div id="passwordContainer" class="hidden bg-blue-50/50 p-4 sm:p-5 rounded-2xl border border-blue-100 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-blue-100 opacity-50">
                        <svg class="w-16 h-16 sm:w-24 sm:h-24" fill="currentColor" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                    
                    <div class="relative z-10">
                        <label for="userPassword" class="block text-[10px] sm:text-xs font-extrabold text-blue-900 mb-2 uppercase tracking-wide">Temporary Password <span class="text-red-500">*</span></label>
                        <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-3">
                            <input type="text" id="userPassword" class="flex-1 px-3 sm:px-4 py-2.5 sm:py-3 border border-blue-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 text-xs sm:text-sm transition-all font-mono font-bold bg-white shadow-sm" placeholder="Type password or auto-generate">
                            <button type="button" onclick="generateRandomPassword()" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-4 sm:px-5 py-2.5 sm:py-3 rounded-xl text-xs sm:text-sm font-bold transition-colors shadow-sm whitespace-nowrap flex items-center justify-center focus:outline-none">
                                <svg class="w-4 h-4 mr-1.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                Auto Generate
                            </button>
                        </div>
                        <p class="text-[9px] sm:text-xs font-medium text-blue-700 mt-2 sm:mt-2.5 flex items-center">
                            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            User will be forced to change this password upon first login.
