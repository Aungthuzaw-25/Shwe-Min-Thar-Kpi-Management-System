            <button type="button" onclick="confirmResetPassword()" class="w-full sm:w-auto px-4 sm:px-5 py-2.5 bg-amber-600 rounded-xl text-xs sm:text-sm font-bold text-white hover:bg-amber-700 shadow-md transition-all transform hover:-translate-y-0.5 focus:outline-none flex justify-center">Force Reset</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/departed-records.js"></script>
<script>
    'use strict';

    let allUsers = [];
    let currentTab = 'active';
    const pendingUserMutations = new Set();

    // 🌟 SECURITY FIX: Global HTML Escape Function to prevent XSS
    function escapeHTML(str) {
        if (str === null || str === undefined) return "";
        return str.toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    // 🌟 RESPONSIVE & UX FIX: Toast styling matching enterprise
    function showToast(message, type = 'success') {
        let container = document.getElementById('toastContainer');
        if(!container) {
            container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'fixed top-5 right-5 z-[9999] flex flex-col gap-2 max-w-[90%] sm:max-w-md w-full items-end';
            document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        const config = type === 'success' ? 'bg-emerald-50 text-emerald-900 border-emerald-500' : 'bg-red-50 text-red-900 border-red-500';
        const icon = type === 'success' 
            ? `<svg class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-500 mr-2 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
            : `<svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-500 mr-2 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

        toast.className = `flex items-center px-4 py-3 sm:px-5 sm:py-4 rounded-xl shadow-lg border-l-4 ${config} text-xs sm:text-sm font-bold mb-3 animate-fade-in-up w-full bg-white`;
        toast.innerHTML = icon + `<div>${escapeHTML(message)}</div>`;
        
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 4500);
    }

    function toggleModal(modalId, contentId, show) {
        const modal = document.getElementById(modalId);
        const content = document.getElementById(contentId);
        if (show) {
            modal.classList.remove('hidden');
            void modal.offsetWidth;
            modal.classList.remove('opacity-0');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        } else {
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }
    }

    function createSecurePassword() {
        const cryptoApi = window.crypto;
        if (!cryptoApi || typeof cryptoApi.getRandomValues !== 'function') {
            showToast("Secure password generation is unavailable in this browser. Enter a password manually.", "error");
            return null;
        }

        const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        const acceptanceLimit = Math.floor(256 / alphabet.length) * alphabet.length;
        const randomValues = new Uint8Array(16);
        let randomPart = "";
        try {
            while (randomPart.length < 8) {
                cryptoApi.getRandomValues(randomValues);
                for (const value of randomValues) {
                    if (value < acceptanceLimit) {
                        randomPart += alphabet[value % alphabet.length];
                        if (randomPart.length === 8) break;
                    }
                }
            }
        } catch {
            showToast("Secure password generation is unavailable. Enter a password manually.", "error");
            return null;
        }
        return randomPart + "Kpi@1!";
    }

    function generateRandomPassword() {
        const randomPass = createSecurePassword();
        if (randomPass) document.getElementById('userPassword').value = randomPass;
    }

    document.addEventListener('DOMContentLoaded', () => {
        void (async () => {
            await fetchDropdownData();
            // Sidebar panel deep link: ?tab=deleted opens the trash tab.
            const initialTab = new URLSearchParams(window.location.search).get('tab');
            if (initialTab === 'deleted') {
                await switchTab('deleted');
            } else {
                await loadUsers();
            }

            document.getElementById('searchInput').addEventListener('input', function(e) {
                searchTerm = e.target.value;
                currentPage = 1;
                renderUsersTable();
            });
        })().catch(() => {
            showToast("Failed to initialize user management. Please refresh the page and try again.", "error");
        });
    });

    async function switchTab(tab) {
        currentTab = tab;
        const activeBtn = document.getElementById('activeTabBtn');
        const deletedBtn = document.getElementById('deletedTabBtn');
        resetUserTableState();

        const activeStyle = "whitespace-nowrap pb-2 sm:pb-3 text-sm font-bold text-blue-950 border-b-2 border-blue-950 transition-all duration-300";
        const inactiveStyle = "whitespace-nowrap pb-2 sm:pb-3 text-sm font-semibold text-slate-500 hover:text-blue-950 border-b-2 border-transparent transition-all duration-300";

        if (tab === 'active') {
            activeBtn.className = activeStyle;
            deletedBtn.className = inactiveStyle;
            await loadUsers();
        } else {
            deletedBtn.className = "whitespace-nowrap pb-2 sm:pb-3 text-sm font-bold text-red-700 border-b-2 border-red-700 transition-all duration-300";
            activeBtn.className = inactiveStyle;
            await loadDeletedUsers();
        }
    }

    async function refreshCurrentTab() {
        document.getElementById('searchInput').value = '';
        searchTerm = '';
        currentPage = 1;
        if (currentTab === 'active') {
            await loadUsers();
            showToast("Active users list refreshed.", "success");
        } else {
            await loadDeletedUsers();
            showToast("Deleted users trash refreshed.", "success");
        }
    }

    async function fetchDropdownData() {
        try {
            const roleRes = await fetch('/api/v1/users/roles/list');
            // 🛡️ AUTH FIX: Redirect on session expiry
            if (roleRes.status === 401 || roleRes.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (roleRes.ok) {
                const roles = await roleRes.json();
                document.getElementById('userRole').innerHTML = '<option value="">-- Select Role --</option>' + roles.map(r => `<option value="${r.id}">${escapeHTML(r.name)}</option>`).join('');
            }
            
            const deptRes = await fetch('/api/v1/departments/');
            if (deptRes.status === 401 || deptRes.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (deptRes.ok) {
                const depts = await deptRes.json();
                document.getElementById('userDepartment').innerHTML = '<option value="">-- Select Department --</option>' + depts.map(d => `<option value="${d.id}">${escapeHTML(d.name)}</option>`).join('');
            } else {
                showToast(await window.readServerError(deptRes), "error");
            }
        } catch (err) {
            showToast("Failed to load roles and departments data.", "error");
        }
    }

    async function onDepartmentChange(selectedPositionId = null) {
        const deptId = document.getElementById('userDepartment').value;
        const posSelect = document.getElementById('userPosition');
        
        posSelect.innerHTML = '<option value="">-- Select Position --</option>';
        if (!deptId) return;

        try {
            const res = await fetch(`/api/v1/positions/department/${deptId}`);
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) {
                const positions = await res.json();

                if (positions.length > 0) {
                    posSelect.innerHTML = '<option value="">-- Select Position --</option>' + positions.map(p => `<option value="${p.id}">${escapeHTML(p.name)}</option>`).join('');
                } else {
                    posSelect.innerHTML = '<option value="">-- No positions found --</option>';
                }

                if (selectedPositionId) {
                    posSelect.value = selectedPositionId;
                }
            } else {
                showToast(await window.readServerError(res), "error");
            }
        } catch (err) {
            showToast("Failed to load positions for this department.", "error");
        }
    }

    async function loadUsers() {
        try {
            const res = await fetchWithTimeout('/api/v1/users/?is_active=true');
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) {
                allUsers = await res.json();
                populateUserFilterRoles();
                renderUsersTable();
            } else {
                const reason = await window.readServerError(res);
                document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" class="px-6 py-12 text-center text-red-500 font-bold bg-white text-xs sm:text-sm">${escapeHTML(reason)}</td></tr>`;
                console.error('Failed to load active users', { status: res.status, api: '/api/v1/users/?is_active=true' });
            }
        } catch (error) {
            document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" class="px-6 py-12 text-center text-red-500 font-bold bg-white text-xs sm:text-sm">Network Error. Please check your connection.</td></tr>`;
        }
    }

    async function loadDeletedUsers() {
        try {
            const res = await fetchWithTimeout('/api/v1/users/deleted/list');
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) {
                allUsers = await res.json();
                populateUserFilterRoles();
                renderUsersTable();
            } else {
                const reason = await window.readServerError(res);
                document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" class="px-6 py-12 text-center text-red-500 font-bold bg-white text-xs sm:text-sm">${escapeHTML(reason)}</td></tr>`;
            }
        } catch (error) {
            document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" class="px-6 py-12 text-center text-red-500 font-bold bg-white text-xs sm:text-sm">Network Error.</td></tr>`;
        }
    }

    // 🌟 SECURITY FIX: Applied escapeHTML
    function formatUserDepartments(user) {
        if (!user.departments || user.departments.length === 0) {
            return `<span class="text-slate-400 text-[10px] sm:text-xs font-semibold italic bg-slate-50 px-2 sm:px-2.5 py-1 rounded-md border border-slate-100 whitespace-nowrap">No Department</span>`;
        }

        const deptNames = user.departments.map(d => escapeHTML(d.name));
        
        if (deptNames.length <= 2) {
            return `<span class="text-xs sm:text-sm text-slate-700 font-bold whitespace-nowrap">${deptNames.join(', ')}</span>`;
        } else {
            const firstTwo = deptNames.slice(0, 2).join(', ');
            const extraCount = deptNames.length - 2;
            return `
                <div class="flex items-center flex-wrap gap-1 sm:gap-2">
                    <span class="text-xs sm:text-sm text-slate-700 font-bold whitespace-nowrap">${firstTwo}</span>
                    <a href="/superadmin/users/${user.id}/profile" class="text-[9px] sm:text-[10px] bg-blue-100 text-blue-800 hover:text-white hover:bg-blue-700 font-extrabold px-1.5 sm:px-2 py-0.5 sm:py-1 rounded cursor-pointer transition-colors shadow-sm whitespace-nowrap">
                        +${extraCount} more
                    </a>
                </div>
            `;
        }
    }

    // Presence times arrive as UTC ISO strings; show them in the viewer's
    // local time in the same readable style as the other admin pages.
    function formatPresenceTime(value) {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    // Viewer permissions (U5): the web tier passes the effective permission
    // map; a null map (FastAPI-tier render) means "unknown" and every button
    // stays, as today — the API still enforces each action.
    const viewerPermissions = {{ permission_map | default(null) | tojson }};
    const viewerIsSuperAdmin = {% if user_role == "Super Admin" %}true{% else %}false{% endif %};
    function canPerm(key) {
        return !viewerPermissions || viewerPermissions[key] !== false;
    }

    // Users table format (Zenn, 2026-10-25): checkbox | User
    // (avatar + name + email) | Access (role + departments) |
    // Last active (presence dot + last_active_at) | Date added
    // (created_at) | row menu. Client-side paging over the loaded
    // list only — no new API. U4/U5 gating is unchanged: SA rows show
    // only View profile to non-SA viewers, and every mutation is
    // still enforced by the API.
    let currentPage = 1;
    const USERS_PAGE_SIZE = 10;
    let searchTerm = '';
    let filterRole = '';
    let filterPresence = '';
    let selectedUserIds = new Set();
    let lastShowing = { total: 0, from: 0, to: 0 };

    function formatDateOnly(value) {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function getVisibleUsers() {
        const term = searchTerm.trim().toLowerCase();
        return allUsers.filter(u => {
            if (term && !((u.first_name || '').toLowerCase().includes(term) ||
                (u.last_name || '').toLowerCase().includes(term) ||
                (u.email || '').toLowerCase().includes(term))) return false;
            if (filterRole && (!u.role || u.role.name !== filterRole)) return false;
            if (filterPresence && u.presence_status !== filterPresence) return false;
            return true;
        });
    }

    function toggleUserFilters() {
        document.getElementById('userFiltersPanel').classList.toggle('hidden');
    }

    function applyUserFilters() {
        filterRole = document.getElementById('userFilterRole').value;
        filterPresence = document.getElementById('userFilterPresence').value;
        currentPage = 1;
        renderUsersTable();
    }

    function clearUserFilters() {
        document.getElementById('userFilterRole').value = '';
        document.getElementById('userFilterPresence').value = '';
        filterRole = '';
        filterPresence = '';
        currentPage = 1;
        renderUsersTable();
    }

    function populateUserFilterRoles() {
        const select = document.getElementById('userFilterRole');
        const roles = [...new Set(allUsers.map(u => u.role && u.role.name).filter(Boolean))].sort();
        select.innerHTML = '<option value="">All roles</option>' +
            roles.map(r => `<option value="${escapeHTML(r)}">${escapeHTML(r)}</option>`).join('');
        if (filterRole && !roles.includes(filterRole)) { filterRole = ''; }
        select.value = filterRole;
    }

    function resetUserTableState() {
        searchTerm = '';
        filterRole = '';
        filterPresence = '';
        currentPage = 1;
        selectedUserIds = new Set();
        document.getElementById('searchInput').value = '';
        document.getElementById('userFilterRole').value = '';
        document.getElementById('userFilterPresence').value = '';
    }

    function goToUsersPage(page) {
        // The CSP event bridge only resolves quoted-string literals, so
        // page numbers arrive as strings — coerce them here.
        currentPage = Number(page) || 1;
        renderUsersTable();
    }

    function toggleUserSelection(checkbox) {
        const id = checkbox.dataset.userId;
        if (checkbox.checked) selectedUserIds.add(id); else selectedUserIds.delete(id);
        syncUserSelectionUI();
    }

    function toggleSelectAllUsers(checkbox) {
        document.querySelectorAll('.user-row-checkbox').forEach(cb => {
            cb.checked = checkbox.checked;
            if (checkbox.checked) selectedUserIds.add(cb.dataset.userId);
            else selectedUserIds.delete(cb.dataset.userId);
        });
        syncUserSelectionUI();
    }

    function syncUserSelectionUI() {
        const boxes = document.querySelectorAll('.user-row-checkbox');
        const selectAll = document.getElementById('selectAllUsers');
        if (selectAll) {
            selectAll.checked = boxes.length > 0 && [...boxes].every(cb => selectedUserIds.has(cb.dataset.userId));
        }
        const text = document.getElementById('usersShowingText');
        if (text) {
            text.textContent = lastShowing.total === 0
                ? 'No users to show.'
                : `Showing ${lastShowing.from}–${lastShowing.to} of ${lastShowing.total} users` +
                  (selectedUserIds.size ? ` · ${selectedUserIds.size} selected` : '');
        }
    }

    function renderUsersPagination(total) {
        const bar = document.getElementById('usersPagination');
        const totalPages = Math.max(1, Math.ceil(total / USERS_PAGE_SIZE));
        let pages = [];
        if (totalPages <= 7) {
            for (let p = 1; p <= totalPages; p++) pages.push(p);
        } else {
            pages = [1];
            if (currentPage > 3) pages.push('…');
            for (let p = Math.max(2, currentPage - 1); p <= Math.min(totalPages - 1, currentPage + 1); p++) pages.push(p);
            if (currentPage < totalPages - 2) pages.push('…');
            pages.push(totalPages);
        }
        const btnBase = 'px-3 py-1.5 rounded-lg text-xs font-bold border transition-colors';
        const prevNext = (label, page, disabled) =>
            `<button onclick="goToUsersPage('${page}')" ${disabled ? 'disabled' : ''} class="${btnBase} ${disabled ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100'}">${label}</button>`;
        bar.innerHTML = prevNext('Previous', currentPage - 1, currentPage === 1) +
            pages.map(p => p === '…'
                ? `<span class="px-1 text-slate-400 text-xs font-bold">…</span>`
                : `<button onclick="goToUsersPage('${p}')" class="${btnBase} ${p === currentPage ? 'bg-blue-950 text-white border-blue-950' : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100'}">${p}</button>`).join('') +
            prevNext('Next', currentPage + 1, currentPage === totalPages);
    }

    function toggleUserMenu(btn, menuId) {
        const menu = document.getElementById(menuId);
        const wasOpen = !menu.classList.contains('hidden');
        closeAllUserMenus();
        if (wasOpen) return;
        // Table rows carry an entrance animation whose final transform
        // would trap a fixed menu inside the row, so the menu lives on
        // <body> while it is open (fixed + hidden costs no layout).
        document.body.appendChild(menu);
        const rect = btn.getBoundingClientRect();
        menu.style.top = (rect.bottom + 4) + 'px';
        menu.style.right = (window.innerWidth - rect.right) + 'px';
        menu.classList.remove('hidden');
    }

    function closeAllUserMenus() {
        document.querySelectorAll('.user-row-menu').forEach(m => m.classList.add('hidden'));
    }

    document.addEventListener('click', (e) => {
        if (e.target.closest('[data-user-menu-btn]')) return;
        closeAllUserMenus();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAllUserMenus(); });
    document.addEventListener('scroll', closeAllUserMenus, true);

    function renderUsersTable() {
        const tbody = document.getElementById('usersTableBody');
        const visible = getVisibleUsers();
        const totalPages = Math.max(1, Math.ceil(visible.length / USERS_PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        const start = (currentPage - 1) * USERS_PAGE_SIZE;
        const pageUsers = visible.slice(start, start + USERS_PAGE_SIZE);
        document.getElementById('allUsersNumber').textContent = allUsers.length;
        lastShowing = { total: visible.length, from: visible.length ? start + 1 : 0, to: start + pageUsers.length };

        if (!visible.length) {
            const emptyText = currentTab === 'active' ? 'No active users found.' : 'No deleted users in trash.';
            tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-16 text-center text-slate-500 font-medium bg-white text-xs sm:text-sm">${emptyText}</td></tr>`;
            renderUsersPagination(0);
            syncUserSelectionUI();
            return;
        }

        // 🌟 SECURITY FIX: Applied escapeHTML() to user inputs and safe JSON Encoding for the Edit Button
        tbody.innerHTML = pageUsers.map((user) => {
            const roleName = user.role ? escapeHTML(user.role.name) : 'N/A';
            const isSuperAdmin = user.role && user.role.name === 'Super Admin';
            const isUserDeleted = currentTab === 'deleted';
            const fullName = `${escapeHTML(user.first_name)} ${escapeHTML(user.last_name)}`;

            const statusLine = isUserDeleted
                ? `<span class="mt-1 inline-block px-2 py-0.5 text-[10px] leading-4 font-bold rounded-md bg-red-100 text-red-800 border border-red-200">Deleted</span>`
                : (!user.is_active
                    ? `<span class="mt-1 inline-block px-2 py-0.5 text-[10px] leading-4 font-bold rounded-md bg-slate-200 text-slate-600 border border-slate-300">Inactive</span>`
                    : '');

            const presenceDot = user.presence_status === 'online'
                ? `<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0 inline-block"></span>`
                : (user.presence_status === 'offline'
                    ? `<span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0 inline-block"></span>`
                    : '');

            // 🌟 URL-Safe JSON Serialization
            const safeUserJSON = encodeURIComponent(JSON.stringify(user)).replaceAll("'", "%27");

            // Row menu items: same actions and same U4/U5 gates as the old
            // inline buttons — View is always there, Edit/Reset/Delete are
            // hidden on SA rows and when the viewer's permission is denied.
            let menuItems = `<a href="/superadmin/users/${user.id}/profile" class="block px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 rounded-lg">View profile</a>`;
            if (isUserDeleted) {
                // Restore + permanent delete are SA-only at the API, so
                // non-SA viewers get no menu at all in the trash tab (U5).
                menuItems = viewerIsSuperAdmin ? `
                    <button onclick="restoreUser('${user.id}')" class="block w-full text-left px-3 py-2 text-xs font-bold text-emerald-700 hover:bg-emerald-50 rounded-lg">Restore</button>
                    <button onclick="permanentDeleteUser('${user.id}')" class="block w-full text-left px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-50 rounded-lg">Delete permanently</button>` : '';
            } else {
                if (!isSuperAdmin && canPerm('users.edit')) {
                    menuItems += `<button onclick="editUser('${safeUserJSON}')" class="block w-full text-left px-3 py-2 text-xs font-bold text-blue-700 hover:bg-blue-50 rounded-lg">Edit</button>`;
                }
                if (!isSuperAdmin && canPerm('users.password_reset')) {
                    menuItems += `<button onclick="openResetModal('${user.id}')" class="block w-full text-left px-3 py-2 text-xs font-bold text-amber-700 hover:bg-amber-50 rounded-lg">Reset password</button>`;
                }
                if (!isSuperAdmin) {
                    menuItems += `<button onclick="openOffboardModal('${safeUserJSON}')" class="block w-full text-left px-3 py-2 text-xs font-bold text-amber-700 hover:bg-amber-50 rounded-lg">Offboard employee</button>`;
                }
                if (!isSuperAdmin && canPerm('users.delete')) {
                    menuItems += `<button onclick="deleteUser('${user.id}')" class="block w-full text-left px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-50 rounded-lg">Delete</button>`;
                }
            }
            const menuButton = menuItems ? `
                <button data-user-menu-btn onclick="toggleUserMenu(this, 'userMenu-${user.id}')" class="p-1.5 sm:p-2 text-slate-500 hover:bg-slate-100 rounded-xl transition-colors" aria-label="Row actions">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
                </button>
                <div id="userMenu-${user.id}" class="user-row-menu hidden fixed z-[80] w-44 bg-white border border-gray-200 rounded-xl shadow-lg py-1">${menuItems}</div>` : '';

            return `
                <tr class="hover:bg-blue-50/30 transition-colors group ${isUserDeleted ? 'opacity-80 bg-red-50/30' : 'bg-white'} animate-fade-in-up">
                    <td class="px-4 sm:px-6 py-4 sm:py-5 w-10">
                        <input type="checkbox" class="user-row-checkbox" data-user-id="${user.id}" ${selectedUserIds.has(user.id) ? 'checked' : ''} onchange="toggleUserSelection(this)" aria-label="Select ${fullName}">
                    </td>
                    <td class="px-4 sm:px-6 py-4 sm:py-5 min-w-[220px]">
                        <div class="flex items-center">
                            <span class="mr-3 sm:mr-4">${window.kpiAvatarMarkup(user, 40)}</span>
                            <div class="min-w-0 pr-2">
                                <div class="font-extrabold ${isUserDeleted ? 'text-slate-500 line-through' : 'text-blue-950'} text-sm sm:text-base truncate">${fullName}</div>
                                <div class="text-xs sm:text-sm text-slate-500 font-medium truncate" title="${escapeHTML(user.email)}">${escapeHTML(user.email)}</div>
                                ${statusLine}
                            </div>
                        </div>
                    </td>
                    <td class="px-4 sm:px-6 py-4 sm:py-5 min-w-[150px]">
                        <div class="flex flex-wrap items-center gap-1.5">
                            <span class="px-2.5 sm:px-3 py-1 inline-flex text-[10px] sm:text-xs leading-5 font-extrabold rounded-lg bg-blue-50 text-blue-800 border border-blue-200 shadow-sm">${roleName}</span>
                            ${formatUserDepartments(user)}
                        </div>
                    </td>
                    <td class="px-4 sm:px-6 py-4 sm:py-5 whitespace-nowrap text-slate-600 font-medium text-xs sm:text-sm">
                        <span class="inline-flex items-center gap-1.5">${presenceDot}${formatPresenceTime(user.last_active_at)}</span>
                    </td>
                    <td class="px-4 sm:px-6 py-4 sm:py-5 whitespace-nowrap text-slate-600 font-medium text-xs sm:text-sm">${formatDateOnly(user.created_at)}</td>
                    <td class="px-4 sm:px-6 py-4 sm:py-5 text-right">
                        <div class="relative inline-block">${menuButton}</div>
                    </td>
                </tr>
            `;
        }).join('');
        renderUsersPagination(visible.length);
        syncUserSelectionUI();
    }

    async function openUserModal() {
        document.getElementById('userForm').reset();
        document.getElementById('userId').value = '';
        document.getElementById('modalTitle').innerText = 'Add New User';
        document.getElementById('passwordContainer').classList.remove('hidden');
        document.getElementById('userPassword').value = ''; 
        document.getElementById('userPosition').innerHTML = '<option value="">-- Select Department First --</option>';
        toggleModal('userModal', 'userModalContent', true);
    }

    function closeUserModal() {
        toggleModal('userModal', 'userModalContent', false);
    }

    async function editUser(encodedUserJSON) {
        const user = JSON.parse(decodeURIComponent(encodedUserJSON));
        
        document.getElementById('userId').value = user.id;
        document.getElementById('firstName').value = user.first_name || '';
        document.getElementById('lastName').value = user.last_name || '';
        document.getElementById('userEmail').value = user.email || '';
        
        if (user.departments && user.departments.length > 0) {
            document.getElementById('userDepartment').value = user.departments[0].id;
            await onDepartmentChange(user.position ? user.position.id : '');
        } else {
            document.getElementById('userDepartment').value = '';
            document.getElementById('userPosition').innerHTML = '<option value="">-- Select Department First --</option>';
        }
        
        document.getElementById('userRegionTown').value = user.region_town || ''; 
        document.getElementById('userRole').value = user.role ? user.role.id : ''; 
        document.getElementById('userActive').checked = user.is_active;
        
        document.getElementById('modalTitle').innerText = 'Edit User Identity';
        document.getElementById('passwordContainer').classList.add('hidden'); 
        toggleModal('userModal', 'userModalContent', true);
    }

    async function saveUser() {
        const id = document.getElementById('userId').value;
        const isEdit = !!id;
        const form = document.getElementById('userForm');
        
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const btn = document.getElementById('saveBtn');
        const originalText = btn.innerHTML;
        btn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Saving...`;
        btn.disabled = true;

        const payload = {
            first_name: document.getElementById('firstName').value,
            last_name: document.getElementById('lastName').value,
            email: document.getElementById('userEmail').value,
            department_id: document.getElementById('userDepartment').value || null, 
            position_id: document.getElementById('userPosition').value || null,
            region_town: document.getElementById('userRegionTown').value || null, 
            role_id: document.getElementById('userRole').value,
            is_active: document.getElementById('userActive').checked
        };

        const url = isEdit ? `/api/v1/users/${id}` : '/api/v1/users/';
        const method = isEdit ? 'PUT' : 'POST';

        if (!isEdit) {
            const providedPassword = document.getElementById('userPassword').value;
            if (!providedPassword) {
                showToast("Please provide or auto-generate a temporary password.", "error");
                btn.innerHTML = originalText;
                btn.disabled = false;
                return;
            }
            payload.password = providedPassword;
        }

        try {
            const res = await fetch(url, {
                method: method,
                headers: method === 'POST'
                    ? SubmitKey.headers('user-create', { 'Content-Type': 'application/json' })
                    : { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            
            // 🛡️ AUTH FIX
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) {
                const savedData = await res.json();
                if (!isEdit) SubmitKey.clear('user-create');
                if (window.__userDraft) window.__userDraft.clear();
                closeUserModal();
                if (isEdit) {
                    const editedName = `${payload.first_name} ${payload.last_name}`.trim() || 'User';
                    const profileId = (savedData && savedData.id) ? savedData.id : id;
                    showToast(`${editedName} details updated`, "success", 4500, { actions: [{ label: "View profile", href: `/superadmin/users/${profileId}/profile` }] });
                } else {
                    showToast("User created successfully. The user must set a password before signing in.", "success");
                }
                await loadUsers();
            } else if (!isEdit && res.status === 409) {
                showToast("Still saving — wait a moment and check the list before retrying.", "error");
            } else {
                if (!isEdit && res.status === 422) SubmitKey.clear('user-create');
                showToast(await window.readServerError(res), "error");
            }
        } catch (error) {
            showToast("Connection failed — the user may not have been saved. Check the list, then retry (retrying is safe).", "error");
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

    // Error toast for delete/restore/permanent-delete: read the body as
    // text first, because a proxy/server failure (502 HTML, empty body)
    // is not JSON — res.json() would throw and the real reason would be
    // misreported as a network error. A server answer is shown as-is;
    // "Network error" is reserved for fetch itself throwing.
    async function readServerError(res) {
        try {
            const text = await res.text();
            if (text) {
                try {
                    const err = JSON.parse(text);
                    if (err && err.detail) return `Error: ${err.detail}`;
                } catch (e) { /* not JSON — fall through to status */ }
            }
        } catch (e) { /* unreadable body — fall through to status */ }
        return `Server error (${res.status})`;
    }

    async function deleteUser(id) {
        if (!(await window.appConfirm("Are you sure you want to disable and move this user to trash?", { title: "Disable user?" }))) return;
        if (pendingUserMutations.has(id)) return;
        pendingUserMutations.add(id);
        try {
            const res = await fetch(`/api/v1/users/${id}`, { method: 'DELETE' });
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) { showToast("User disabled and moved to trash.", "success"); await loadUsers(); }
            else { showToast(await readServerError(res), "error"); }
        } catch (err) { showToast("Network error while deleting user.", "error"); }
        finally { pendingUserMutations.delete(id); }
    }

    async function restoreUser(id) {
        if (!(await window.appConfirm("Are you sure you want to restore and activate this deleted account?", { title: "Restore user?" }))) return;
        try {
            const res = await fetch(`/api/v1/users/${id}/restore`, { method: 'POST', headers: { 'Content-Type': 'application/json' }});
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) { showToast("User restored and activated successfully.", "success"); await loadDeletedUsers(); }
            else { showToast(await readServerError(res), "error"); }
        } catch (err) { showToast("Network error while restoring user.", "error"); }
    }

    async function permanentDeleteUser(id) {
        if (!(await window.appConfirm("This will permanently delete the user and cannot be undone.", { title: "Delete user?", warning: "Choose Delete only if you are certain." , confirmText: "Delete" }))) return;
        try {
            const res = await fetch(`/api/v1/users/${id}/permanent`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }});
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            
            if (res.ok) { showToast("User permanently deleted from database.", "success"); await loadDeletedUsers(); }
            else { showToast(await readServerError(res), "error"); }
        } catch (err) { showToast("Network error while permanently deleting user.", "error"); }
    }

    function openResetModal(userId) {
        document.getElementById('resetUserId').value = userId;
        const password = createSecurePassword();
        if (!password) return;
        document.getElementById('newPasswordInput').value = password;
        toggleModal('resetPasswordModal', 'resetModalContent', true);
    }

    function closeResetModal() { toggleModal('resetPasswordModal', 'resetModalContent', false); }

    async function confirmResetPassword() {
        const id = document.getElementById('resetUserId').value;
        const newPassword = document.getElementById('newPasswordInput').value;
        if (!newPassword) return showToast("Password cannot be empty", "error");

        try {
            const res = await fetch(`/api/v1/users/${id}/reset-password`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ new_password: newPassword })
            });

            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }

            if (res.ok) {
                showToast(`Password reset successful!\nNew Password: ${newPassword}`, "success");
                closeResetModal();
            } else {
                showToast(await window.readServerError(res), "error");
            }
        } catch (err) { showToast("Network error while resetting password.", "error"); }
    }
</script>
<script>
    // Draft safety: autosave the user form (password fields are never saved).
    document.addEventListener('DOMContentLoaded', function () {
        if (!window.FormDraft) return;
        var userFormEl = document.getElementById('userForm');
        if (userFormEl) window.__userDraft = FormDraft.attach(userFormEl, {
            key: function () {
                var idEl = document.getElementById('userId');
                return 'user-form:' + (idEl && idEl.value ? idEl.value : 'new');
            }
        });
    });
</script>
{% endblock %}