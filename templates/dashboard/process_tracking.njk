{% extends "layouts/base.njk" %}
{% set active_page = "process_tracking" %}

{% block title %}Process Tracking - Enterprise Core{% endblock %}

{% block content %}
<link rel="stylesheet" href="/static/css/avatar.css">
<script src="/static/js/avatar-renderer.js"></script>
<script src="/static/js/avatar.js"></script>
<style>
    @keyframes fadeSlideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-slide { animation: fadeSlideUp 0.4s ease-out forwards; }
    .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
</style>

<div class="workspace-page min-h-full flex flex-col overflow-x-hidden">

    <!-- HEADER -->
    <header class="app-page-header animate-fade-slide">
        <div class="w-full md:w-auto">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Process Tracking</h1>
            <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">Monitor and track all your processes in real-time</p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
            <div class="flex bg-white border border-slate-200 rounded-xl p-1 shadow-sm w-full sm:w-auto">
                <label for="scopeSelector" class="sr-only">Tracking scope</label>
                <select id="scopeSelector" onchange="switchScope(this.value)" class="flex-1 sm:flex-none bg-transparent pl-3 pr-8 py-2 sm:py-1.5 text-xs sm:text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer border-r border-slate-100">
                    <option value="department">By Department</option>
                    <option value="user">By User</option>
                </select>
                <label for="realTargetDropdown" class="sr-only">Select tracking target</label>
                <select id="realTargetDropdown" onchange="loadRealTrackingData()" class="flex-1 sm:flex-none bg-transparent pl-3 pr-8 py-2 sm:py-1.5 text-xs sm:text-sm font-semibold text-slate-700 focus:outline-none cursor-pointer max-w-full sm:max-w-[180px] truncate">
                    <option value="">-- Select Target --</option>
                </select>
            </div>
            
        </div>
    </header>

    <!-- TOP METRICS CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-6 animate-fade-slide csp-delay-2">
        <!-- Total Processes -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
            <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <div class="flex-1 ml-4">
                <p class="text-[11px] sm:text-xs font-bold text-slate-500 mb-0.5">Total Processes</p>
                <div class="flex items-baseline gap-2">
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 leading-none" id="statTotal">0</h3>
                </div>
            </div>
        </div>
        
        <!-- Completed -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-500 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div class="flex-1 ml-4">
                <p class="text-[11px] sm:text-xs font-bold text-slate-500 mb-0.5">Completed</p>
                <div class="flex items-baseline gap-2">
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 leading-none" id="statCompleted">0</h3>
                </div>
            </div>
        </div>

        <!-- In Progress -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
            <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-orange-500 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div class="flex-1 ml-4">
                <p class="text-[11px] sm:text-xs font-bold text-slate-500 mb-0.5">In Progress</p>
                <div class="flex items-baseline gap-2">
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 leading-none" id="statInProgress">0</h3>
                </div>
            </div>
        </div>

        <!-- On Hold / Drafts -->
        <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
            <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div class="flex-1 ml-4">
                <p class="text-[11px] sm:text-xs font-bold text-slate-500 mb-0.5">On Hold / Drafts</p>
                <div class="flex items-baseline gap-2">
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 leading-none" id="statDraft">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- MIDDLE SECTION: CHARTS -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6 animate-fade-slide csp-delay-3">
        <!-- Line Chart (Currently acts as a placeholder) -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 flex flex-col min-h-[350px]">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-sm font-bold text-slate-900">Process Progress Overview</h3>
            </div>
            <div class="flex flex-wrap items-center gap-4 sm:gap-6 mb-4 text-[10px] sm:text-[11px] font-bold text-slate-600 justify-center">
                <div class="flex items-center gap-1.5"><span class="w-3 h-1 rounded bg-emerald-500"></span> Completed</div>
                <div class="flex items-center gap-1.5"><span class="w-3 h-1 rounded bg-blue-500"></span> In Progress</div>
                <div class="flex items-center gap-1.5"><span class="w-3 h-1 rounded bg-orange-500"></span> On Hold</div>
                <div class="flex items-center gap-1.5"><span class="w-3 h-1 rounded bg-rose-500"></span> Failed</div>
            </div>
            <div class="flex-1 relative w-full h-full">
                <canvas id="lineChart"></canvas>
            </div>
        </div>

        <!-- Doughnut Chart (🌟 Now Fully Dynamic) -->
        <div class="lg:col-span-1 bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 flex flex-col min-h-[350px]">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-sm font-bold text-slate-900">Process Status</h3>
            </div>
            
            <div class="flex-1 flex flex-col justify-center">
                <div class="relative w-36 h-36 sm:w-40 sm:h-40 mx-auto mb-6">
                    <canvas id="doughnutChart"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-3xl font-black text-slate-900" id="donutTotal">0</span>
                        <span class="text-[10px] font-bold text-slate-400">Total</span>
                    </div>
                </div>

                <!-- 🌟 Legend Container updated dynamically via JS -->
                <div class="space-y-3 px-2" id="donutLegend">
                    <div class="text-center text-slate-400 text-xs font-medium py-4">Waiting for data...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTTOM SECTION: TIMELINE & QUICK ACTIONS -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-fade-slide csp-delay-4">
        
        <!-- Real-Time Activity Timeline -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 flex flex-col flex-1">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-sm font-bold text-slate-900">Recent Activity Log</h3>
            </div>
            <div id="realActivityContainer" class="flex-1 overflow-y-auto custom-scrollbar pr-2 max-h-[300px]">
                <div class="text-center py-10 text-slate-400 text-xs font-medium">Select a target above to load activities.</div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="lg:col-span-1 bg-white rounded-2xl shadow-sm border border-slate-200 p-4 sm:p-6 shrink-0">
            <h3 class="text-sm font-bold text-slate-900 mb-4">Quick Actions</h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-2">
                <a href="/superadmin/reports" class="flex flex-col items-center gap-2 group focus:outline-none">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors shadow-sm">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2m0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    </div>
                    <span class="text-[10px] sm:text-[9px] font-bold text-slate-500 group-hover:text-slate-800 text-center">Generate<br>Report</span>
                </a>
                <a href="/superadmin/kpi" class="flex flex-col items-center gap-2 group focus:outline-none">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-orange-50 text-orange-500 flex items-center justify-center group-hover:bg-orange-500 group-hover:text-white transition-colors shadow-sm">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    </div>
                    <span class="text-[10px] sm:text-[9px] font-bold text-slate-500 group-hover:text-slate-800 text-center">Settings</span>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/vendor/chart.umd.min.js" defer></script>

<script>
    let currentScope = 'department';
    let trackingRequestId = 0;
    let lineChartInstance = null;
    let donutChartInstance = null;

    // 🌟 SECURITY FIX: Global HTML Escape Function
    function escapeHTML(str) {
        if (str === null || str === undefined) return "";
        return str.toString()
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    document.addEventListener("DOMContentLoaded", () => {
        switchScope('department');
        initMockCharts(); // Render empty charts initially
    });

    // Accurate Myanmar Timezone Formatting
    function formatMyanmarTime(timestamp) {
        if (!timestamp) return "";
        const date = new Date(timestamp);
        
        const now = new Date();
        const diffMs = now - date;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMins / 60);

        if (diffMins < 1) return "Just now";
        if (diffMins < 60) return `${diffMins} min${diffMins > 1 ? 's' : ''} ago`;
        if (diffHours < 24) return `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;

        return date.toLocaleString('en-US', {
            timeZone: 'Asia/Yangon',
            month: 'short', day: 'numeric', hour: 'numeric', minute: 'numeric', hour12: true
        });
    }

    async function switchScope(scope) {
        currentScope = scope;
        const dropdown = document.getElementById("realTargetDropdown");
        dropdown.innerHTML = `<option value="">-- Loading targets --</option>`;

        try {
            if (scope === 'department') {
                const res = await fetch("/api/v1/departments/");
                // 🛡️ Security Guard: Auto redirect on session expire
                if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
                
                if (res.ok) {
                    const depts = await res.json();
                    dropdown.innerHTML = '<option value="">-- Select Department --</option>';
                    depts.forEach(d => dropdown.innerHTML += `<option value="${d.id}">${escapeHTML(d.name)}</option>`);
                }
            } else {
                const res = await fetch("/api/v1/users/");
                if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
                
                if (res.ok) {
                    const users = await res.json();
                    dropdown.innerHTML = '<option value="">-- Select User --</option>';
                    users.forEach(u => dropdown.innerHTML += `<option value="${u.id}">${escapeHTML(u.first_name)} ${escapeHTML(u.last_name)}</option>`);
                }
            }
        } catch (e) {
            console.error("Error loading scope targets", e);
        }
    }

    function showTrackingEmptyState(message = 'No activity yet') {
        const container = document.getElementById('realActivityContainer');
        container.innerHTML = `<div class="text-center py-10 text-slate-400 text-xs font-medium">${message}</div>`;
        document.getElementById('statTotal').innerText = '0';
        document.getElementById('statCompleted').innerText = '0';
        document.getElementById('statInProgress').innerText = '0';
        document.getElementById('statDraft').innerText = '0';
        updateDonutChart(0, 0, 0, 0);
    }

    function showTrackingErrorState(message = 'Unable to load process tracking data.') {
        const container = document.getElementById('realActivityContainer');
        container.innerHTML = `<div class="text-center py-10 text-rose-500 text-xs font-bold">${message}</div>`;
        document.getElementById('statTotal').innerText = '0';
        document.getElementById('statCompleted').innerText = '0';
        document.getElementById('statInProgress').innerText = '0';
        document.getElementById('statDraft').innerText = '0';
        updateDonutChart(0, 0, 0, 0);
    }

    async function loadRealTrackingData() {
        const targetId = document.getElementById("realTargetDropdown").value;
        if (!targetId) {
            showTrackingEmptyState('No target selected');
            return;
        }

        const container = document.getElementById("realActivityContainer");
        container.innerHTML = `<div class="flex justify-center py-10"><svg class="animate-spin h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></div>`;

        let endpoint = currentScope === 'department'
            ? `/api/v1/departments/${targetId}/process-tracking`
            : `/api/v1/users/${targetId}/process-tracking`;

        try {
            const requestId = ++trackingRequestId;
            const res = await fetch(endpoint);
            if (res.status === 401 || res.status === 403) { window.location.href = '/auth/login'; return; }
            if (!res.ok) {
                showTrackingErrorState(escapeHTML(await window.readServerError(res)));
                return;
            }

            const data = await res.json();
            if (requestId !== trackingRequestId) return;
            const metrics = data.tracking_metrics || {};
            const draft = Number(metrics.DRAFT ?? metrics['Draft'] ?? 0);
            const comp = Number(metrics.COMPLETED ?? metrics['Completed'] ?? 0);
            const inProg = Number(metrics.PENDING_L1_REVIEW ?? metrics['Pending L1 Approval'] ?? 0) + Number(metrics.PENDING_L0_REVIEW ?? metrics['Pending L0 Approval'] ?? 0);
            const failed = Number(metrics.REJECTED ?? metrics['Rejected'] ?? 0);
            const total = draft + comp + inProg + failed;

            document.getElementById("statTotal").innerText = total;
            document.getElementById("statCompleted").innerText = comp;
            document.getElementById("statInProgress").innerText = inProg;
            document.getElementById("statDraft").innerText = draft;

            updateDonutChart(comp, inProg, draft, failed);
            updateProgressChart(data.progress_trend || []);

            const activityParam = currentScope === 'department' ? 'department_id' : 'actor_id';
            const activityResponse = await fetch(`/api/v1/activity/recent?limit=15&${activityParam}=${encodeURIComponent(targetId)}`);
            if (!activityResponse.ok) {
                container.innerHTML = `<div class="text-center py-10 text-rose-500 text-xs font-bold">${escapeHTML(await window.readServerError(activityResponse))}</div>`;
                return;
            }
            const activities = await activityResponse.json();
            if (total === 0 || activities.length === 0) {
                showTrackingEmptyState('No activity yet');
                return;
            }

            container.innerHTML = activities.map((act, idx) => {
                let iconBg = "bg-slate-100 text-slate-500";
                let iconSvg = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
                let actionText = escapeHTML((act.action || '').toLowerCase().replaceAll('_', ' '));

                if ((act.action || '').includes("APPROVED") || (act.action || '').includes("VERIFIED") || (act.action || '').includes("COMPLETED")) {
                    iconBg = "bg-emerald-100 text-emerald-600";
                    iconSvg = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
                    actionText = "completed";
                } else if ((act.action || '').includes("REJECTED")) {
                    iconBg = "bg-rose-100 text-rose-600";
                    iconSvg = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>`;
                    actionText = "failed / rejected";
                } else if ((act.action || '').includes("SUBMITTED")) {
                    iconBg = "bg-blue-100 text-blue-600";
                    iconSvg = `<svg class="w-3.5 h-3.5 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>`;
                    actionText = "started";
                } else if ((act.action || '').includes("DELAY") || (act.action || '').includes("RESIGN")) {
                    iconBg = "bg-orange-100 text-orange-500";
                    iconSvg = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6"></path></svg>`;
                    actionText = "paused / returned";
                }

                const isLast = idx === activities.length - 1;

                return `
                    <div class="relative mb-5 last:mb-0">
                        ${!isLast ? `<div class="absolute left-[13px] top-7 bottom-[-24px] w-[2px] bg-slate-100 z-0"></div>` : ''}
                        <div class="flex items-start gap-3 relative z-10">
                            <div class="w-7 h-7 rounded-full flex items-center justify-center shrink-0 border-[3px] border-white shadow-sm ${iconBg}">
                                ${iconSvg}
                            </div>
                            <div class="flex-1 min-w-0 pt-0.5">
                                <p class="text-[13px] font-bold text-slate-800 leading-tight">${escapeHTML(act.description || actionText)}</p>
                                <p class="text-[11px] text-slate-500 font-medium mt-0.5">${formatMyanmarTime(act.created_at)} <span class="mx-1">•</span> by <span class="inline-flex items-center gap-2 font-semibold text-slate-600">${window.kpiAvatarMarkup({
                                    ...act,
                                    id: act.actor_id || act.user_id,
                                    display_name: act.actor_name,
                                    avatar_url: act.actor_avatar_url || act.avatar_url,
                                    initials: act.actor_initials || act.initials,
                                    avatar_color_index: act.actor_avatar_color_index ?? act.avatar_color_index
                                }, 32)}${escapeHTML(act.actor_name)}</span></p>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

        } catch (e) {
            console.error('Unable to load process tracking data', { api: endpoint, error: e });
            showTrackingErrorState(escapeHTML(window.displayErrorText ? window.displayErrorText(e) : 'Unable to load process tracking data.'));
        }
    }

    // --- CHART.JS INITIALIZATION ---
    function initMockCharts() {
        // Initialize the chart while the selected target is loading.
        const lineCtx = document.getElementById('lineChart').getContext('2d');
        const labels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
        
        let gradGreen = lineCtx.createLinearGradient(0, 0, 0, 300);
        gradGreen.addColorStop(0, 'rgba(16, 185, 129, 0.2)');
        gradGreen.addColorStop(1, 'rgba(16, 185, 129, 0)');

        lineChartInstance = new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Completed', data: [0,0,0,0,0,0,0], borderColor: '#10b981', backgroundColor: gradGreen, fill: true, tension: 0.4, borderWidth: 2, pointBackgroundColor: '#10b981', pointRadius: 3 },
                    { label: 'In Progress', data: [0,0,0,0,0,0,0], borderColor: '#3b82f6', backgroundColor: 'transparent', tension: 0.4, borderWidth: 2, pointBackgroundColor: '#3b82f6', pointRadius: 3 },
                    { label: 'On Hold', data: [0,0,0,0,0,0,0], borderColor: '#f97316', backgroundColor: 'transparent', tension: 0.4, borderWidth: 2, pointBackgroundColor: '#f97316', pointRadius: 3 },
                    { label: 'Failed', data: [0,0,0,0,0,0,0], borderColor: '#e11d48', backgroundColor: 'transparent', tension: 0.4, borderWidth: 2, pointBackgroundColor: '#e11d48', pointRadius: 3 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: true, drawBorder: false, color: '#f1f5f9' }, ticks: { font: { size: 10 }, color: '#64748b' } },
                    y: { grid: { display: true, drawBorder: false, color: '#f1f5f9', borderDash: [5, 5] }, ticks: { font: { size: 10 }, color: '#64748b', stepSize: 10 }, min: 0 }
                },
                interaction: { mode: 'index', intersect: false }
            }
        });

        // Doughnut Chart setup (Empty initialized)
        const donutCtx = document.getElementById('doughnutChart').getContext('2d');
        donutChartInstance = new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'In Progress', 'On Hold', 'Failed'],
                datasets: [{
                    data: [0, 0, 0, 0], 
                    backgroundColor: ['#10b981', '#3b82f6', '#f97316', '#e11d48'],
                    borderWidth: 0,
                    borderRadius: 4,
                    spacing: 2
                }]
            },
            options: {
                cutout: '75%', responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { enabled: true } }
            }
        });
    }

    function updateProgressChart(trend) {
        if (!lineChartInstance) return;
        const rows = Array.isArray(trend) ? trend : [];
        lineChartInstance.data.labels = rows.map(row => row.label);
        lineChartInstance.data.datasets[0].data = rows.map(row => Number(row.completed || 0));
        lineChartInstance.data.datasets[1].data = rows.map(row => Number(row.in_progress || 0));
        lineChartInstance.data.datasets[2].data = rows.map(row => Number(row.draft || 0));
        lineChartInstance.data.datasets[3].data = rows.map(row => Number(row.failed || 0));
        lineChartInstance.update();
    }

    // 🌟 FUNCTION TO UPDATE CHART DYNAMICALLY
    function updateDonutChart(comp, inProg, draft, failed) {
        const total = comp + inProg + draft + failed;
        document.getElementById("donutTotal").innerText = total;

        if(donutChartInstance) {
            donutChartInstance.data.datasets[0].data = [comp, inProg, draft, failed];
            donutChartInstance.update();
        }

        // Generate dynamic HTML for Legend to reflect real percentages
        const legendHtml = total === 0 ? '<div class="text-center text-slate-400 text-xs font-medium py-4">No data available</div>' : `
            <div class="flex justify-between items-center text-xs">
                <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span><span class="font-semibold text-slate-700">Completed</span></div>
                <div class="font-bold text-slate-900">${Math.round((comp/total)*100)}% <span class="text-slate-400 font-medium ml-1">(${comp})</span></div>
            </div>
            <div class="flex justify-between items-center text-xs">
                <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span><span class="font-semibold text-slate-700">In Progress</span></div>
                <div class="font-bold text-slate-900">${Math.round((inProg/total)*100)}% <span class="text-slate-400 font-medium ml-1">(${inProg})</span></div>
            </div>
            <div class="flex justify-between items-center text-xs">
                <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span><span class="font-semibold text-slate-700">On Hold</span></div>
                <div class="font-bold text-slate-900">${Math.round((draft/total)*100)}% <span class="text-slate-400 font-medium ml-1">(${draft})</span></div>
            </div>
            <div class="flex justify-between items-center text-xs">
                <div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span><span class="font-semibold text-slate-700">Failed</span></div>
                <div class="font-bold text-slate-900">${Math.round((failed/total)*100)}% <span class="text-slate-400 font-medium ml-1">(${failed})</span></div>
            </div>
        `;
        document.getElementById("donutLegend").innerHTML = legendHtml;
    }
</script>
{% endblock %}