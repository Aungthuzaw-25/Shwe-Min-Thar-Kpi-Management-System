{% extends "layouts/employee_base.njk" %}
{% block title %}Account Profile{% endblock %}
{% block content %}
<div class="p-4 sm:p-6 lg:p-8 space-y-6 overflow-y-auto">
  <section class="app-surface p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-center gap-5">
      <div class="app-user-avatar profile-hero-avatar">
        {{ user_name|first|upper }}
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">{{ user_name }}</h1>
        <p class="text-slate-500 mt-1">{{ user_email }}</p>
        <div class="flex flex-wrap gap-2 mt-3 text-xs font-bold">
          <span class="app-status app-status--info">{{ user_display_identity }}</span>
          <span class="app-status {% if account_status == 'Active' %}app-status--success{% else %}app-status--danger{% endif %}">{{ account_status }}</span>
        </div>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-black text-slate-900 text-lg mb-4">Personal Information</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Full Name</dt><dd class="font-bold text-right">{{ user_name }}</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Email</dt><dd class="font-bold text-right break-all">{{ user_email }}</dd></div>
      </dl>
    </section>
    <section class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-black text-slate-900 text-lg mb-4">Employment Information</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Position</dt><dd class="font-bold text-right">{{ position_name or 'Not assigned' }}</dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Department</dt><dd class="font-bold text-right">{{ department_name or 'Not assigned' }}</dd></div>
      </dl>
    </section>
    <section class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-black text-slate-900 text-lg mb-4">Account Information</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Status</dt><dd class="font-bold">{{ account_status }}</dd></div>
        {% if created_at %}
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">Created</dt>
          <dd class="font-bold">{{ (created_at|strftime('%Y-%m-%d')) }}</dd>
        </div>
        {% endif %}
      </dl>
    </section>
    <section class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
      <h2 class="font-black text-slate-900 text-lg mb-4">Permission Summary</h2>
      <p class="text-xs text-slate-500 mb-3">Effective permissions for your current role, level, and overrides.</p>
      <div class="space-y-2 max-h-64 overflow-y-auto">
        {% for code, allowed in permission_map.items() %}
        <div class="flex items-center justify-between text-sm">
          <span class="text-slate-600">{{ code }}</span>
          {% if allowed %}<span class="text-emerald-600 font-bold">Allowed</span>{% else %}<span class="text-slate-400 font-bold">Not available</span>{% endif %}
        </div>
        {% else %}
        <p class="text-sm text-slate-500">No permissions assigned.</p>
        {% endfor %}
      </div>
    </section>
    <section class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm lg:col-span-2">
      <div class="mb-4">
        <h2 class="font-black text-slate-900 text-lg">Connected Accounts</h2>
        <p class="text-xs text-slate-500 mt-1">Use only provider accounts explicitly connected to this internal user account.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {% for provider, label in [('google', 'Google'), ('microsoft', 'Microsoft')] %}
        {% set account = connected_accounts[provider] %}
        <div class="rounded-2xl border border-slate-200 p-4 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <h3 class="font-bold text-slate-900">{{ label }}</h3>
            {% if account %}
            <p class="text-sm text-emerald-600 font-semibold">Connected</p>
            <p class="text-xs text-slate-500 truncate">{{ account.email or 'Verified provider account' }}</p>
            {% if account.connected_at %}
            <p class="text-xs text-slate-400 mt-1">Connected on {{ (account.connected_at|strftime('%Y-%m-%d')) }}</p>
            {% endif %}
            {% else %}
            <p class="text-sm text-slate-500">Not connected</p>
            {% endif %}
          </div>
          {% if account %}
          {% if local_password_enabled or connected_accounts|length > 1 %}
          <button type="button" data-unlink-provider="{{ provider }}" class="shrink-0 rounded-xl border border-red-200 px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-50">Unlink</button>
          {% else %}
          <span class="shrink-0 text-xs font-semibold text-slate-400">Required</span>
          {% endif %}
          {% else %}
          <a href="/api/v1/auth/{{ provider }}/link/start" class="shrink-0 rounded-xl bg-blue-900 px-3 py-2 text-xs font-bold text-white hover:bg-blue-800">Connect {{ label }}</a>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      <p id="connectedAccountsMessage" class="hidden mt-4 rounded-xl px-4 py-3 text-sm"></p>
    </section>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('[data-unlink-provider]').forEach((button) => {
  button.addEventListener('click', async () => {
    if (!(await window.appConfirm(
      'Unlink this account? You must keep at least one sign-in method connected.',
      { title: 'Unlink account?', confirmText: 'Unlink', cancelText: 'Keep connected' }
    ))) return;
    const message = document.getElementById('connectedAccountsMessage');
    const response = await fetch(`/api/v1/auth/${button.dataset.unlinkProvider}/link`, {
      method: 'DELETE',
      credentials: 'same-origin',
    });
    const data = await response.json().catch(() => ({}));
    const messageText = data.detail || data.status || (response.ok ? 'Account unlinked.' : 'Unable to unlink account.');
    window.showToast(messageText, response.ok ? 'success' : 'error');
    message.className = 'hidden';
    message.textContent = messageText;
    if (response.ok) window.setTimeout(() => window.location.reload(), 500);
  });
});
</script>
{% endblock %}
