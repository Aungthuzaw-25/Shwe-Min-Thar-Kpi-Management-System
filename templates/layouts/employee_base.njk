<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Enterprise Portal{% endblock %}</title>

    <!-- PWA Settings -->
    <link rel="manifest" href="/static/manifest.json">
    <meta name="theme-color" content="#3d5a80">

    <script>
        // Service Worker ကို Register လုပ်ခြင်း
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/static/service-worker.js')
                    .then((registration) => {
                        console.log('ServiceWorker registration successful with scope: ', registration.scope);
                    }, (error) => {
                        console.log('ServiceWorker registration failed: ', error);
                    });
            });
        }
    </script>
    
    <!-- PERFORMANCE FIX: Pre-compiled Local CSS -->
    <link rel="stylesheet" href="/static/css/output.css">
    <link rel="stylesheet" href="/static/css/design-system.css?v=20261015-1">
    <link rel="stylesheet" href="/static/css/notifications.css">
    <link rel="stylesheet" href="/static/css/enterprise-ui.css">
    <link rel="stylesheet" href="/static/css/executive-dashboard.css">
    <link rel="stylesheet" href="/static/css/liquid-glass-theme.css?v=20261021-4">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    {% if dashboard_variant == "executive" %}
    <script src="/static/vendor/chart.umd.min.js" defer></script>
    {% endif %}
    <script src="/static/js/csp-event-bridge.js"></script>
    <script src="/static/js/csrf.js"></script>
    
    <style>
        body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background-color: #f5f7fa; }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .sidebar-link { transition: all 0.2s ease-in-out; }
        .sidebar-link:hover { background-color: rgba(255,255,255,0.08); transform: translateX(4px); }
        .sidebar-link.active { background-color: #1c2b3a; color: white; box-shadow: none; }
        
        /* Modal & Toast CSS */
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .toast-enter { animation: slideIn 0.3s ease-out forwards; }
        .toast-exit { animation: fadeOut 0.3s ease-out forwards; }
        .animate-fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body class="app-shell app-shell--employee flex h-screen overflow-hidden text-slate-800 relative">

    <!-- SIDEBAR NAVIGATION -->
    <aside id="mainSidebar" class="w-[260px] bg-slate-900 text-white flex-col shrink-0 transition-transform duration-300 absolute md:relative inset-y-0 left-0 z-30 shadow-2xl transform -translate-x-full md:translate-x-0 flex">
        <!-- Logo -->
        <div class="h-24 flex items-center justify-between px-6 sm:px-8 border-b border-slate-800 bg-slate-900/90 backdrop-blur-md shrink-0">
            <h1 class="text-lg sm:text-xl font-black tracking-tight flex items-center">
                <img src="/static/image/smt-logo.jpg" alt="Shwe Min Thar logo" class="w-10 h-10 rounded-xl mr-3 shadow-sm object-cover">
                Shwe Min Thar
            </h1>
            <button type="button" class="md:hidden text-slate-400 hover:text-white focus:outline-none" onclick="toggleMobileSidebar()" aria-label="Close navigation menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <nav class="flex-1 py-8 px-5 space-y-2 overflow-y-auto custom-scrollbar">
            <!-- L0 NAVIGATION -->
            {% if user_level in ['L0', 'Level 0'] %}
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-3 px-3">Director Operations</div>
                <a href="/l0/dashboard" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'dashboard' %}active{% else %}text-slate-300{% endif %}">
                    <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    Department Overview
                </a>
                {% if (permission_map['tasks.view'] if permission_map['tasks.view'] is defined else False) %}
                <a href="/tasks" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'tasks' %}active{% else %}text-slate-300{% endif %}">
                    <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Final Authorizations
                </a>
                {% endif %}
            <!-- L1 NAVIGATION -->
            {% elif user_level in ['L1', 'Level 1'] %}
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-3 px-3">Team Supervisor</div>
                <a href="/l1/dashboard" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'dashboard' %}active{% else %}text-slate-300{% endif %}">
                    <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    Team Dashboard
                </a>
                {% if (permission_map['tasks.view'] if permission_map['tasks.view'] is defined else False) %}
                <a href="/tasks" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'tasks' %}active{% else %}text-slate-300{% endif %}">
                    <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                    Review Submissions
                </a>
                {% endif %}
            <!-- L2 NAVIGATION -->
            {% else %}
                <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-3 px-3">Personal Workspace</div>
                <a href="/dashboard" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'dashboard' %}active{% else %}text-slate-300{% endif %}">
                    <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    My Performance
                </a>
                {% if (permission_map['tasks.view'] if permission_map['tasks.view'] is defined else False) %}
                <a href="/tasks" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'tasks' %}active{% else %}text-slate-300{% endif %}">
                    <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                    Submit KPI Task
                </a>
                {% endif %}
            {% endif %}

            <!-- SHARED ACCOUNT MENU -->
            <a href="/notifications" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'notifications' %}active{% else %}text-slate-300{% endif %}">
                <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 01-6 0v-1"></path></svg>
                Notifications
            </a>
            <div class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-3 mt-8 px-3">Settings</div>
            <a href="/profile" class="sidebar-link flex items-center px-4 py-3.5 text-sm font-bold rounded-xl {% if active_page == 'profile' %}active{% else %}text-slate-300{% endif %}">
                <svg class="w-5 h-5 mr-3 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Account Profile
            </a>
        </nav>

        <!-- FOOTER (User Context) -->
        <div class="p-5 border-t border-slate-800 bg-slate-900 shrink-0 space-y-4 relative">
            <div class="flex items-center justify-between p-3 bg-slate-800/80 rounded-2xl border border-slate-700/50 shadow-inner">
                <div class="flex items-center min-w-0 flex-1">
                    <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-black text-sm shrink-0 shadow-sm" id="sidebarUserInitial">
                        U
                    </div>
                    <div class="ml-3 min-w-0">
                        <p class="text-sm font-bold truncate text-white" id="sidebarFullName">{{ user_name }}</p>
                        <p class="text-[10px] text-slate-400 truncate font-semibold mt-0.5"><span id="sidebarDept">{{ department_name or 'No Dept' }}</span> • <span id="sidebarPos">{{ position_name or 'No Position' }}</span></p>
                    </div>
                </div>
            </div>

            <!-- Logout Button -->
            <button type="button" onclick="handleLogout()" class="flex items-center justify-center w-full px-4 py-2.5 text-xs font-bold text-slate-400 bg-transparent hover:bg-red-500/10 rounded-xl hover:text-red-400 transition-all border border-slate-700/50 hover:border-red-500/30 focus:outline-none">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Secure Sign Out
            </button>

        </div>
    </aside>

    <!-- MAIN CONTENT INJECTION -->
    <main class="flex-1 flex flex-col min-w-0 overflow-hidden relative z-10 bg-slate-50/50">
        <!-- Mobile Header with Menu Toggle -->
        <div class="md:hidden flex items-center justify-between bg-slate-900 text-white p-4 sm:p-5 shrink-0 shadow-sm z-10">
            <h1 class="text-lg sm:text-xl font-black tracking-tight flex items-center">
                <img src="/static/image/smt-logo.jpg" alt="Shwe Min Thar logo" class="w-8 h-8 rounded-lg mr-2 shadow-sm object-cover">
                Shwe Min Thar
            </h1>
            <button type="button" class="text-slate-400 hover:text-white focus:outline-none" onclick="toggleMobileSidebar()" aria-label="Open navigation menu" aria-controls="mainSidebar" aria-expanded="false">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>

        <header class="app-topbar">
            <div class="app-topbar__context">
                <p class="app-topbar__eyebrow">Enterprise performance platform</p>
                <p class="app-topbar__title">{{ user_display_identity or user_role or 'Workspace' }} workspace</p>
            </div>
            <div class="app-topbar__actions">
                <a class="app-topbar__icon" href="/notifications" aria-label="Open notifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 01-6 0v-1"/></svg>
                    <span id="topbarNotificationCount" class="app-notification-count" hidden></span>
                </a>
                <div class="app-topbar__identity">
                    <span class="app-topbar__avatar">{{ user_name[0] if user_name else 'U' }}</span>
                    <div class="app-topbar__user">
                        <strong>{{ user_name or 'User' }}</strong>
                        <span>{{ user_level or user_role or 'Authorized user' }}{% if department_name %} · {{ department_name }}{% endif %}</span>
                    </div>
                </div>
                <button type="button" class="app-topbar__icon" onclick="handleLogout()" aria-label="Sign out">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5m5 5H3m10-8V3a2 2 0 012-2h4a2 2 0 012 2v18a2 2 0 01-2 2h-4a2 2 0 01-2-2v-2"/></svg>
                </button>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto custom-scrollbar relative">
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- GLOBAL TOAST NOTIFICATIONS CONTAINER -->
    <div id="toastContainer" class="fixed top-5 right-5 z-[9999] flex flex-col gap-2 max-w-[90%] sm:max-w-md w-full items-end"></div>

    <!-- CORE JAVASCRIPT SYSTEM -->
    <script>
        // Global HTML Escape Function to prevent XSS
        window.escapeHTML = function(str) {
            if (!str) return "";
            return str.toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        };

        // Universal Centralized Toast Function
        window.showToast = function(message, type = 'success') {
            let container = document.getElementById('toastContainer');
            if(!container) return;

            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-50 border-green-500 text-green-900' : 'bg-red-50 border-red-500 text-red-900';
            const icon = type === 'success' 
                ? `<svg class="w-5 h-5 text-green-500 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
                : `<svg class="w-5 h-5 text-red-500 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

            toast.className = `flex items-start p-3 sm:p-4 mb-3 border-l-4 rounded-xl shadow-lg w-full bg-white ${bgColor} toast-enter pointer-events-auto`;
            toast.innerHTML = `${icon}<div class="text-xs sm:text-sm font-medium flex-1">${window.escapeHTML(message)}</div>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.replace('toast-enter', 'toast-exit');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        };

        // AUTH FIX & TOKEN REFRESH LOGIC
        const originalFetch = window.fetch;
        const AUTH_REFRESH_URL = '/api/v1/auth/refresh';

        function isAuthEndpoint(url) {
            if (!url) return false;
            const requestUrl = typeof url === 'string' ? url : url.url;
            if (!requestUrl) return false;
            let path;
            try {
                path = new URL(requestUrl, window.location.origin).pathname;
            } catch (error) {
                return false;
            }
            return path === '/api/v1/auth/login'
                || path === AUTH_REFRESH_URL
                || path === '/api/v1/auth/logout'
                || path.startsWith('/api/v1/auth/oauth/')
                || path.includes('/auth/swagger-login')
                || window.location.pathname.includes('/login');
        }

        function safeReturnPath() {
            const path = window.location.pathname;
            if (!path.startsWith('/') || path.startsWith('//') || path.includes('\\')
                || path.startsWith('/auth/')) return null;
            return path;
        }

        function safeLogoutFromExpiredSession(reason) {
            if (window.__authSessionLogoutTriggered) return;
            window.__authSessionLogoutTriggered = true;
            try {
                localStorage.removeItem('user');
            } catch (error) {
                console.warn('[AUTH] Could not clear stored session data.', error);
            }
            console.warn('[AUTH] Expired session detected:', reason);
            const returnPath = safeReturnPath();
            const query = new URLSearchParams({ session_expired: 'true' });
            if (returnPath) query.set('next', returnPath);
            window.location.href = `/auth/login?${query.toString()}`;
        }

        let refreshPromise = null;

        async function refreshAccessTokenOnce() {
            if (refreshPromise) {
                return refreshPromise;
            }
            refreshPromise = (async () => {
                try {
                    const refreshResponse = await originalFetch(AUTH_REFRESH_URL, {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (refreshResponse.ok) {
                        console.info('[AUTH] Access token refreshed successfully.');
                        return true;
                    }
                    return false;
                } catch (error) {
                    console.warn('[AUTH] Refresh request failed:', error);
                    return false;
                } finally {
                    refreshPromise = null;
                }
            })();
            return refreshPromise;
        }

        function cloneFetchInit(init = {}) {
            const cloned = { ...init };
            if (cloned.headers && !(cloned.headers instanceof Headers)) {
                cloned.headers = { ...cloned.headers };
            }
            if (!('credentials' in cloned)) {
                cloned.credentials = 'include';
            }
            return cloned;
        }

        window.fetch = async function(input, init = {}) {
            const url = typeof input === 'string' ? input : (input && input.url ? input.url : '');
            const isLoginPage = window.location.pathname.includes('/login');
            const isAuthRequest = isAuthEndpoint(url) || isLoginPage;

            try {
                let response = await originalFetch.apply(this, arguments);

                if ((response.status === 401 || response.status === 403) && !isAuthRequest) {
                    // Token သက်တမ်းကုန်သွားပါက (401)
                    if (response.status === 401) {
                        console.warn('[AUTH] 401 Unauthorized detected. Attempting token refresh...');
                        const refreshed = await refreshAccessTokenOnce();
                        if (refreshed) {
                            const retryInit = cloneFetchInit(init);
                            try {
                                const retryResponse = await originalFetch.apply(this, [input, retryInit]);
                                if (retryResponse.status !== 401) {
                                    return retryResponse;
                                }
                                safeLogoutFromExpiredSession('401 after successful refresh for ' + url);
                                return retryResponse;
                            } catch (retryError) {
                                console.warn('[AUTH] Retry failed:', retryError);
                            }
                        }
                        // Refresh လို့မရတော့မှသာ အမှန်တကယ် Login သို့ ပြန်ပို့ပါမည်
                        safeLogoutFromExpiredSession('401 session expired');
                        return response;
                    } 
                    // ခွင့်ပြုချက်မရှိသော Data ဖြစ်ပါက (403) - Logout လုံးဝ မလုပ်ပါ
                    else if (response.status === 403) {
                        if (typeof window.showToast === 'function') {
                            window.showToast("Permission Denied: လုပ်ဆောင်ခွင့် မရှိပါ။", "error");
                        }
                        return response;
                    }
                }

                return response;
            } catch (err) {
                throw err;
            }
        };

        // Mobile Sidebar Toggle Logic
        function toggleMobileSidebar() {
            const sidebar = document.getElementById("mainSidebar");
            if (sidebar) {
                const isOpen = sidebar.classList.toggle("-translate-x-full") === false;
                document.body.classList.toggle("overflow-hidden");
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            window.currentUserContext = {
                full_name: {{ user_name|tojson }},
                department_name: {{ (department_name or '')|tojson }},
                position_name: {{ (position_name or '')|tojson }}
            };
            const fullName = window.currentUserContext.full_name || 'User';
            document.getElementById('sidebarUserInitial').innerText = fullName.charAt(0).toUpperCase();
            fetchNotifications();
            startSmartPolling();
        });

        // Logout Logic
        async function handleLogout() {
            if (!(await window.appConfirm('စနစ်မှ ထွက်ခွာရန် (Logout) သေချာပါသလား?', { title: 'Sign out?' }))) return;
            try {
                const response = await fetch('/api/v1/auth/logout', { method: 'POST', credentials: 'include' });
                if (!response.ok) {
                    throw new Error(`Logout failed with status ${response.status}`);
                }
                localStorage.removeItem('user'); 
                window.location.replace('/auth/login');
            } catch (error) {
                console.error('Logout error:', error);
                window.showToast('ကွန်ရက် ချိတ်ဆက်မှု အမှားအယွင်း ရှိနေပါသည်။', 'error');
            }
        }

        // Notification System
        const NOTIF_API_BASE = "/api/v1/notifications";
        let notifInterval;

        function startSmartPolling() {
            if (!notifInterval) {
                notifInterval = setInterval(fetchNotifications, 60000); 
            }
        }

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) {
                clearInterval(notifInterval);
                notifInterval = null;
            } else {
                fetchNotifications(); 
                startSmartPolling();
            }
        });

        document.addEventListener("click", (event) => {
            const notification = event.target.closest("[data-notification-id]");
            if (notification) {
                markAsRead(notification.dataset.notificationId);
                return;
            }
            const dropdown = document.getElementById("notifDropdown");
            const btn = document.getElementById("bellBtn");
            if (dropdown && !dropdown.classList.contains("hidden")) {
                if (!dropdown.contains(event.target) && (!btn || !btn.contains(event.target))) {
                    dropdown.classList.add("hidden");
                    if (btn) btn.setAttribute("aria-expanded", "false");
                }
            }
        });

        function toggleNotifications(event) {
            if(event) event.stopPropagation();
            const dropdown = document.getElementById("notifDropdown");
            if(dropdown) {
                const isOpen = dropdown.classList.contains("hidden");
                if (isOpen) {
                    dropdown.classList.remove("hidden");
                    dropdown.classList.add("flex");
                } else {
                    dropdown.classList.add("hidden");
                    dropdown.classList.remove("flex");
                }
                const button = document.getElementById("bellBtn");
                if (button) button.setAttribute("aria-expanded", String(isOpen));
            }
        }

        async function fetchNotifications() {
            try {
                const [res, countResponse] = await Promise.all([
                    fetch(`${NOTIF_API_BASE}?limit=15`),
                    fetch(`${NOTIF_API_BASE}/unread-count`)
                ]);
                if (!res.ok) throw new Error(`Notifications request failed (${res.status})`);
                const notifications = await res.json();
                const unreadCount = countResponse.ok ? (await countResponse.json()).count : 0;
                renderNotifications(notifications, unreadCount);
            } catch (err) {
                const listContainer = document.getElementById("notifList");
                if (listContainer) listContainer.innerHTML = '<div class="p-6 text-center text-red-600 text-xs font-medium">Unable to load notifications. <button type="button" class="underline font-bold" onclick="fetchNotifications()">Retry</button></div>';
            }
        }

        function renderNotifications(notifications, unreadCount = 0) {
            const listContainer = document.getElementById("notifList");
            const ping = document.getElementById("unreadPing");
            if(!listContainer || !ping) return;
            
            if (unreadCount > 0) {
                ping.classList.remove("hidden");
            } else {
                ping.classList.add("hidden");
            }

            if (notifications.length === 0) {
                listContainer.innerHTML = `
                    <div class="p-8 sm:p-10 text-center text-slate-400">
                        <svg class="w-6 h-6 sm:w-8 sm:h-8 mx-auto text-slate-300 mb-2 sm:mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                        <p class="text-[10px] sm:text-xs font-bold">You are all caught up.</p>
                    </div>`;
                return;
            }

            listContainer.innerHTML = notifications.map(n => {
                const bgClass = n.is_read ? "bg-white" : "bg-blue-50/40";
                const dot = n.is_read ? "" : `<div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-blue-600 mt-1 sm:mt-1.5 shrink-0 shadow-sm ring-2 ring-white"></div>`;
                
                return `
                    <button type="button" data-notification-id="${window.escapeHTML(n.id)}" onclick="viewNotificationDetail('${window.escapeHTML(n.id)}')" class="w-full text-left p-4 sm:p-5 hover:bg-slate-50 transition flex gap-3 sm:gap-4 ${bgClass}">
                        ${dot}
                        <div class="flex-1 min-w-0">
                            <p class="text-[11px] sm:text-sm font-extrabold text-slate-800 mb-0.5 sm:mb-1 truncate">${window.escapeHTML(n.title)}</p>
                            <p class="text-[10px] sm:text-[11px] font-medium text-slate-500 leading-relaxed line-clamp-2">${window.escapeHTML(n.message)}</p>
                            <p class="text-[8px] sm:text-[9px] font-bold text-slate-400 mt-2 sm:mt-2.5 uppercase tracking-wider">${formatAppDate(n.created_at)}</p>
                        </div>
                    </button>
                `;
            }).join('');
        }

        function formatAppDate(value) {
            if (!value) return "";
            const normalized = /(?:Z|[+-]\d{2}:\d{2})$/.test(value) ? value : `${value}Z`;
            const date = new Date(normalized);
            if (Number.isNaN(date.getTime())) return "";
            return new Intl.DateTimeFormat(undefined, {
                timeZone: "Asia/Yangon",
                dateStyle: "medium",
                timeStyle: "short"
            }).format(date);
        }

        async function markAsRead(notifId) {
            try {
                await fetch(`${NOTIF_API_BASE}/${notifId}/read`, { method: "PUT" });
                fetchNotifications(); 
            } catch (err) {}
        }

        async function markAllAsRead() {
            try {
                await fetch(`${NOTIF_API_BASE}/read-all`, { method: "PUT" });
                fetchNotifications();
                toggleNotifications();
            } catch (err) {}
        }
    </script>

    <!-- SPECIFIC PAGE SCRIPTS INJECTION -->
    <script>
        const effectivePermissions = {{ permission_map | default({}) | tojson }};
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-permission]').forEach((element) => {
                if (!effectivePermissions[element.dataset.permission]) {
                    element.remove();
                }
            });
            if (!effectivePermissions['tasks.view']) {
                document.querySelectorAll('a[href="/tasks"]').forEach((element) => element.remove());
            }
        });
    </script>
    {% block scripts %}{% endblock %}
    <script src="/static/js/notifications.js"></script>

</body>
</html>