{% from "components/avatar.njk" import avatar %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Shwe Min Thar Dashboard{% endblock %}</title>

    <!-- PWA Settings -->
    <link rel="manifest" href="/static/manifest.json">
    <meta name="theme-color" content="#3d5a80">


    <!-- Production CSS -->
    <link rel="stylesheet" href="/static/css/output.css">
    <link rel="stylesheet" href="/static/css/design-system.css?v=20261015-1">
    <link rel="stylesheet" href="/static/css/notifications.css">
    <link rel="stylesheet" href="/static/css/dashboard.css">
    <link rel="stylesheet" href="/static/css/enterprise-ui.css">
    <link rel="stylesheet" href="/static/css/executive-dashboard.css{% if dashboard_variant == 'executive' %}?v=20261013-4{% endif %}">
    <link rel="stylesheet" href="/static/css/liquid-glass-theme.css?v=20261021-4">
    <link rel="stylesheet" href="/static/css/role-themes.css">
    <link rel="stylesheet" href="/static/css/sidebar-panels.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- External Scripts -->
    <script src="/static/js/api-fetch.js"></script>
    {% if dashboard_variant == "executive" %}
    <script src="/static/vendor/chart.umd.min.js" defer></script>
    {% endif %}
    <script src="/static/js/csp-event-bridge.js"></script>
    <script src="/static/js/csrf.js"></script>
    
    <style>
        body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background-color: #f5f7fa; }
        .bg-kpi-red { background-color: #17212b; }
        .text-kpi-red { color: #3d5a80; }
        
        /* Sidebar Item Styles */
        .sidebar-item-active { background-color: #1c2b3a; color: #ffffff; font-weight: 600; }
        .sidebar-item:hover:not(.sidebar-item-active) { background-color: rgba(255,255,255,0.1); }
        
        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 10px; }
        
        /* Modal & Toast CSS */
        .modal-overlay { background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(2px); }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .toast-enter { animation: slideIn 0.3s ease-out forwards; }
        .toast-exit { animation: fadeOut 0.3s ease-out forwards; }
        .animate-fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
        
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body class="app-shell app-shell--admin flex h-screen overflow-hidden text-gray-800 relative {% if user_role == 'Super Admin' %}theme-sa{% elif user_role in ['Admin', 'HR', 'System Admin'] %}theme-admin{% elif user_role %}theme-employee{% endif %}">
    <div id="offlineBanner" class="offline-banner" data-user-id="{{ user_id }}" hidden role="status">📴 You are offline. <span id="offlineBannerTime" class="offline-banner-time"></span></div>
    <!-- Global loading overlay: frosted glass + ring (design-system.css .app-loader) -->
    <div class="app-loader" aria-hidden="true">
        <div class="app-loader__card">
            <span class="app-loader__ring"></span>
            <span class="app-loader__label">Loading</span>
        </div>
    </div>
    <script src="/static/js/app-loader.js"></script>


    {% if user_role in ['Super Admin', 'Admin'] %}
    
    <!-- 📱 MOBILE RESPONSIVE FIX: Sidebar Backdrop Overlay -->
    <button id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/50 z-20 hidden md:hidden transition-opacity" type="button" onclick="toggleMobileSidebar()" aria-label="Close mobile sidebar"></button>

    <!-- 📱 MOBILE RESPONSIVE FIX: absolute positioning and transform classes -->
    <aside id="mainSidebar" class="w-64 bg-kpi-red text-white flex-col h-full shadow-xl z-30 shrink-0 absolute md:relative inset-y-0 left-0 transform -translate-x-full md:translate-x-0 transition-transform duration-300 flex">
        <!-- Logo Area -->
        <div class="p-6 flex items-center justify-between space-x-3 shrink-0">
            <div class="flex items-center space-x-3 min-w-0">
                <img src="{{ brand.logo_url or "/static/image/smt-logo.jpg" }}" alt="{{ brand.company_name or "Shwe Min Thar" }} logo" class="w-11 h-11 rounded-xl object-cover shrink-0 shadow-sm">
                <div class="min-w-0">
                    <h1 class="text-lg font-bold tracking-wide leading-tight line-clamp-2 break-words">{{ brand.company_name or "Shwe Min Thar" }}</h1>
                    {% if brand.company_tagline %}<p class="text-[10px] text-slate-400 uppercase tracking-widest line-clamp-2 break-words">{{ brand.company_tagline }}</p>{% endif %}
                </div>
            </div>
            <!-- Mobile Close Button inside Sidebar -->
            <button type="button" class="md:hidden text-slate-400 hover:text-white focus:outline-none" onclick="toggleMobileSidebar()" aria-label="Close navigation menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 px-4 space-y-1 mt-2 overflow-y-auto custom-scrollbar">
            <!-- Dashboard: Super Admin sees the SA dashboard, Admin sees their own -->
            <a href="{% if user_role == 'Super Admin' %}/superadmin/dashboard{% else %}/admin/dashboard{% endif %}" class="{% if active_page == 'dashboard' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors" data-sidebar-panel="dashboard">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg> Dashboard
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-dashboard" class="sidebar-panel" hidden role="menu" aria-label="Dashboard">
                <p class="sidebar-panel__title">Dashboard</p>
                <a class="sidebar-panel__row{% if active_page == 'dashboard' or active_page == 'employee_kpi_results' %} sidebar-panel__row--active{% endif %}" href="{% if user_role == 'Super Admin' %}/superadmin/employee-kpi-results{% else %}/admin/dashboard#employeeResultsPanel{% endif %}" role="menuitem">Employee KPI Results · Overview</a>
                <a class="sidebar-panel__row{% if active_page == 'department_kpi' %} sidebar-panel__row--active{% endif %}" href="/superadmin/department-kpi" role="menuitem">Department KPI</a>
            </div>
            <!-- What's New: single top-level entry, all roles (NOT a submenu child) -->
            <a href="/whats-new" class="{% if active_page == 'whats_new' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg> What's New
            </a>
            
            <div class="nav-group-label">Organization</div>
            <!-- Users -->
            <a href="/superadmin/users" data-sidebar-panel="users" class="{% if active_page == 'users' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg> Users
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-users" class="sidebar-panel" hidden role="menu" aria-label="Users">
                <p class="sidebar-panel__title">Users</p>
                <a class="sidebar-panel__row" href="/superadmin/users?view=active" role="menuitem">Active Users</a>
                <a class="sidebar-panel__row" href="/superadmin/users?view=deleted" role="menuitem">Deleted Users</a>
            </div>

            <!-- Departments -->
            <a href="/superadmin/departments" data-sidebar-panel="departments" class="{% if active_page == 'departments' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg> Departments
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-departments" class="sidebar-panel" hidden role="menu" aria-label="Departments">
                <p class="sidebar-panel__title">Departments</p>
                <a class="sidebar-panel__row" href="/superadmin/departments?tab=active" role="menuitem">Active Departments</a>
                <a class="sidebar-panel__row" href="/superadmin/departments?tab=deleted" role="menuitem">Trash</a>
            </div>
            <a href="/superadmin/permissions" data-sidebar-panel="permissions" class="{% if active_page == 'permissions' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a3 3 0 11-6 0 3 3 0 016 0zm3 14H6v-2a6 6 0 0112 0v2zm-3-9h6m-3-3v6"></path></svg> Permissions
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-permissions" class="sidebar-panel" hidden role="menu" aria-label="Permissions">
                <p class="sidebar-panel__title">Permissions</p>
                <a class="sidebar-panel__row" href="/superadmin/permissions?tab=roles" role="menuitem">Roles</a>
                <a class="sidebar-panel__row" href="/superadmin/permissions?tab=users" role="menuitem">User Overrides</a>
                <a class="sidebar-panel__row" href="/superadmin/permissions?tab=audit" role="menuitem">Audit</a>
            </div>

            {% if user_role in ['Super Admin'] %}
            <a href="/superadmin/super-admins" class="{% if active_page == 'super_admin_management' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0A5.002 5.002 0 0112 16a5.002 5.002 0 014.644 3.143M12 7a3 3 0 110 6 3 3 0 010-6z"></path></svg> Super Admin Management
            </a>
            <a href="/superadmin/health" class="{% if active_page == 'system_health' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg> System Health
            </a>
            {% endif %}

            <!-- Positions -->
            <a href="/positions" class="{% if active_page == 'positions' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> Positions
            </a>

            <div class="nav-group-label">Performance</div>
            <!-- KPIs -->
            <a href="/superadmin/kpi" data-sidebar-panel="kpis" class="{% if active_page == 'kpis' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors"{% if active_page == 'kpis' %} aria-current="page"{% endif %}>
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg> KPIs
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-kpis" class="sidebar-panel" hidden role="menu" aria-label="KPIs">
                <p class="sidebar-panel__title">KPIs</p>
                <a class="sidebar-panel__row" href="/superadmin/kpi?tab=records" role="menuitem">Employee KPI Records · Manage</a>
                <a class="sidebar-panel__row" href="/superadmin/kpi?tab=settings" role="menuitem">Role Tracking</a>
                <a class="sidebar-panel__row" href="/superadmin/kpi?tab=assignments" role="menuitem">Assign Tasks</a>
            </div>

            <!-- KPI Upload -->
            <a href="/superadmin/kpi-upload" class="{% if active_page == 'kpi_upload' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg> KPI Import
            </a>

            <!-- KPI Periods -->
            <a href="/kpi-periods" data-sidebar-panel="kpi_periods" class="{% if active_page == 'kpi_periods' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> KPI Periods
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-kpi_periods" class="sidebar-panel" hidden role="menu" aria-label="KPI Periods">
                <p class="sidebar-panel__title">KPI Periods</p>
                <a class="sidebar-panel__row" href="/kpi-periods#evaluationPeriodsPanel" role="menuitem">Evaluation Periods</a>
                <a class="sidebar-panel__row" href="/kpi-periods#manualEnginePanel" role="menuitem">Manual Engine</a>
            </div>

            <!-- Targets -->
            <a href="/superadmin/targets" class="{% if active_page == 'targets' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg> Targets
            </a>

            <!-- Reports -->
            <a href="/superadmin/reports" class="{% if active_page == 'reports' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg> Reports
            </a>

            <div class="nav-group-label">Operations</div>
            <!-- Action Plans -->
            <a href="/action-plans" class="{% if active_page == 'action_plans' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg> Action Plans
            </a>

           <div class="nav-group-label">Governance</div>
           <!-- Super Admin Process Tracking Sidebar Link (SA only) -->
            {% if user_role == 'Super Admin' %}
            <a href="/superadmin/process-tracking" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-bold transition-all {% if active_page == 'process_tracking' %}bg-blue-600 text-white shadow-md{% else %}text-slate-300 hover:bg-[rgba(255,255,255,0.1)]{% endif %}">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                Process Tracking
            </a>
            {% endif %}

            <!-- System Settings (SA only) -->
            {% if user_role == 'Super Admin' %}
            <a href="/system-settings" data-sidebar-panel="system_settings" class="{% if active_page == 'system_settings' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg> System Settings
                <svg class="sidebar-panel__chev ml-auto w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </a>
            <div id="sidebar-panel-system_settings" class="sidebar-panel" hidden role="menu" aria-label="System Settings">
                <p class="sidebar-panel__title">System Settings</p>
                <a class="sidebar-panel__row" href="/system-settings?view=general" role="menuitem">General Info</a>
                <a class="sidebar-panel__row" href="/system-settings?view=email" role="menuitem">Email Configuration</a>
                <a class="sidebar-panel__row" href="/system-settings?view=security" role="menuitem">Security Policy</a>
                <a class="sidebar-panel__row" href="/system-settings?view=maintenance" role="menuitem">Maintenance</a>
                <a class="sidebar-panel__row" href="/system-settings?view=user-security" role="menuitem">User Settings</a>
            </div>
            {% endif %}

            <a href="/notifications" class="{% if active_page == 'notifications' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="1.5" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 01-6 0v-1"/></svg> Notifications
            </a>

            <!-- Audit Logs (SA only) -->
            {% if user_role == 'Super Admin' %}
            <a href="/superadmin/audit-logs" class="{% if active_page == 'audit_logs' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> Audit Logs
            </a>
            <a href="/superadmin/system-logs" class="{% if active_page == 'system_logs' %}sidebar-item-active{% else %}sidebar-item text-slate-300{% endif %} flex items-center px-4 py-3 rounded-xl transition-colors">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="1.5" d="M4 5h16M4 12h16M4 19h16"/><circle cx="7" cy="5" r="1"/><circle cx="7" cy="12" r="1"/><circle cx="7" cy="19" r="1"/></svg> System Logs
            </a>
            {% endif %}
        </nav>

        <!-- User Profile Area & Logout Button -->
        <div class="p-4 border-t border-slate-800 shrink-0 space-y-3 relative">
            
            <div class="flex items-center justify-between p-2 bg-slate-800/80 rounded-xl">
                <!-- User Info -->
                <div class="flex items-center min-w-0 flex-1">
                    <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg shrink-0">
                        {{ user_name[0] if user_name else 'SA' }}
                    </div>
                    <div class="ml-3 min-w-0">
                        <p class="text-sm font-semibold truncate">{{ user_name }}</p>
                        <p class="text-[10px] sm:text-xs text-slate-400 truncate">{{ user_email }}</p>
                    </div>
                </div>

            </div>

            <!-- Logout Button -->
            <button type="button" onclick="handleLogout()" class="w-full flex items-center justify-center space-x-2 bg-slate-800/50 hover:bg-slate-700 text-slate-300 hover:text-white py-2 px-3 rounded-xl text-xs font-semibold transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                <span>လော့ဂ်အောက်ထွက်ရန် (Logout)</span>
            </button>
            
            
        </div>
    </aside>
    {% endif %}

    <!-- MAIN CONTENT INJECTION -->
    <main class="flex-1 flex flex-col h-full overflow-hidden min-w-0 bg-gray-50/50 relative z-10">
        
        <!-- 📱 MOBILE RESPONSIVE FIX: Functional Mobile Menu Toggle -->
        {% if user_role in ['Super Admin', 'Admin'] %}
        <div class="exec-mobile-sidebar-toggle flex items-center justify-between bg-kpi-red text-white p-4 shrink-0 shadow-md z-10">
            <h1 class="text-lg font-bold tracking-wide truncate min-w-0 pr-3">{{ brand.company_name or "Shwe Min Thar" }}</h1>
            <button type="button" class="exec-mobile-sidebar-button text-white hover:text-red-200 focus:outline-none" onclick="toggleMobileSidebar()" aria-label="Open navigation menu" aria-controls="mainSidebar" aria-expanded="false">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>
        {% endif %}

        <header class="app-topbar">
            <div class="app-topbar__context">
                <p class="app-topbar__eyebrow">Enterprise performance platform</p>
                <p class="app-topbar__title">{% block shell_context %}{{ user_role or 'Workspace' }} workspace{% endblock %}</p>
            </div>
            <div class="app-topbar__actions">
                <a class="app-topbar__icon" href="/notifications" aria-label="Open notifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 01-6 0v-1"/></svg>
                    <span id="topbarNotificationCount" class="app-notification-count" hidden></span>
                </a>
                <a href="/account/profile" class="app-topbar__identity" aria-label="My profile">
                    {{ avatar(user_avatar|default(current_user|default(none)), 32) }}
                    <div class="app-topbar__user">
                        <strong>{{ user_name or 'User' }}</strong>
                        <span>{{ user_role or 'Authorized user' }}</span>
                    </div>
                </a>
                <button type="button" class="app-topbar__icon" onclick="handleLogout()" aria-label="Sign out">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5m5 5H3m10-8V3a2 2 0 012-2h4a2 2 0 012 2v18a2 2 0 01-2 2h-4a2 2 0 01-2-2v-2"/></svg>
                </button>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto custom-scrollbar relative page-enter">
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- GLOBAL TOAST NOTIFICATIONS CONTAINER -->
    <div id="toastContainer" class="fixed top-5 right-5 z-[9999] flex flex-col space-y-3 max-w-[90%] sm:max-w-md w-full items-end"></div>

    <!-- 🌟 GLOBAL SCRIPTS 🌟 -->
    <script>
        // 🌟 SECURITY FIX: Global HTML Escape Function to prevent XSS
        window.escapeHTML = function(str) {
            if (!str) return "";
            return str.toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        };

        // 🌟 UX FIX: Universal Centralized Toast Function
        window.showToast = function(message, type = 'success') {
            let container = document.getElementById('toastContainer');
            if(!container) return;

            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-50 border-green-500 text-green-900' : 'bg-red-50 border-red-500 text-red-900';
            const icon = type === 'success' 
                ? `<svg class="w-5 h-5 text-green-500 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
                : `<svg class="w-5 h-5 text-red-500 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

            toast.className = `flex items-start p-3 sm:p-4 mb-3 border-l-4 rounded-xl shadow-lg w-full bg-white ${bgColor} toast-enter pointer-events-auto`;
            toast.innerHTML = `${icon}<div class="text-xs sm:text-sm font-medium flex-1">${window.escapeHTML(message)}</div>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.replace('toast-enter', 'toast-exit');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        };

        // 🛡️ AUTH FIX: Do not auto-logout on every 401/403 from task or permission checks.
        // Legitimate expired sessions should refresh once and then redirect only if refresh fails.
        const originalFetch = window.fetch;
        const AUTH_REFRESH_URL = '/api/v1/auth/refresh';

        function isAuthEndpoint(url) {
            if (!url) return false;
            const requestUrl = typeof url === 'string' ? url : url.url;
            if (!requestUrl) return false;
            let path;
            try {
                path = new URL(requestUrl, window.location.origin).pathname;
            } catch (error) {
                return false;
            }
            return path === '/api/v1/auth/login'
                || path === AUTH_REFRESH_URL
                || path === '/api/v1/auth/logout'
                || path.startsWith('/api/v1/auth/oauth/')
                || path.includes('/auth/swagger-login')
                || window.location.pathname.includes('/login');
        }

        function safeReturnPath() {
            const path = window.location.pathname;
            if (!path.startsWith('/') || path.startsWith('//') || path.includes('\\')
                || path.startsWith('/auth/')) return null;
            return path;
        }

        function safeLogoutFromExpiredSession(reason) {
            if (window.__authSessionLogoutTriggered) return;
            window.__authSessionLogoutTriggered = true;
            try {
                localStorage.removeItem('user');
            } catch (error) {
                console.warn('[AUTH] Could not clear stored session data.', error);
            }
            console.warn('[AUTH] Expired session detected:', reason);
            const returnPath = safeReturnPath();
            const query = new URLSearchParams({ session_expired: 'true' });
            if (returnPath) query.set('next', returnPath);
            window.location.href = `/auth/login?${query.toString()}`;
        }

        // Add a lock to serialize token refreshes
        let refreshPromise = null;

        async function refreshAccessTokenOnce() {
            // If a refresh is already in progress, return the existing promise
            if (refreshPromise) {
                console.info('[AUTH] Refresh already in progress, awaiting existing promise');
                return refreshPromise;
            }
            // Create a new promise for this refresh attempt
            refreshPromise = (async () => {
                try {
                    const refreshResponse = await originalFetch(AUTH_REFRESH_URL, {
                        method: 'POST',
                        credentials: 'include',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (refreshResponse.ok) {
                        console.info('[AUTH] Access token refreshed successfully.');
                        return true;
                    }

                    console.warn('[AUTH] Refresh failed:', refreshResponse.status);
                    return false;
                } catch (error) {
                    console.warn('[AUTH] Refresh request failed:', error);
                    return false;
                } finally {
                    // Reset the lock regardless of outcome
                    refreshPromise = null;
                }
            })();
            return refreshPromise;
        }

        function cloneFetchInit(init = {}) {
            const cloned = { ...init };
            if (cloned.headers && !(cloned.headers instanceof Headers)) {
                cloned.headers = { ...cloned.headers };
            }
            // Ensure credentials are included for same-origin requests
            if (!('credentials' in cloned)) {
                cloned.credentials = 'include';
            }
            return cloned;
        }

        window.fetch = async function(input, init = {}) {
            const url = typeof input === 'string' ? input : (input && input.url ? input.url : '');
            const isLoginPage = window.location.pathname.includes('/login');
            const isAuthRequest = isAuthEndpoint(url) || isLoginPage;

            try {
                let response = await originalFetch.apply(this, arguments);

                if ((response.status === 401 || response.status === 403) && !isAuthRequest) {
                    const isSessionExpired = response.status === 401;
                    if (isSessionExpired) {
                        console.warn('[AUTH] Unauthorized response received for:', url, 'Attempting refresh.');
                        const refreshed = await refreshAccessTokenOnce();
                        if (refreshed) {
                            const retryInit = cloneFetchInit(init);
                            if (retryInit.body !== undefined && retryInit.body !== null && typeof retryInit.body !== 'string' && !(retryInit.body instanceof FormData) && !(retryInit.body instanceof URLSearchParams) && !(retryInit.body instanceof Blob)) {
                                return response;
                            }
                            try {
                                const retryResponse = await originalFetch.apply(this, [input, retryInit]);
                                if (retryResponse.status !== 401) {
                                    return retryResponse;
                                }
                                console.warn('[AUTH] Retry still unauthorized:', url, retryResponse.status);
                                if (retryResponse.status === 401) {
                                    safeLogoutFromExpiredSession('401 after successful refresh for ' + url);
                                }
                                return retryResponse;
                            } catch (retryError) {
                                console.warn('[AUTH] Retry request failed:', retryError);
                            }
                        }
                        // If refresh failed for an expired session, logout
                        safeLogoutFromExpiredSession('401/refresh failure for ' + url);
                        return response;
                    } else {
                        // For 403 (permission/validation errors) just return the response without logging out
                        console.warn('[AUTH] Permission denied without forcing logout:', url, response.status);
                        return response;
                    }
                }

                return response;
            } catch (err) {
                throw err;
            }
        };

        // 📱 MOBILE RESPONSIVE FIX: Sidebar Toggle Logic
        function toggleMobileSidebar() {
            const sidebar = document.getElementById("mainSidebar");
            const backdrop = document.getElementById("sidebarBackdrop");
            if (sidebar && backdrop) {
                const isOpen = sidebar.classList.toggle("-translate-x-full") === false;
                backdrop.classList.toggle("hidden", !isOpen);
                document.querySelectorAll('[aria-controls="mainSidebar"]').forEach(button => {
                    button.setAttribute("aria-expanded", String(isOpen));
                });
                // Block background scrolling on mobile when sidebar is open
                document.body.classList.toggle("overflow-hidden");
            }
        }

        // --- LOGOUT LOGIC ---
        async function handleLogout() {
            if (!(await window.appConfirm('စနစ်မှ ထွက်ခွာရန် (Logout) သေချာပါသလား?', { title: 'Sign out?' }))) return;
            try {
                const response = await fetch('/api/v1/auth/logout', { method: 'POST', credentials: 'include' });
                if (!response.ok) {
                    window.showToast(await window.readServerError(response), 'error');
                    return;
                }
                localStorage.removeItem('user'); // 🌟 SECURITY: Clear local cache
                if (window.kpiClearFormDrafts) { try { window.kpiClearFormDrafts(); } catch (e) {} } // Drafts must not survive logout
                if (window.kpiPurgeOfflineCaches) { try { await window.kpiPurgeOfflineCaches(); } catch (e) {} } // Offline: cached pages/data must not survive logout
                window.location.replace('/auth/login');
            } catch (error) {
                console.error('Logout error:', error);
                window.showToast('ကွန်ရက် ချိတ်ဆက်မှု အမှားအယွင်း ရှိနေပါသည်။', 'error');
            }
        }

        // --- NOTIFICATION & SMART POLLING LOGIC ---
        const NOTIF_API_BASE = "/api/v1/notifications";
        let notifInterval;

        document.addEventListener("DOMContentLoaded", () => {
            fetchNotifications();
            startSmartPolling();
        });

        function startSmartPolling() {
            if (!notifInterval) {
                notifInterval = setInterval(fetchNotifications, 60000); // 1 မိနစ်တစ်ခါ Data ယူမည်
            }
        }

        // ⚡ PERFORMANCE FIX: Smart Polling (DDoS Prevention)
        document.addEventListener("visibilitychange", () => {
            if (document.hidden) {
                clearInterval(notifInterval);
                notifInterval = null;
            } else {
                fetchNotifications(); // Tab ပြန်ဖွင့်တာနဲ့ ချက်ချင်း ယူမည်
                startSmartPolling();
            }
        });

        // Dropdown ပြင်ပကိုနှိပ်ပါက ပိတ်ရန်
        document.addEventListener("click", (event) => {
            const notification = event.target.closest("[data-notification-id]");
            if (notification) {
                markAsRead(notification.dataset.notificationId);
                return;
            }
            const dropdown = document.getElementById("notifDropdown");
            const btn = document.getElementById("bellBtn");
            if (dropdown && !dropdown.classList.contains("hidden")) {
            if (!dropdown.contains(event.target) && (!btn || !btn.contains(event.target))) {
                    dropdown.classList.add("hidden");
                if (btn) btn.setAttribute("aria-expanded", "false");
                }
            }
        });

        function toggleNotifications(event) {
            if(event) event.stopPropagation();
            const dropdown = document.getElementById("notifDropdown");
            if(dropdown) {
                const isOpen = dropdown.classList.contains("hidden");
                if (isOpen) {
                    dropdown.classList.remove("hidden");
                    dropdown.classList.add("flex");
                } else {
                    dropdown.classList.add("hidden");
                    dropdown.classList.remove("flex");
                }
                const button = document.getElementById("bellBtn");
                if (button) button.setAttribute("aria-expanded", String(isOpen));
            }
        }

        async function fetchNotifications() {
            try {
                const [res, countResponse] = await Promise.all([
                    fetch(`${NOTIF_API_BASE}?limit=15`),
                    fetch(`${NOTIF_API_BASE}/unread-count`)
                ]);
                if (!res.ok) throw new Error(await window.readServerError(res));
                const notifications = await res.json();
                const unreadCount = countResponse.ok ? (await countResponse.json()).count : 0;
                renderNotifications(notifications, unreadCount);
            } catch (err) {
                const listContainer = document.getElementById("notifList");
                if (listContainer) {
                    const message = document.createElement("div");
                    message.className = "p-6 text-center text-red-600 text-xs font-medium";
                    message.append(document.createTextNode((window.displayErrorText ? window.displayErrorText(err) : "Unable to load notifications.") + " "));
                    const retry = document.createElement("button");
                    retry.type = "button";
                    retry.className = "underline font-bold";
                    retry.textContent = "Retry";
                    retry.addEventListener("click", fetchNotifications);
                    message.appendChild(retry);
                    listContainer.replaceChildren(message);
                }
                console.warn("[NOTIFICATIONS]", err);
            }
        }

        function renderNotifications(notifications, unreadCount = 0) {
            const listContainer = document.getElementById("notifList");
            const badge = document.getElementById("unreadBadge");
            if(!listContainer || !badge) return;
            
            if (unreadCount > 0) {
                badge.innerText = unreadCount > 99 ? '99+' : unreadCount;
                badge.classList.remove("hidden");
            } else {
                badge.classList.add("hidden");
            }

            if (notifications.length === 0) {
                const emptyMessage = document.createElement("div");
                emptyMessage.className = "p-6 text-center text-slate-400 text-xs font-medium";
                emptyMessage.textContent = "No new notifications";
                listContainer.replaceChildren(emptyMessage);
                return;
            }

            const notificationItems = notifications.map(notification => {
                const item = document.createElement("button");
                item.type = "button";
                item.className = `w-full text-left p-4 hover:bg-slate-50 transition flex gap-3 ${notification.is_read ? "bg-white" : "bg-blue-50/40"}`;
                item.addEventListener("click", () => viewNotificationDetail(notification.id));
                if (!notification.is_read) {
                    const dot = document.createElement("div");
                    dot.className = "w-2 h-2 rounded-full bg-blue-600 mt-1.5 shrink-0 shadow-sm";
                    item.appendChild(dot);
                }
                const content = document.createElement("div");
                content.className = "flex-1 min-w-0";
                const title = document.createElement("p");
                title.className = "text-[13px] font-extrabold text-blue-950 mb-0.5 truncate";
                title.textContent = notification.title || "Notification";
                const text = document.createElement("p");
                text.className = "text-[11px] text-slate-600 leading-snug line-clamp-2";
                text.textContent = notification.message || "";
                const createdAt = document.createElement("p");
                createdAt.className = "text-[9px] font-bold text-slate-400 mt-2";
                createdAt.textContent = formatAppDate(notification.created_at);
                content.append(title, text, createdAt);
                item.appendChild(content);
                return item;
            });
            listContainer.replaceChildren(...notificationItems);
        }

        function formatAppDate(value) {
            if (!value) return "";
            const normalized = /(?:Z|[+-]\d{2}:\d{2})$/.test(value) ? value : `${value}Z`;
            const date = new Date(normalized);
            if (Number.isNaN(date.getTime())) return "";
            return new Intl.DateTimeFormat(undefined, {
                timeZone: "Asia/Yangon",
                dateStyle: "medium",
                timeStyle: "short"
            }).format(date);
        }

        async function markAsRead(notifId) {
            try {
                await fetch(`${NOTIF_API_BASE}/${notifId}/read`, { method: "PUT" });
                fetchNotifications(); // ချက်ချင်း refresh လုပ်မည်
            } catch (err) {}
        }

        async function markAllAsRead() {
            try {
                await fetch(`${NOTIF_API_BASE}/read-all`, { method: "PUT" });
                fetchNotifications();
                toggleNotifications(); // ပိတ်မည်
            } catch (err) {}
        }
    </script>

    <!-- SPECIFIC PAGE SCRIPTS INJECTION -->
    {% block scripts %}{% endblock %}
    <script src="/static/js/notifications.js"></script>
    <script src="/static/js/sidebar-panels.js" defer></script>
    <script src="/static/js/submit-key.js"></script>
    <script src="/static/js/form-draft.js"></script>
    <script src="/static/js/sw-register.js"></script>
    <script src="/static/js/offline-ui.js"></script>

</body>
