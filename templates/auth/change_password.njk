<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password - KPI Platform</title>
    
    <link rel="stylesheet" href="/static/css/output.css">
    <link rel="stylesheet" href="/static/css/design-system.css?v=20261015-1">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root { color-scheme: light; --kpi-red: #9b1c1c; --kpi-cream: #e9f1f6; }
        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            background: var(--kpi-cream);
        }
        .password-card {
            animation: cardEnter 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
            border: 1px solid #dbe2ea;
            box-shadow: 0 8px 24px rgba(23, 33, 43, .08);
        }
        .password-input {
            min-height: 3rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }
        .password-input:focus {
            transform: translateY(-1px);
            box-shadow: 0 0 0 4px rgba(153, 27, 27, 0.12);
        }
        .password-toggle { min-width: 2.75rem; min-height: 2.75rem; border-radius: 0.5rem; }
        .password-toggle:focus-visible,
        #submitBtn:focus-visible {
            outline: 3px solid rgba(153, 27, 27, 0.3);
            outline-offset: 2px;
        }
        @keyframes cardEnter {
            from { opacity: 0; transform: translateY(14px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
        .toast-enter { animation: toastIn 0.3s ease-out forwards; }
        .toast-exit { animation: toastOut 0.3s ease-in forwards; }
        @keyframes toastIn { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        @keyframes toastOut { from { transform: translateY(0); opacity: 1; } to { transform: translateY(100%); opacity: 0; } }
    </style>
</head>
<body class="bg-kpi-cream min-h-screen flex items-start sm:items-center justify-center p-4 sm:p-6 lg:p-8 relative overflow-x-hidden overflow-y-auto antialiased">

    <!-- Toast Container -->
    <!-- 🌟 RESPONSIVE FIX: Toast container width adjusted for mobile -->
    <div id="toastContainer" class="app-toast-container"></div>

    <!-- 🌟 RESPONSIVE FIX: Adjusted padding and max-width for smaller screens -->
    <div class="password-card bg-white rounded-3xl shadow-xl border border-gray-100 w-full max-w-md p-6 sm:p-8 md:p-10 transform transition-all">
        
        <!-- Header -->
        <div class="text-center mb-6 sm:mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-red-50 mb-4 sm:mb-5 border border-red-100">
                <svg class="w-7 h-7 sm:w-8 sm:h-8 text-red-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"></path>
                </svg>
            </div>
            <!-- 🌟 RESPONSIVE FIX: Text sizes adjusted -->
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">Secure Your Account</h2>
            <p class="text-xs sm:text-sm text-gray-500 mt-2 leading-relaxed">For security reasons, you must update your initial password before accessing the dashboard.</p>
        </div>

        <form id="changePasswordForm" class="flex flex-col gap-5 sm:gap-6">
            
            <!-- Current Password -->
            <div>
                <label for="oldPassword" class="block text-xs sm:text-sm font-semibold text-gray-700 mb-1.5">Current Password</label>
                <div class="relative group">
                    <input type="password" id="oldPassword" autocomplete="current-password" required 
                           class="password-input w-full pl-4 pr-12 py-2.5 sm:py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-800/20 focus:border-red-800 text-sm transition placeholder-gray-400"
                           placeholder="Enter temporary password">
                    <button type="button" onclick="togglePassword('oldPassword')" class="password-toggle absolute inset-y-0 right-1 flex items-center justify-center text-gray-400 hover:text-gray-600 focus:outline-none transition-colors" aria-label="Show current password" aria-pressed="false">
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="eye-oldPassword">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- New Password -->
            <div>
                <label for="newPassword" class="block text-xs sm:text-sm font-semibold text-gray-700 mb-1.5">New Password</label>
                <div class="relative group">
                    <input type="password" id="newPassword" autocomplete="new-password" required 
                           class="password-input w-full pl-4 pr-12 py-2.5 sm:py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-800/20 focus:border-red-800 text-sm transition placeholder-gray-400"
                           placeholder="Create a strong password">
                    <button type="button" onclick="togglePassword('newPassword')" class="password-toggle absolute inset-y-0 right-1 flex items-center justify-center text-gray-400 hover:text-gray-600 focus:outline-none transition-colors" aria-label="Show new password" aria-pressed="false">
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="eye-newPassword">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>

                <!-- Requirements List -->
                <!-- 🌟 RESPONSIVE FIX: Adjusted padding and text size for mobile -->
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-2.5 sm:p-3 mt-3">
                    <p class="text-[10px] sm:text-xs font-semibold text-gray-600 mb-2">Password Requirements:</p>
                    <ul class="text-[10px] sm:text-[11px] text-gray-500 space-y-1.5 flex flex-col">
                        <li class="flex items-center"><svg class="w-3 h-3 text-gray-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Minimum 12 characters</li>
                        <li class="flex items-center"><svg class="w-3 h-3 text-gray-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Uppercase & lowercase letters</li>
                        <li class="flex items-center"><svg class="w-3 h-3 text-gray-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> At least one number & symbol</li>
                    </ul>
                </div>
            </div>

            <!-- Confirm New Password -->
            <div>
                <label for="confirmPassword" class="block text-xs sm:text-sm font-semibold text-gray-700 mb-1.5">Confirm Password</label>
                <div class="relative group">
                    <input type="password" id="confirmPassword" autocomplete="new-password" required 
                           class="password-input w-full pl-4 pr-12 py-2.5 sm:py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-800/20 focus:border-red-800 text-sm transition placeholder-gray-400"
                           placeholder="Re-enter new password">
                    <button type="button" onclick="togglePassword('confirmPassword')" class="password-toggle absolute inset-y-0 right-1 flex items-center justify-center text-gray-400 hover:text-gray-600 focus:outline-none transition-colors" aria-label="Show password confirmation" aria-pressed="false">
                        <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="eye-confirmPassword">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <p id="passwordMatchError" class="text-[10px] sm:text-xs text-red-500 mt-2 hidden font-medium flex items-center">
                    <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Passwords do not match.
                </p>
            </div>

            <!-- 🌟 RESPONSIVE FIX: Button padding adjusted -->
            <button type="submit" id="submitBtn" 
                    class="w-full bg-red-800 hover:bg-red-900 text-white font-bold py-3 sm:py-3.5 px-4 rounded-xl transition duration-200 shadow-sm flex justify-center items-center text-sm">
                <span>Update Password</span>
            </button>

        </form>
    </div>

    <script src="/static/js/csp-event-bridge.js"></script>
    <script src="/static/js/csrf.js"></script>
    <script src="/static/js/notifications.js"></script>
    <script>
        // 🌟 SECURITY FIX: Global HTML Escape Function to prevent XSS
        function escapeHTML(str) {
            if (!str) return "";
            return str.toString()
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const eyeIcon = document.getElementById('eye-' + inputId);
            
            if (input.type === 'password') {
                input.type = 'text';
                eyeIcon.parentElement.setAttribute('aria-label', 'Hide password');
                eyeIcon.parentElement.setAttribute('aria-pressed', 'true');
                eyeIcon.innerHTML = `
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                `;
            } else {
                input.type = 'password';
                eyeIcon.parentElement.setAttribute('aria-label', 'Show password');
                eyeIcon.parentElement.setAttribute('aria-pressed', 'false');
                eyeIcon.innerHTML = `
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                `;
            }
        }

        // 🌟 RESPONSIVE FIX: Toast HTML structured to not break on small screens
        function showToastLegacy(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            const bgColor = type === 'success' ? 'bg-green-50 border-green-500 text-green-900' : 'bg-red-50 border-red-500 text-red-900';
            const icon = type === 'success' 
                 ? `<svg class="w-5 h-5 sm:w-6 sm:h-6 text-green-500 mt-0.5 mr-2 sm:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`
                : `<svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-500 mt-0.5 mr-2 sm:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

            toast.className = `toast-enter flex items-start p-3 sm:p-4 border-l-4 rounded-xl shadow-lg w-full max-w-sm bg-white ${bgColor} transition-all duration-300 pointer-events-auto ml-auto`;
            // 🌟 SECURITY FIX: Render only escaped HTML to prevent XSS Attack
            toast.innerHTML = `
                <div class="mr-2 sm:mr-3 mt-0.5">${icon}</div>
                <div class="flex-1">
                    <h4 class="font-bold text-xs sm:text-sm ${type === 'success' ? 'text-green-800' : 'text-red-900'}">${type === 'success' ? 'Success' : 'Update Failed'}</h4>
                    <p class="text-[10px] sm:text-xs mt-1 ${type === 'success' ? 'text-green-700' : 'text-red-700'} leading-relaxed">${escapeHTML(message)}</p>
                </div>
                <button onclick="this.parentElement.remove()" class="ml-2 sm:ml-3 text-gray-400 hover:text-gray-600 focus:outline-none shrink-0">
                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                if(toast.parentElement) {
                    toast.classList.replace('toast-enter', 'toast-exit');
                    setTimeout(() => toast.remove(), 300);
                }
            }, 5000);
        }

        document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const matchError = document.getElementById('passwordMatchError');
            const submitBtn = document.getElementById('submitBtn');

            if (newPassword !== confirmPassword) {
                matchError.classList.remove('hidden');
                document.getElementById('confirmPassword').classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
                return;
            } else {
                matchError.classList.add('hidden');
                document.getElementById('confirmPassword').classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
            }

            const csrfCookie = document.cookie
                .split('; ')
                .find((cookie) => cookie.startsWith('csrf_token='));
            const csrfToken = csrfCookie?.slice('csrf_token='.length);
            if (!csrfToken) {
                window.showToast('Security token is unavailable. Reload this page and try again.', 'error');
                return;
            }

            const originalBtnText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 sm:h-5 sm:w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span>Updating...</span>`;

            try {
                const response = await fetch('/api/v1/auth/change-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    credentials: 'include', 
                    body: JSON.stringify({
                        old_password: oldPassword,
                        new_password: newPassword,
                        confirm_new_password: confirmPassword
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    window.showToast(data.message || 'Password updated successfully.', 'success');
                    
                    setTimeout(() => {
                        // Password changes revoke existing sessions. Preserve only a
                        // validated same-origin destination for the next login.
                        const next = new URLSearchParams(window.location.search).get('next');
                        let target = '/dashboard';
                        if (next && next.startsWith('/') && !next.startsWith('//')
                            && !next.includes('\\') && !/[?#\u0000-\u001f]/.test(next)
                            && !next.startsWith('/auth/') && !next.startsWith('/api/')) {
                            try {
                                const parsed = new URL(next, window.location.origin);
                                if (parsed.origin === window.location.origin && parsed.pathname === next) {
                                    target = next;
                                }
                            } catch (error) {
                                target = '/dashboard';
                            }
                        }
                        window.location.href = `/auth/login?next=${encodeURIComponent(target)}`;
                    }, 2000);
                } else {
                    window.showToast(data.detail || 'Failed to update password.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                }
            } catch (error) {
                window.showToast('A network error occurred. Please try again.', 'error');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
            }
        });
    </script>
</body>
</html>