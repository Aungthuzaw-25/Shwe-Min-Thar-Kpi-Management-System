                    <button type="button" id="resetSubmitBtn" class="w-1/2 py-2.5 sm:py-3 bg-red-800 text-white rounded-lg text-xs sm:text-sm font-bold hover:bg-red-900 flex justify-center items-center">Send Reset Link</button>
