    <script src="/static/js/dialog.js"></script>
    <script>
    // Offline: arriving at the login page must leave no previous user's
    // cached pages/data behind (covers logout and session-expiry paths).
    // The shell cache stays — it holds only public assets + the
    // generic offline notice, no user data.
    (function () {
        try {
            if ('caches' in window) {
                caches.keys().then(function (names) {
                    names.forEach(function (name) {
                        if (name.indexOf('kpi-') === 0 && name.indexOf('kpi-shell-') !== 0) caches.delete(name);
                    });
                });
            }
            if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
                navigator.serviceWorker.controller.postMessage({ type: 'PURGE_PRIVATE' });
            }
        } catch (e) {}
    })();
    </script>
    <script>
        // 🌟 SECURITY FIX: Global HTML Escape Function to prevent XSS
        function escapeHTML(str) {
            if (!str) return "";
            return str.toString()
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        // --- Toast Notification System ---
        function showToastLegacy(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-50 border-green-500 text-green-800' : 'bg-red-50 border-red-500 text-red-900';
            const icon = type === 'success' 
                 ? '<svg class="w-5 h-5 sm:w-6 sm:h-6 text-green-500 mt-0.5 mr-2 sm:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
                : '<svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-500 mt-0.5 mr-2 sm:mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
            
            toast.className = `flex items-start p-3 sm:p-4 border-l-4 rounded-xl shadow-lg toast-enter ${bgColor} w-full bg-white transition-all duration-300 pointer-events-auto ml-auto`;
            // 🌟 SECURITY FIX: Render only escaped HTML to prevent XSS Attack
            toast.innerHTML = `
                <div class="mr-2 sm:mr-3 mt-0.5">${icon}</div>
                <div class="flex-1">
                    <h4 class="font-bold text-xs sm:text-sm ${type === 'success' ? 'text-green-800' : 'text-red-900'}">${type === 'success' ? 'Success' : 'Sign In Failed'}</h4>
                    <p class="text-[10px] sm:text-xs mt-1 ${type === 'success' ? 'text-green-700' : 'text-red-700'} leading-relaxed">${escapeHTML(message)}</p>
                </div>
                <button onclick="this.parentElement.remove()" class="ml-2 sm:ml-3 text-gray-400 hover:text-gray-600 focus:outline-none shrink-0">
                    <svg class="w-3 h-3 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                if(toast.parentElement) {
                    toast.classList.replace('toast-enter', 'toast-exit');
                    setTimeout(() => toast.remove(), 300);
                }
            }, 5000);
        }

        function openForgotPasswordModal() {
            document.getElementById('forgotPasswordModal').classList.remove('hidden');
            window.SharedDialog && window.SharedDialog.open(document.getElementById('forgotPasswordModal'), closeForgotPasswordModal);
        }
        
        function closeForgotPasswordModal() {
            window.SharedDialog && window.SharedDialog.close(document.getElementById('forgotPasswordModal'));
            document.getElementById('forgotPasswordModal').classList.add('hidden');
            document.getElementById('resetAlert').classList.add('hidden');
            document.getElementById('forgotPasswordForm').reset();
        }

        document.getElementById('toggleLoginPassword').addEventListener('click', function () {
            const input = document.getElementById('password');
            const icon = document.getElementById('loginPasswordIcon');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            this.setAttribute('aria-pressed', String(isHidden));
            icon.innerHTML = isHidden
                ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18M10.584 10.587a2 2 0 002.829 2.828M9.88 4.24A10.07 10.07 0 0112 4c4.478 0 8.268 2.943 9.542 7a9.96 9.96 0 01-1.507 2.946M6.228 6.228A9.96 9.96 0 002.458 11c1.274 4.057 5.064 7 9.542 7a10.07 10.07 0 003.607-.665"></path>'
                : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>';
        });

        // 🌟 UX FIX: Forgot Password Form Submission Handler
        document.getElementById('forgotPasswordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = document.getElementById('resetSubmitBtn');
            const alertBox = document.getElementById('resetAlert');
            const email = document.getElementById('resetEmail').value;
            
            if(!email) return;

            btn.innerHTML = `<span class="app-spinner" style="margin-right:0"></span>`;
            btn.disabled = true;

            // Fake an API call since Reset Password backend is not implemented yet
            setTimeout(() => {
                alertBox.classList.remove('hidden');
                alertBox.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
                alertBox.innerHTML = `<strong>Action Required:</strong> For security reasons, automated password reset is disabled. Please contact your System Administrator to reset your password manually.`;
                
                btn.innerHTML = "Send Reset Link";
                btn.disabled = false;
            }, 1000);
        });

        const rememberedEmail = localStorage.getItem('remembered_email');
        if (rememberedEmail) {
            document.getElementById('email').value = rememberedEmail;
            document.getElementById('remember-me').checked = true;
        }

        // Provider buttons are rendered by the server only when that
        // provider is configured (oauth_providers from /branding/public),
        // so there is nothing to show/hide here.
        const oauthButtons = [...document.querySelectorAll('.oauth-provider-btn')];
        oauthButtons.forEach((button) => {
            button.addEventListener('click', () => {
                document.querySelectorAll('.oauth-provider-btn').forEach((item) => {
                    item.disabled = true;
                    item.classList.add('opacity-60', 'cursor-wait');
                });
                const label = button.querySelector('.oauth-btn-label');
                if (label) label.textContent = 'Redirecting...';
                const remember = document.getElementById('remember-me').checked ? '?remember_me=true' : '';
                window.location.assign(`/api/v1/auth/${button.dataset.oauthProvider}/start${remember}`);
            });
        });

        const oauthError = new URLSearchParams(window.location.search).get('oauth_error');
        if (oauthError) {
            window.showToast(oauthError, 'error');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        const loginQuery = new URLSearchParams(window.location.search);
        if (loginQuery.get('session_expired') === 'true') {
            document.getElementById('sessionExpiredNotice').classList.remove('hidden');
        }
        const allowedPostLoginPaths = new Set(['/dashboard', '/admin/dashboard', '/superadmin/dashboard']);
        function normalizePostLoginPath(path) {
            if (!path || !path.startsWith('/') || path.startsWith('//')
                || path.includes('\\') || /[?#\u0000-\u001f]/.test(path)
                || path.startsWith('/auth/') || path.startsWith('/api/')) return null;
            try {
                const parsed = new URL(path, window.location.origin);
                return parsed.origin === window.location.origin && parsed.pathname === path
                    ? path
                    : null;
            } catch (error) {
                return null;
            }
        }
        const requestedPostLoginPath = normalizePostLoginPath(loginQuery.get('next'));
        const safePostLoginPath = allowedPostLoginPaths.has(requestedPostLoginPath)
            ? requestedPostLoginPath
            : null;
        const dashboardPathFor = (user) => {
            const roleName = user?.role?.name || '';
            if (roleName === 'Super Admin') return '/superadmin/dashboard';
            if (roleName === 'Admin' || roleName === 'HR') return '/admin/dashboard';
            return '/dashboard';
        };

        let lockoutCountdownTimer = null;
        function showLoginLockout(detail) {
            const alert = document.getElementById('loginLockoutAlert');
            const countdown = document.getElementById('loginLockoutCountdown');
            const notifyButton = document.getElementById('unlockRequestButton');
            document.getElementById('loginLockoutMessage').textContent = detail.message ||
                'Your account has been locked due to multiple failed login attempts. Please notify the Super Admin to request an immediate unlock.';
            alert.classList.remove('hidden');
            let remaining = Math.max(0, Number(detail.remaining_seconds) || 0);
            const renderCountdown = () => {
                if (remaining <= 0) {
                    countdown.textContent = 'Cooldown elapsed. Try signing in again.';
                    notifyButton.disabled = true;
                    if (lockoutCountdownTimer) window.clearInterval(lockoutCountdownTimer);
                    return;
                }
                const minutes = Math.floor(remaining / 60);
                const seconds = remaining % 60;
                countdown.textContent = `${minutes}m ${String(seconds).padStart(2, '0')}s`;
                remaining -= 1;
            };
            if (lockoutCountdownTimer) window.clearInterval(lockoutCountdownTimer);
            notifyButton.disabled = false;
            renderCountdown();
            lockoutCountdownTimer = window.setInterval(renderCountdown, 1000);
        }

        document.getElementById('unlockRequestButton').addEventListener('click', async () => {
            const button = document.getElementById('unlockRequestButton');
            const email = document.getElementById('email').value.trim();
            if (!email) {
                window.showToast('Enter the locked account email address first.', 'error');
                return;
            }
            button.disabled = true;
            try {
                const response = await fetch('/api/v1/auth/unlock-requests', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ email })
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(typeof result.detail === 'string' ? result.detail : 'Unable to send the unlock request.');
                }
                window.showToast(
                    result.message || 'Unlock request has been sent to the Super Admin.',
                    result.accepted ? 'success' : 'warning'
                );
            } catch (error) {
                window.showToast(error.message || 'Unable to send the unlock request.', 'error');
            } finally {
                button.disabled = false;
            }
        });

        // Authenticator (TOTP) second step. The backend checks the
        // password first: only an enrolled Super Admin whose password
        // was accepted gets MFA_REQUIRED, and only then is this step
        // shown. The code is submitted together with the SAME email +
        // password — no backend change, no new endpoint, no new param
        // beyond the totp_code the JSON login already accepts.
        const otpBoxesEl = document.getElementById('otpBoxes');
        const otp = window.OtpInput ? window.OtpInput.create(otpBoxesEl) : null;
        let otpStep = false;
        function setLoginStep(showOtp) {
            otpStep = showOtp;
            document.querySelectorAll('[data-login-step="password"]').forEach((el) => {
                el.classList.toggle('hidden', showOtp);
            });
            document.querySelectorAll('[data-login-step="otp"]').forEach((el) => {
                el.classList.toggle('hidden', !showOtp);
            });
            document.getElementById('loginSubmitBtn').innerText = showOtp ? 'Verify code' : 'Sign in';
            if (showOtp && otp) {
                otp.clear();
                otp.focus();
            } else if (otp) {
                otp.clear();
            }
        }
        document.getElementById('otpBackBtn').addEventListener('click', () => setLoginStep(false));

        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const rememberMe = document.getElementById('remember-me').checked;
            const submitBtn = document.getElementById('loginSubmitBtn');
            document.getElementById('loginLockoutAlert').classList.add('hidden');

            // On the code step, an incomplete code never reaches the
            // backend: focus the first empty box instead.
            let totpCode = null;
            if (otpStep) {
                if (!otp) {
                    window.showToast('Authenticator input failed to load. Please reload the page.', 'error');
                    return;
                }
                totpCode = otp.getValue();
                if (totpCode.length !== 6) {
                    const empty = otp.boxes.find((box) => !box.value) || otp.boxes[0];
                    empty.focus();
                    return;
                }
            }

            submitBtn.innerHTML = `<span class="app-spinner"></span>Signing in...`;
            submitBtn.disabled = true;

            try {
                const body = { email, password, remember_me: rememberMe };
                if (totpCode) body.totp_code = totpCode;
                const response = await fetch('/api/v1/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(body)
                });

                if (response.ok) {
                    const data = await response.json();

                    if (rememberMe) {
                        localStorage.setItem("remembered_email", email);
                    } else {
                        localStorage.removeItem("remembered_email");
                    }
                    if (data.must_change_password) {
                        const destination = safePostLoginPath || dashboardPathFor(data.user);
                        window.location.href = `/auth/change-password?next=${encodeURIComponent(destination)}`;
                    } else {
                        const userData = data.user;
                        if(userData) {
                            localStorage.setItem("user", JSON.stringify(userData));
                            window.location.href = safePostLoginPath || dashboardPathFor(userData);
                        } else {
                            const userRole = data.access_token ? JSON.parse(atob(data.access_token.split('.')[1])).role : '';
                            const roleLower = userRole.toLowerCase();

                            if (roleLower === 'super admin' || roleLower === 'admin') {
                                window.location.href = '/superadmin/dashboard';
                            } else {
                                window.location.href = '/dashboard';
                            }
                        }
                    }
                } else {
                    // Text-first read: a non-JSON error body (e.g. a 502 HTML
                    // page) must show its status, not fall into the catch
                    // below and masquerade as a network error.
                    const errorText = await response.text().catch(() => "");
                    let errorData = null;
                    try { errorData = errorText ? JSON.parse(errorText) : {}; } catch (_) { errorData = null; }
                    if (errorData === null) {
                        window.showToast(`Server error (${response.status})`, 'error');
                    } else if (errorData.detail?.code === 'MFA_REQUIRED') {
                        // Password accepted, code required: show the OTP
                        // step. The backend message is the step's helper
                        // text already, so no toast is needed here.
                        setLoginStep(true);
                    } else if (errorData.detail?.code === 'MFA_INVALID') {
                        // Wrong, frozen, or replayed code: plain message,
                        // boxes cleared for a fresh retry, stay on step.
                        window.showToast(errorData.detail.message || 'Invalid authenticator code.', 'error');
                        if (otpStep && otp) {
                            otp.clear();
                            otp.focus();
                        }
                    } else if (errorData.detail?.code === 'MFA_UNAVAILABLE') {
                        // Config problem on the server (fail-closed 503):
                        // plain message, stay on the step for a retry.
                        window.showToast(errorData.detail.message || 'Authenticator verification is not available right now.', 'error');
                    } else if (response.status === 403 && errorData.detail?.code === 'ACCOUNT_LOCKED') {
                        showLoginLockout(errorData.detail);
                    } else {
                        const detail = errorData.detail;
                        window.showToast(typeof detail === 'string' ? detail : 'Invalid email or password.', 'error');
                    }
                }
            } catch (error) {
                console.error("Network error:", error);
                window.showToast("A network error occurred. Please try again.", "error");
            } finally {
                // Step-aware (not originalText): a password submit that
                // lands on MFA_REQUIRED enters the OTP step mid-handler,
                // and the button must stay 'Verify code' afterwards.
                submitBtn.innerText = otpStep ? 'Verify code' : 'Sign in';
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
