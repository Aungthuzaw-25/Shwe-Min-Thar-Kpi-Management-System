<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shwe Min Thar - Sign In</title>
    
    <link rel="stylesheet" href="/static/css/output.css">
    <link rel="stylesheet" href="/static/css/design-system.css?v=20261015-1">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            color-scheme: light;
            --kpi-red: #9b1c1c;
            --kpi-red-dark: #790d16;
            --kpi-cream: #f2f7fa;
            --kpi-ink: #1c2b3a;
            --kpi-muted: #4E657D;
        }

        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            background: #450a0a;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
        }

        /* One screen, never taller: the animated page fills the viewport
           and never scrolls. Brand/form columns scroll internally only
           when the screen is too short for their content. */
        .la-page {
            display: flex;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #450a0a 0%, #7f1d1d 55%, #991b1b 100%);
        }
        .la-header {
            position: relative;
            z-index: 1;
            flex-shrink: 0;
            padding: 0.8rem 0 0 1.25rem;
            display: flex;
        }
        .la-logo { display: flex; align-items: center; gap: 0.75rem; }
        .la-logo-mark {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 0.75rem;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
            flex-shrink: 0;
        }
        .la-logo-mark img { width: 100%; height: 100%; border-radius: 0.5rem; object-fit: cover; display: block; }
        .la-logo-name { font-size: 1.35rem; font-weight: 700; letter-spacing: 0.02em; line-height: 1.1; color: #fff; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
        .la-logo-tag { font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: #fecaca; }

        /* Page-level waves BEHIND everything (z-index 0, no pointer events). */
        .la-waves, .la-lum {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }
        .la-waves .ribbon { animation: laWaveDrift 14s ease-in-out infinite alternate; transform-origin: center; }
        .la-waves .ribbon.r2 { animation-duration: 18s; animation-delay: -4s; }
        .la-waves .ribbon.r3 { animation-duration: 11s; animation-delay: -2s; }
        .la-waves .ribbon.r4 { animation-duration: 22s; animation-delay: -8s; }
        .la-waves .ribbon.r5 { animation-duration: 9s; animation-delay: -1s; }
        .la-waves .ribbon.r6 { animation-duration: 26s; animation-delay: -12s; }
        @keyframes laWaveDrift {
            from { transform: translate(0, 0) scale(1) rotate(0deg); }
            to { transform: translate(-4%, 3%) scale(1.12) rotate(-3deg); }
        }
        .la-lum .lum { animation: laLumDrift 16s ease-in-out infinite alternate; transform-origin: center; }
        .la-lum .lum.l2 { animation-duration: 12s; animation-delay: -3s; }
        .la-lum .lum.l3 { animation-duration: 20s; animation-delay: -6s; }
        .la-lum .lum.l4 { animation-duration: 14s; animation-delay: -9s; }
        @keyframes laLumDrift {
            from { transform: translateX(-2%) translateY(0); }
            to { transform: translateX(2%) translateY(-2%); }
        }

        .la-main { display: flex; flex-direction: column; flex: 1; min-height: 0; position: relative; z-index: 1; overflow-y: auto; }
/* Mobile/tablet: the main column itself scrolls (hero -> form -> features).
   Children size to content so there is exactly one scroll, not nested ones. */
.la-main > section, .la-main > .la-form-wrap { flex: none; }
        /* Hero and features are separate sections so mobile/tablet DOM order
           is hero -> form -> features; desktop grid puts them back into
           the left column (see the 1024px rules). */
        .la-hero {
            position: relative;
            color: #fff;
            background: none;
            padding: 2rem 1.25rem 0;
        }
        .la-features-wrap {
            position: relative;
            color: #fff;
            background: none;
            padding: 0 1.25rem 2rem;
        }
        .la-hero-title {
            margin: 0;
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: -0.01em;
            font-size: 2.4rem;
        }
        .la-hero-title .line1 { display: block; color: #fff; font-weight: 500; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35); }
        .la-hero-title .line2 { display: block; color: #fff; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35); }
        .la-hero-sub { margin: 1rem 0 0; font-size: 0.95rem; line-height: 1.6; color: #fee2e2; }
        .la-features { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
        .la-feature { text-align: center; }
        .la-feature-icon {
            width: 2.75rem;
            height: 2.75rem;
            margin: 0 auto 0.5rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .la-feature-icon svg { width: 1.25rem; height: 1.25rem; stroke: #fff; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .la-feature h4 { margin: 0 0 0.15rem; font-size: 0.8rem; color: #fff; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
        .la-feature p { margin: 0; font-size: 0.7rem; color: #fecaca; line-height: 1.4; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45); }

        .la-form-wrap {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 1.5rem 1rem;
            position: relative;
            z-index: 1;
            overflow-y: visible;
        }
        /* Auto margins (not align-items: center): the card stays centered
           when it fits, but when it is taller than the column it starts
           at the top and scrolls from the top — centered flex items clip
           their unreachable top on overflow. */
        .la-form-wrap .login-card { margin-top: auto; margin-bottom: auto; }

        .login-card {
            animation: cardEnter 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
            border: 1px solid #dbe2ea;
            box-shadow: 0 8px 24px rgba(23, 33, 43, 0.08);
        }
        .login-input {
            min-height: 3rem;
            background: #fff;
            color: var(--kpi-ink);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }
        .login-input:focus {
            transform: translateY(-1px);
            box-shadow: 0 0 0 4px rgba(153, 27, 27, 0.12);
        }
        .password-toggle {
            min-width: 2.75rem;
            min-height: 2.75rem;
            border-radius: 0.5rem;
        }
        .password-toggle:focus-visible,
        .login-submit:focus-visible {
            outline: 3px solid rgba(153, 27, 27, 0.3);
            outline-offset: 2px;
        }
        .login-submit {
            min-height: 3rem;
            background: var(--kpi-red);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }
        .login-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(127, 29, 29, 0.22);
            filter: brightness(1.05);
        }
        .login-submit:disabled { cursor: wait; opacity: 0.75; }

        /* Full-width bottom ticker: transparent, no board, no border. */
        .la-ticker {
            position: relative;
            z-index: 1;
            flex-shrink: 0;
            overflow: hidden;
            padding: 0.6rem 0 1rem;
        }
        .la-ticker .la-track {
            display: flex;
            width: max-content;
            white-space: nowrap;
            animation: laTickerScroll 18s linear infinite;
        }
        .la-ticker .la-track span {
            font-family: "Courier New", ui-monospace, monospace;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.3em;
            color: #fecaca;
            text-shadow: 0 0 10px rgba(254, 202, 202, 0.65);
            padding-right: 1rem;
        }
        @keyframes laTickerScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

        @keyframes cardEnter {
            from { opacity: 0; transform: translateY(14px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @media (max-width: 640px) {
            .toast-container { top: 0.75rem; right: 0.75rem; left: 0.75rem; max-width: none; }
            /* Compact phone banner so more of the form fits first paint. */
            .la-hero { padding: 1.5rem 1.25rem 0; }
            .la-features-wrap { padding: 0 1.25rem 1.5rem; }
            .la-hero-title { font-size: 2rem; }
            .la-features { margin-top: 1.25rem; }
            .la-form-wrap { padding: 1rem; }
            .la-form-wrap .login-card { padding: 1.25rem; }
        }
        @media (min-width: 640px) {
            .la-hero { padding: 2.5rem 2rem 0; }
            .la-features-wrap { padding: 0 2rem 2rem; }
            .la-hero-title { font-size: 3.4rem; }
            .la-features { grid-template-columns: repeat(4, 1fr); }
            .la-form-wrap { padding: 2rem; }
        }
        @media (min-width: 1024px) {
            /* Desktop: grid puts hero + features back into the left column
               (hero row 1, features row 2, pinned to the bottom like the
               old space-between brand panel) and the form spans both rows. */
            .la-main {
                display: grid;
                grid-template-columns: 50% 50%;
                grid-template-rows: auto 1fr;
                grid-template-areas: "hero form" "features form";
                overflow: visible;
            }
            .la-hero { grid-area: hero; padding: 3rem 3rem 0; }
            .la-hero-title { font-size: 4.2rem; }
            .la-hero-sub { font-size: 1.1rem; }
            .la-features-wrap { grid-area: features; align-self: end; padding: 0 3rem 3rem; }
            .la-form-wrap { grid-area: form; padding: 2rem; min-height: 0; overflow-y: auto; }
        }
        @media (min-width: 1280px) {
            .la-hero-title { font-size: 5rem; }
            .la-hero { padding: 3.5rem 3.5rem 0; }
            .la-features-wrap { padding: 0 3.5rem 3.5rem; }
        }
        /* Short screens: shrink so everything still fits one screen. */
        @media (min-width: 1024px) and (max-height: 780px) {
            .la-hero { padding: 1.5rem 2.5rem 0; }
            .la-features-wrap { padding: 0 2.5rem 1.5rem; }
            .la-hero-title { font-size: 3rem; }
            .la-hero-sub { margin-top: 0.5rem; font-size: 1rem; }
            .la-features { margin-top: 1.25rem; }
        }
        @media (max-width: 1023px) and (max-height: 780px) {
            .la-header { padding-top: 0.5rem; }
            .la-hero { padding: 1.25rem 1.25rem 0; }
            .la-features-wrap { padding: 0 1.25rem 1.25rem; }
            .la-hero-title { font-size: 2rem; }
            .la-features { margin-top: 1rem; }
            .la-form-wrap { padding: 1rem; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* Toast Animation CSS */
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
        .toast-enter { animation: slideIn 0.3s ease-out forwards; }
        .toast-exit { animation: fadeOut 0.3s ease-out forwards; }
    </style>
