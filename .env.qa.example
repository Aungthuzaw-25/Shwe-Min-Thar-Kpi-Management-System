PROJECT_NAME="Enterprise KPI System QA"
VERSION="1.0.0"
ENV=qa
SECRET_KEY="replace-with-a-local-only-qa-secret-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_SSL_REQUIRED=false

QA_POSTGRES_DB=kpi_qa
QA_POSTGRES_USER=kpi_qa
QA_POSTGRES_PASSWORD="replace-with-a-local-only-qa-password"
QA_DATABASE_HOST=postgres-qa
QA_DATABASE_PORT=5432
QA_DATABASE_NAME=kpi_qa
DATABASE_URL="postgresql+asyncpg://kpi_qa:replace-with-a-local-only-qa-password@postgres-qa:5432/kpi_qa"

REDIS_URL="redis://redis-qa:6379/0"
USE_S3=true
S3_ENDPOINT="http://minio-qa:9000"
S3_ACCESS_KEY="qa-minio-user"
S3_SECRET_KEY="replace-with-a-local-only-qa-storage-secret"
S3_BUCKET_NAME="kpi-evidence-qa"
QA_MINIO_ROOT_USER="qa-minio-user"
QA_MINIO_ROOT_PASSWORD="replace-with-a-local-only-qa-storage-secret"

ALLOWED_ORIGINS="http://127.0.0.1:18000"
ENABLE_SCHEDULER=true
RUN_SCHEDULER=false
SKIP_DATABASE_SEED=true
SKIP_DATABASE_MIGRATIONS=true
QA_SEED_PASSWORD="replace-with-a-local-only-qa-user-password"
SEED_TEST_ACCOUNTS_ENABLED=false
MAIL_ENABLED=false
