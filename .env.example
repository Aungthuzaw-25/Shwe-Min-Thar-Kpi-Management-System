PROJECT_NAME="Enterprise KPI System"
VERSION="1.0.0"
ENV=production
SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Neon PostgreSQL connection URL
DATABASE_URL="postgresql+asyncpg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"

# MinIO / S3 storage
USE_S3=False
MINIO_ROOT_USER=CHANGE_ME_TO_A_UNIQUE_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Use an HTTPS endpoint for S3/MinIO in production.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=kpi-evidence
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REDIS_URL=redis://localhost:6379/0
OAUTH_ENABLED=false
OAUTH_PUBLIC_BASE_URL=http://localhost:8000
OAUTH_STATE_TTL_SECONDS=600
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
MICROSOFT_OIDC_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
ENABLE_SCHEDULER=false
RUN_SCHEDULER=false
TIMEZONE=Asia/Yangon

# Optional SMTP mail delivery (Gmail app-password compatible; never commit secrets)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Enterprise KPI Platform"
MAIL_USE_TLS=true

# Optional initial Super Admin bootstrap. Used only when no Super Admin exists.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Optional credentials for the explicit local/test seed command only.
# Do not configure these in a production runtime environment.
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-a-local-only-password
SEED_DEMO_PASSWORD=replace-with-a-local-only-password
SEED_L2_PASSWORD=replace-with-a-local-only-password
SEED_L0_PASSWORD=replace-with-a-local-only-password
SEED_L1_PASSWORD=replace-with-a-local-only-password
