# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="Enterprise KPI System"
VERSION="1.0.0"
ENV="development"
# Generate at least 32 random characters; this placeholder is rejected in production.
JWT_SECRET_KEY="CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# SA Authenticator (TOTP) secret encryption key — REQUIRED in production:
# without a valid key the app refuses to start in production (and without
# any key, MFA setup/verification 503s). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This placeholder is NOT a valid Fernet key, so a copied example fails fast.
# This key is NOT the JWT secret. Losing it means every SA must re-enroll
# via the peer-reset flow — back it up with the other production secrets.
TOTP_ENCRYPTION_KEY="CHANGE_ME_GENERATE_FERNET_KEY"
# Per-statement ceiling (seconds) and idempotency window (hours).
# Production: set explicitly, never rely on the code defaults.
DB_COMMAND_TIMEOUT_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24

# ==========================================
# Database Connections
# ==========================================
# Neon PostgreSQL connection URL
DATABASE_SSL_REQUIRED=true
DATABASE_URL="postgresql+asyncpg://USERNAME:PASSWORD@HOST/DATABASE"
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# Object Storage (SeaweedFS / Local S3)
# ==========================================
USE_S3=true
# Compose-only MinIO root credentials (local docker stack). On Railway
# production these are NOT the storage credentials — production storage
# uses S3_ACCESS_KEY / S3_SECRET_KEY below.
MINIO_ROOT_USER="CHANGE_ME"
MINIO_ROOT_PASSWORD="CHANGE_ME"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_BUCKET_NAME="kpi-evidence"

# ==========================================
# Application Behavior & Environment
# ==========================================
# CORS origins — REQUIRED, no code default: the app refuses to start
# without this. Development example below; production MUST list the
# real domain(s) (comma-separated), never localhost.
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
ENABLE_SCHEDULER="false"
RUN_SCHEDULER="false"
TIMEZONE="Asia/Yangon"
# Seed control — defaults to ON in code, so production MUST set this to
# true on every service, or the app will seed accounts on startup.
SKIP_DATABASE_SEED="false"
# Production seed guard — even with SKIP_DATABASE_SEED=false, the seed
# refuses to run when ENV=production unless this is exactly "true".
# Keep it unset (or anything but "true") in production; set it only for
# a deliberate, one-time production seed run.
ALLOW_PROD_SEED="false"
# QA database target (QA stack only; code defaults shown).
QA_DATABASE_HOST="postgres-qa"
QA_DATABASE_PORT=5432
QA_DATABASE_NAME="kpi_qa"
# Runtime (entrypoint / scheduler — not app Settings, but still required
# explicitly in production; values below are the script defaults).
HOST="0.0.0.0"
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL="info"
SKIP_DATABASE_MIGRATIONS="false"
ENABLE_BATCH_NOTIFICATIONS="false"

# ==========================================
# OAuth Settings (Disabled for now)
# ==========================================
OAUTH_ENABLED=false
APP_BASE_URL="http://127.0.0.1:8000"
OAUTH_STATE_TTL_SECONDS=600
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
MICROSOFT_OIDC_ENABLED=false
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="http://localhost:8000/api/v1/auth/microsoft/callback"

# ==========================================
# Resend API email delivery. Keep the key in the runtime environment only.
# ==========================================
RESEND_API_KEY=""
SMTP_PASSWORD=""

# ==========================================
# Bootstrap & Seed Accounts (Local/Test)
# ==========================================
# Super Admin creation uses BOOTSTRAP_* ONLY. Legacy SEED_SUPERADMIN_*
# values below are NOT read for Super Admin creation anymore (they
# remain only as documentation for the old seed path); setting them
# alone creates no Super Admin. Never set either set in production
# except for a deliberate first-time bootstrap, then remove them.
BOOTSTRAP_SUPERADMIN_EMAIL=""
BOOTSTRAP_SUPERADMIN_PASSWORD=""

SEED_SUPERADMIN_EMAIL="superadmin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_DEMO_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_L2_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_L0_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_L1_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"

# Legacy alias for SEED_SUPERADMIN_PASSWORD, still read by code for local
# setups — prefer SEED_SUPERADMIN_PASSWORD above; do not set both.
# SEED_SUPER_ADMIN_PASSWORD="CHANGE_ME"
SEED_TEST_ACCOUNTS_ENABLED=false
SEED_TEST_SUPERADMIN_EMAIL="phase25.superadmin@example.com"
SEED_TEST_SUPERADMIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_ADMIN_EMAIL="phase25.admin@example.com"
SEED_TEST_ADMIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_FIRST_LOGIN_EMAIL="phase25.first-login@example.com"
SEED_TEST_FIRST_LOGIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_L0_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_L1_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_L2_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
