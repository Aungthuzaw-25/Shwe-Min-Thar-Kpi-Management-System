PROJECT_NAME="Enterprise KPI System"
VERSION="1.0.0"
ENV=production
SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Neon PostgreSQL connection URL
DATABASE_URL="postgresql+asyncpg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require"

# MinIO / S3 storage
USE_S3=False
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=kpi-evidence
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REDIS_URL=redis://localhost:6379/0
ENABLE_SCHEDULER=false
RUN_SCHEDULER=false
TIMEZONE=Asia/Yangon

# Seed bootstrap credentials for local/test database setup
SEED_SUPER_ADMIN_PASSWORD=SuperSecret123!
SEED_DEMO_PASSWORD=user@12345AmZm
SEED_L2_PASSWORD=user@12345AmZm
SEED_L0_PASSWORD=user@12345AmZm
SEED_L1_PASSWORD=Secret123!
