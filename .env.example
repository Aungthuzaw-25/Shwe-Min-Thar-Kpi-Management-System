# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="Enterprise KPI System"
VERSION="1.0.0"
ENV="development"
# Generate at least 32 random characters; this placeholder is rejected in production.
SECRET_KEY="CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Database Connections
# ==========================================
# Neon PostgreSQL connection URL
DATABASE_SSL_REQUIRED=true
DATABASE_URL="postgresql+asyncpg://USERNAME:PASSWORD@HOST/DATABASE"
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# Object Storage (SeaweedFS / Local S3)
# ==========================================
USE_S3=true
MINIO_ROOT_USER="CHANGE_ME"
MINIO_ROOT_PASSWORD="CHANGE_ME"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"
S3_BUCKET_NAME="kpi-evidence"

# ==========================================
# Application Behavior & Environment
# ==========================================
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
ENABLE_SCHEDULER="false"
RUN_SCHEDULER="false"
TIMEZONE="Asia/Yangon"

# ==========================================
# OAuth Settings (Disabled for now)
# ==========================================
OAUTH_ENABLED=false
OAUTH_PUBLIC_BASE_URL="http://localhost:8000"
OAUTH_STATE_TTL_SECONDS=600
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
MICROSOFT_OIDC_ENABLED=false
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="organizations"
MICROSOFT_REDIRECT_URI="http://localhost:8000/api/v1/auth/microsoft/callback"

# ==========================================
# Resend API email delivery. Keep the key in the runtime environment only.
# ==========================================
RESEND_API_KEY=""

# ==========================================
# Bootstrap & Seed Accounts (Local/Test)
# ==========================================
BOOTSTRAP_SUPERADMIN_EMAIL=""
BOOTSTRAP_SUPERADMIN_PASSWORD=""

SEED_SUPERADMIN_EMAIL="superadmin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_DEMO_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_L2_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_L0_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_L1_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"

SEED_TEST_ACCOUNTS_ENABLED=false
SEED_TEST_SUPERADMIN_EMAIL="phase25.superadmin@example.com"
SEED_TEST_SUPERADMIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_ADMIN_EMAIL="phase25.admin@example.com"
SEED_TEST_ADMIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_FIRST_LOGIN_EMAIL="phase25.first-login@example.com"
SEED_TEST_FIRST_LOGIN_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_L0_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_L1_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
SEED_TEST_L2_PASSWORD="CHANGE_ME_LOCAL_TEST_PASSWORD"
