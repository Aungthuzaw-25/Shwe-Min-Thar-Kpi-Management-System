PROJECT_NAME="Enterprise KPI System"
VERSION="1.0.0"
SECRET_KEY="generate-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL (Neon DB သို့မဟုတ် PostgreSQL URL နမူနာ)
DATABASE_URL="postgresql+asyncpg://your_db_user:your_db_password@your_db_host/your_db_name?sslmode=require"

# MinIO / S3 Storage (နောက်ပိုင်းသုံးရန် နမူနာ)
USE_S3=False
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=kpi-evidence
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REDIS_URL=redis://localhost:6379/0
ENABLE_SCHEDULER=false
TIMEZONE=Asia/Yangon